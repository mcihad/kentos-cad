l","Çizgiler"],"order":2,"description":"Yol, raylı sistem, sınır, su, altyapı hattı ve topoğrafya çizgileri"},{"path":["Genel","Çizgiler","Yollar"],"order":1,"description":"Kademesine göre kenarlı yollar, toprak yollar, patika ve bisiklet yolu"},{"path":["Genel","Çizgiler","Raylı sistem"],"order":2,"description":"Demiryolu, tramvay, metro ve teleferik"},{"path":["Genel","Çizgiler","Sınırlar"],"order":3,"description":"İdari, mülkiyet, plan ve koruma sınırları"},{"path":["Genel","Çizgiler","Su"],"order":4,"description":"Akarsu, kanal ve kıyı çizgileri"},{"path":["Genel","Çizgiler","Altyapı hatları"],"order":5,"description":"Enerji, doğal gaz, su, atık su ve haberleşme hatları; kendi renklerinde"},{"path":["Genel","Çizgiler","Topoğrafya ve yapı"],"order":6,"description":"Eş yükselti eğrileri, şev, duvar ve çitler"},{"path":["Genel","Çizgiler","Oklar ve genel"],"order":7,"description":"Yön okları, akış, dalgalı ve kırık çizgiler"},{"path":["Genel","Alanlar"],"order":3,"description":"Arazi örtüsü, su, yapılaşma, kentsel kullanım, tarama desenleri ve kısıt alanları"},{"path":["Genel","Alanlar","Arazi örtüsü"],"order":1,"description":"Orman, çayır, tarım, bağ bahçe, kumluk ve kayalık"},{"path":["Genel","Alanlar","Su ve sulak alan"],"order":2,"description":"Göl, deniz, sulak alan ve havuz"},{"path":["Genel","Alanlar","Yapılaşma"],"order":3,"description":"Bina, kamu binası, yıkıntı, inşaat ve sera"},{"path":["Genel","Alanlar","Kentsel kullanım"],"order":4,"description":"Konut, ticaret, sanayi, yeşil alan ve donatı alanları"},{"path":["Genel","Alanlar","Tarama desenleri"],"order":5,"description":"Mürekkeple düz, çapraz, kesikli ve noktalı taramalar"},{"path":["Genel","Alanlar","Kısıt ve tehlike"],"order":6,"description":"Taşkın, heyelan, afet riski, koruma, yasak ve tampon alanları"},{"path":["Kent"],"order":4,"description":"Kentin ağaçları, bitkileri, park ve sokak donatıları, trafik işaretleri, yol çizgileri, kaplamalar ve altyapı ayrıntıları; MPYY gösterimlerinden ayrı"},{"path":["Kent","Ağaçlar"],"order":1,"description":"Plan görünüşünde gerçek boyunda; taç çapı nesnenin Taç alanından (metre), yoksa varsayılan"},{"path":["Kent","Çalı ve bitkiler"],"order":2,"description":"Çalılar, çitler, çiçek tarhları, çim ve yer örtücüler; çalılar gerçek boyunda"},{"path":["Kent","Park ve bahçe donatıları"],"order":3,"description":"Fıskiye, çeşme, pergola, çardak, heykel ve park zeminleri"},{"path":["Kent","Oyun ve spor elemanları"],"order":4,"description":"Çocuk oyun elemanları, açık hava spor aletleri ve zeminleri"},{"path":["Kent","Kent mobilyaları"],"order":5,"description":"Oturma, aydınlatma, atık, durak, büfe, yönlendirme ve erişim donatıları"},{"path":["Kent","Trafik işaretleri ve ışıkları"],"order":6,"description":"Uyarı, tanzim ve bilgi işaretleri, trafik ve yaya ışıkları"},{"path":["Kent","Yol çizgileri ve kenarları"],"order":7,"description":"Şerit, durma ve yaya geçidi çizgileri, bordür, özel şeritler ve yol okları; gerçek boyunda"},{"path":["Kent","Yol ve zemin kaplamaları"],"order":8,"description":"Asfalt, beton, parke, küp taş, kaldırım, refüj, park cebi ve çim taşı"},{"path":["Kent","Altyapı ayrıntıları"],"order":9,"description":"Bacalar, vanalar, sayaçlar, panolar, sulama ve drenaj; altyapı renklerinde"},{"path":["Genel","Piktogramlar"],"order":9,"description":"Genel ve Kent sembollerinin piktogramları (SVG)"}]}
