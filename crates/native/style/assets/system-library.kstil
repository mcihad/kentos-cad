pe","shape":"circle","size":3,"fill":"#FFFF00","stroke":"ink","strokeWidth":0.3,"id":"0"},{"type":"shape","shape":"circle","size":1,"fill":"ink","stroke":null,"id":"1"},{"type":"text","text":{"expr":"varsayılan([Ad], '')"},"size":2.5,"font":"sans","weight":700,"color":"ink","offset":[2.5,0],"anchor":"left","id":"2"}]},"description":"EK-1e s.36: 0,3 mm, 3 mm çaplı daire içinde 1 mm çaplı içi dolu daire. Aradaki sarı yalnız çizimde (255/255/0 okundu), metinde renk yok. Ad, \"Ad\" özniteliğinden sembolün sağına yazılır (yazı boyu yazılı değil, 2,5 mm).","reference":"EK-1c s.1 (AÇIKLAMA 1); EK-1e s.36"},{"kind":"symbol","id":"mpyy.cdp.idari-merkez.koy-merkezi","name":"Köy merkezi","path":["MPYY","Çevre düzeni planı","İdari merkezler"],"symbol":{"type":"marker","layers":[{"type":"shape","shape":"circle","size":3,"fill":"#FFFF00","stroke":"ink","strokeWidth":0.3,"id":"0"},{"type":"shape","shape":"circle","size":1,"fill":"ink","stroke":null,"id":"1"},{"type":"text","text":{"expr":"varsayılan([Ad], '')"},"size":2.5,"font":"sans","weight":700,"color":"ink","offset":[2.5,0],"anchor":"left","id":"2"}]},"description":"EK-1e s.38: 0,3 mm, 3 mm çaplı daire içinde 1 mm çaplı içi dolu daire. Aradaki sarı yalnız çizimde (255/255/0 okundu), metinde renk yok. Ad, \"Ad\" özniteliğinden sembolün sağına yazılır (yazı boyu yazılı değil, 2,5 mm). Belde merkezi ile aynı ölçüde; ikisi adlarıyla ayrılır.","reference":"EK-1c s.1 (AÇIKLAMA 1); EK-1e s.38"},{"kind":"symbol","id":"mpyy.cdp.sinirlar.planlama-alt-bolgesi","name":"Planlama alt bölgesi","path":["MPYY","Çevre düzeni planı","Sınırlar"],"symbol":{"type":"line","layers":[{"type":"simpleLine","color":"#FF0000","width":0.3,"dash":[1,3],"id":"0"},{"type":"markerLine","marker":{"type":"marker","layers":[{"type":"shape","shape":"circle","size":3,"fill":"#FF0000","stroke":null,"id":"0"}]},"placement":"interval","interval":4,"offsetAlong":2.5,"rotate":true,"id":"1"}]},"description":"0,3 mm; 3 mm çaplı dolu daireler, aralarında 1 mm düz çizgi (b