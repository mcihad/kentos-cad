    <specification name="EK-6 Tablo 6.1 IfcAirTerminal (Havalandırma Menfezi)" ifcVersion="IFC4X3_ADD2" identifier="T6.1" description="IfcAirTerminal Sınıfı Zorunlu Öznitelik ve Özellik Listesi" instructions="Dijital Proje Yön. EK-6 Tablo 6.1 · PDF s. 36">
