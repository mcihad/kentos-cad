          "description": "The rows a button's command answered, a card each: `title`'s column heads it (none: the first column), `tag`'s\nbeside it, the other columns under it by name; a card with a `uid` is an object. Where a table's columns do not\nfit (a narrow dock), a card writes them one under the other.",
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "tag": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "card",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
