        "y": 4420200.0
      },
      "height": 2.0,
      "rotation": 0.0,
      "width": 10.0,
      "to": "middleCenter",
      "expect": {
        "x": 487105.0,
        "y": 4420201.0
      }
    },
    {
      "name": "ortadan sol tabana: eskiye döner",
