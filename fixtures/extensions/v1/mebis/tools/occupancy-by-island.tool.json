{
  "format": "kentos.processingTool",
  "schemaVersion": 1,
  "id": "occupancy-by-island",
  "version": "1.0.0",
  "label": "Ada bazlı doluluk",
  "category": "Mezarlık BS",
  "description": "Her mezarlık adasındaki mezar yerlerini sayar: kaç yer var, kaçı dolu.",
  "keywords": [
    "mezarlık",
    "ada",
    "doluluk",
    "mezar yeri"
  ],
  "parameters": [
    {
      "name": "islands",
      "label": "Mezarlık adaları",
      "type": "features",
      "kinds": [
        "polygon"
      ],
      "scopes": [
        "layer",
        "selection",
        "visible",
        "all"
      ],
      "default": {
        "scope": "layer",
        "layerId": "mezar_ada"
      },
      "description": "Doluluğu sayılacak adalar."
    },
    {
      "name": "graves",
      "label": "Mezar yerleri",
      "type": "features",
      "kinds": [
        "polygon"
      ],
      "scopes": [
        "layer",
        "selection",
        "visible",
        "all"
      ],
      "default": {
        "scope": "layer",
        "layerId": "mezar_yeri"
      },
      "description": "Ada numarası (ada_no) ve durumu (durum) yazılı mezar yerleri."
    }
  ],
  "outputs": [
    {
      "name": "report",
      "label": "Ada bazlı doluluk tablosu",
      "type": "table"
    }
  ],
  "feedback": {
    "progress": true,
    "cancel": true
  },
  "capabilities": {
    "runtimes": [
      "desktop-python"
    ]
  }
}
