{
  "format": "kentos.point-input-cases",
  "version": 1,
  "note": "Yazılan nokta ve sayı girişinin dilbilgisi (TODOS.md UX-04, UX-05; docs/adr/0018, 0021). Web'in okuyucusu apps/web/src/tools/coordinateInput.ts (coordinateInput.test.ts), masaüstününki crates/shared/geometry-core/src/tools/point_text.rs (tests/point_text.rs); ikisi de bu dosyayı okur. fn: point (parsePointInput: metin, son nokta, imleç; nesne izleme yok), number (parseNumber), looksLikeCoordinate. Noktalar tam eşit karşılaştırılır; tolerance verilmişse o kadar. null: nokta ya da sayı yok. Bugünkü dilbilgisidir; değişikliği UX-05'in kararıyla iki okuyucuda ve burada birlikte yapın.",
  "cases": [
    { "name": "mutlak Y,X, TM", "fn": "point", "text": "486512.34,4420118.9", "last": null, "cursor": null, "expect": { "x": 486512.34, "y": 4420118.9 } },
    { "name": "mutlak, noktalı virgül", "fn": "point", "text": "10;20", "last": null, "cursor": null, "expect": { "x": 10, "y": 20 } },
    { "name": "mutlak, boşluk ayırıcı", "fn": "point", "text": "10 20", "last": null, "cursor": null, "expect": { "x": 10, "y": 20 } },
    { "name": "mutlak, başta, sonda ve ayırıcı çevresinde boşluk", "fn": "point", "text": "  10 , 20  ", "last": null, "cursor": null, "expect": { "x": 10, "y": 20 } },
    { "name": "bölünmez boşluk da boşluktur", "fn": "point", "text": "10 , 20", "last": null, "cursor": null, "expect": { "x": 10, "y": 20 } },
    { "name": "BOM ve ideografik boşluk kırpılır", "fn": "point", "text": "﻿10,20　", "last": null, "cursor": null, "expect": { "x": 10, "y": 20 } },
    { "name": "U+0085 JavaScript'te boşluk değildir", "fn": "point", "text": "10,20\u0085", "last": null, "cursor": null, "expect": null },
    { "name": "sekme boşluktur ama ayırıcı değildir", "fn": "point", "text": "10\t20", "last": null, "cursor": null, "expect": null },
    { "name": "sekme ve boşluk", "fn": "point", "text": "10\t 20", "last": null, "cursor": null, "expect": { "x": 10, "y": 20 } },
    { "name": "iki virgül", "fn": "point", "text": "10,,20", "last": null, "cursor": null, "expect": null },
    { "name": "virgül ve noktalı virgül", "fn": "point", "text": "10,;20", "last": null, "cursor": null, "expect": null },
    { "name": "işaretli sayılar", "fn": "point", "text": "+5,-3", "last": null, "cursor": null, "expect": { "x": 5, "y": -3 } },
    { "name": "noktayla başlayan sayı yok", "fn": "point", "text": ".5,2", "last": null, "cursor": null, "expect": null },
    { "name": "noktayla biten sayı yok", "fn": "point", "text": "5.,2", "last": null, "cursor": null, "expect": null },
    { "name": "üslü yazım yok", "fn": "point", "text": "1e3,2", "last": null, "cursor": null, "expect": null },
    { "name": "yalnız ASCII rakam", "fn": "point", "text": "１０,２０", "last": null, "cursor": null, "expect": null },
    { "name": "en yakın double'a yuvarlanır", "fn": "point", "text": "9007199254740993,0.1000000000000000055511151231257827", "last": null, "cursor": null, "expect": { "x": 9007199254740992, "y": 0.1 } },
    { "name": "etkileşim izinin mutlak noktası", "fn": "point", "text": "486975,4420005", "last": { "x": 487010, "y": 4419985 }, "cursor": { "x": 487025, "y": 4420015 }, "expect": { "x": 486975, "y": 4420005 } },

    { "name": "göreli @dY,dX", "fn": "point", "text": "@5,-3", "last": { "x": 100, "y": 200 }, "cursor": null, "expect": { "x": 105, "y": 197 } },
    { "name": "göreli, son nokta yok", "fn": "point", "text": "@5,-3", "last": null, "cursor": { "x": 1, "y": 1 }, "expect": null },
    { "name": "göreli, TM", "fn": "point", "text": "@12.5,-3.25", "last": { "x": 486512.34, "y": 4420118.9 }, "cursor": null, "expect": { "x": 486524.84, "y": 4420115.65 } },
    { "name": "göreli, boşluk ayırıcı", "fn": "point", "text": "@5 3", "last": { "x": 100, "y": 200 }, "cursor": null, "expect": { "x": 105, "y": 203 } },
    { "name": "@'ten sonra boşluk olmaz", "fn": "point", "text": "@ 5,3", "last": { "x": 100, "y": 200 }, "cursor": null, "expect": null },
    { "name": "etkileşim izinin göreli noktası", "fn": "point", "text": "@0,8", "last": { "x": 487012, "y": 4420000 }, "cursor": { "x": 487020, "y": 4420000 }, "expect": { "x": 487012, "y": 4420008 } },

    { "name": "kutupsal @mesafe<açı", "fn": "point", "text": "@10<90", "last": { "x": 100, "y": 200 }, "cursor": null, "expect": { "x": 100, "y": 210 }, "tolerance": 1e-9 },
    { "name": "kutupsal, @ yazılmadan", "fn": "point", "text": "10<90", "last": { "x": 100, "y": 200 }, "cursor": null, "expect": { "x": 100, "y": 210 }, "tolerance": 1e-9 },
    { "name": "kutupsal, < çevresinde boşluk", "fn": "point", "text": "@10 < 180", "last": { "x": 100, "y": 200 }, "cursor": null, "expect": { "x": 90, "y": 200 }, "tolerance": 1e-9 },
    { "name": "kutupsal, son nokta yok: başka biçim denenmez", "fn": "point", "text": "10<90", "last": null, "cursor": { "x": 1, "y": 1 }, "expect": null },
    { "name": "iki @", "fn": "point", "text": "@@10<90", "last": { "x": 100, "y": 200 }, "cursor": null, "expect": null },
    { "name": "iki <", "fn": "point", "text": "@10<<90", "last": { "x": 100, "y": 200 }, "cursor": null, "expect": null },

    { "name": "mesafe, imleç yönünde", "fn": "point", "text": "5", "last": { "x": 100, "y": 200 }, "cursor": { "x": 110, "y": 200 }, "expect": { "x": 105, "y": 200 } },
    { "name": "eksi mesafe imlecin tersine", "fn": "point", "text": "-4", "last": { "x": 487000, "y": 4420000 }, "cursor": { "x": 487020, "y": 4420000 }, "expect": { "x": 486996, "y": 4420000 } },
    { "name": "artılı mesafe", "fn": "point", "text": "+7", "last": { "x": 487000, "y": 4419985 }, "cursor": { "x": 487020, "y": 4419985 }, "expect": { "x": 487007, "y": 4419985 } },
    { "name": "etkileşim izinin 12'si", "fn": "point", "text": "12", "last": { "x": 487000, "y": 4420000 }, "cursor": { "x": 487020, "y": 4420000 }, "expect": { "x": 487012, "y": 4420000 } },
    { "name": "mesafe, imleç yok", "fn": "point", "text": "5", "last": { "x": 100, "y": 200 }, "cursor": null, "expect": null },
    { "name": "mesafe, imleç son noktada", "fn": "point", "text": "5", "last": { "x": 100, "y": 200 }, "cursor": { "x": 100, "y": 200 }, "expect": null },
    { "name": "mesafe, son nokta yok", "fn": "point", "text": "5", "last": null, "cursor": { "x": 110, "y": 200 }, "expect": null },
    { "name": "noktayla biten mesafe", "fn": "point", "text": "12.", "last": { "x": 100, "y": 200 }, "cursor": { "x": 110, "y": 200 }, "expect": null },
    { "name": "virgüllü tek sayı mesafe değildir", "fn": "point", "text": "2,5", "last": null, "cursor": null, "expect": { "x": 2, "y": 5 } },
    { "name": "harf", "fn": "point", "text": "abc", "last": { "x": 100, "y": 200 }, "cursor": { "x": 110, "y": 200 }, "expect": null },
    { "name": "boş", "fn": "point", "text": "   ", "last": { "x": 100, "y": 200 }, "cursor": { "x": 110, "y": 200 }, "expect": null },

    { "name": "ondalık virgül", "fn": "number", "text": "2,5", "expect": 2.5 },
    { "name": "ondalık nokta", "fn": "number", "text": "2.5", "expect": 2.5 },
    { "name": "eksi, boşluklu", "fn": "number", "text": "  -3 ", "expect": -3 },
    { "name": "artı", "fn": "number", "text": "+7", "expect": 7 },
    { "name": "baştaki sıfırlar", "fn": "number", "text": "0012.50", "expect": 12.5 },
    { "name": "yalnız ilk virgül noktaya döner", "fn": "number", "text": "1,2,3", "expect": null },
    { "name": "virgülle başlayan", "fn": "number", "text": ",5", "expect": null },
    { "name": "virgülle biten", "fn": "number", "text": "5,", "expect": null },
    { "name": "noktalı virgül ondalık değildir", "fn": "number", "text": "2;5", "expect": null },
    { "name": "BOM kırpılır", "fn": "number", "text": "﻿12", "expect": 12 },
    { "name": "U+0085 kırpılmaz", "fn": "number", "text": "12\u0085", "expect": null },
    { "name": "üs yok", "fn": "number", "text": "1e3", "expect": null },
    { "name": "Arap rakamı yok", "fn": "number", "text": "٣", "expect": null },
    { "name": "harf", "fn": "number", "text": "x", "expect": null },
    { "name": "boş", "fn": "number", "text": "", "expect": null },

    { "name": "@", "fn": "looksLikeCoordinate", "text": "@1", "expect": true },
    { "name": "rakam", "fn": "looksLikeCoordinate", "text": "12", "expect": true },
    { "name": "nokta", "fn": "looksLikeCoordinate", "text": ".5", "expect": true },
    { "name": "artı", "fn": "looksLikeCoordinate", "text": "+", "expect": true },
    { "name": "eksi ve harf", "fn": "looksLikeCoordinate", "text": "-x", "expect": true },
    { "name": "baştaki boşluk kırpılır", "fn": "looksLikeCoordinate", "text": " 5", "expect": true },
    { "name": "baştaki bölünmez boşluk kırpılır", "fn": "looksLikeCoordinate", "text": " @", "expect": true },
    { "name": "harfle başlayan", "fn": "looksLikeCoordinate", "text": "a1", "expect": false },
    { "name": "seçenek harfi", "fn": "looksLikeCoordinate", "text": "G", "expect": false },
    { "name": "boş", "fn": "looksLikeCoordinate", "text": "   ", "expect": false },
    { "name": "Arap rakamı", "fn": "looksLikeCoordinate", "text": "٣", "expect": false },
    { "name": "U+0085 kırpılmaz", "fn": "looksLikeCoordinate", "text": "\u0085 5", "expect": false }
  ]
}
