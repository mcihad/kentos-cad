{
 "format": "kentos.processing-cases",
 "version": 1,
 "tolerance": 1e-09,
 "rasters": {
  "mavi.tif": "remote/mavi.tif",
  "yesil.tif": "remote/yesil.tif",
  "kirmizi.tif": "remote/kirmizi.tif",
  "yko.tif": "remote/yko.tif",
  "goruntu.tif": "remote/goruntu.tif",
  "sonraki.tif": "remote/sonraki.tif",
  "once-sinif.tif": "remote/once-sinif.tif",
  "sonra-sinif.tif": "remote/sonra-sinif.tif",
  "siniflar.tif": "remote/siniflar.tif",
  "sifirli.tif": "remote/sifirli.tif",
  "cok-bantli.tif": "remote/cok-bantli.tif",
  "pankromatik.tif": "remote/pankromatik.tif"
 },
 "documents": {
  "remote.kcad": {
   "defaults": {
    "lengthDecimals": 3,
    "areaDecimals": 2,
    "angleUnit": "grad",
    "plotScale": 1000,
    "drawingFont": "barlow",
    "activeLayer": "egitim",
    "measureHeightMm": 2
   },
   "tools": {
    "remote.composite": {
     "input": {
      "scope": "visible"
     },
     "sampling": "nearest",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Bant birleştir"
     }
    },
    "remote.split": {
     "input": {
      "scope": "selection"
     },
     "output": "",
     "add": true,
     "layer": {
      "newName": "Bantlar"
     }
    },
    "remote.index": {
     "input": {
      "scope": "selection"
     },
     "index": "ndvi",
     "blue": 1,
     "green": 2,
     "red": 3,
     "nir": 4,
     "swir": 5,
     "a": 4,
     "b": 3,
     "saviL": 0.5,
     "eviG": 2.5,
     "eviC1": 6,
     "eviC2": 7.5,
     "eviL": 1,
     "scale": 1,
     "offset": 0,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Spektral indis"
     }
    },
    "remote.supervised": {
     "input": {
      "scope": "selection"
     },
     "training": {
      "scope": "layer",
      "layerId": "egitim"
     },
     "classField": "",
     "method": "likelihood",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Denetimli sınıflandırma"
     }
    },
    "remote.unsupervised": {
     "input": {
      "scope": "selection"
     },
     "clusters": 8,
     "iterations": 20,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Denetimsiz sınıflandırma"
     }
    },
    "remote.accuracy": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "reference": {
      "scope": "layer",
      "layerId": "egitim"
     },
     "referenceField": ""
    },
    "remote.change": {
     "input": {
      "scope": "selection"
     },
     "after": {
      "scope": "selection"
     },
     "band": 1,
     "method": "difference",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Değişim"
     }
    },
    "remote.pansharpen": {
     "input": {
      "scope": "selection"
     },
     "pan": {
      "scope": "selection"
     },
     "method": "brovey",
     "weights": "",
     "sampling": "cubic",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Görüntü birleştirme"
     }
    }
   }
  }
 },
