{
 "format": "kentos.processing-cases",
 "version": 1,
 "tolerance": 1e-09,
 "rasters": {
  "egim.tif": "suitability/egim.tif",
  "yol.tif": "suitability/yol.tif",
  "toprak.tif": "suitability/toprak.tif",
  "sinif.tif": "suitability/sinif.tif",
  "egim-sinifi.tif": "suitability/egim-sinifi.tif",
  "ortu.tif": "suitability/ortu.tif",
  "deger.tif": "suitability/deger.tif",
  "uyelik-a.tif": "suitability/uyelik-a.tif",
  "uyelik-b.tif": "suitability/uyelik-b.tif",
  "uyelik-c.tif": "suitability/uyelik-c.tif",
  "duyarlilik.tif": "suitability/duyarlilik.tif"
 },
 "documents": {
  "suitability.kcad": {
   "defaults": {
    "lengthDecimals": 3,
    "areaDecimals": 2,
    "angleUnit": "grad",
    "plotScale": 1000,
    "drawingFont": "barlow",
    "activeLayer": "heyelan",
    "measureHeightMm": 2
   },
   "tools": {
    "suitability.fuzzyMembership": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "function": "linear",
     "low": 0,
     "high": 100,
     "exponent": 2,
     "midpoint": 1,
     "spread": 0.1,
     "steep": 5,
     "sample": "f32",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Üyelik"
     }
    },
    "suitability.fuzzyOverlay": {
     "input": {
      "scope": "visible"
     },
     "band": 1,
     "op": "and",
     "gamma": 0.9,
     "sample": "f32",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Bulanık çakıştırma"
     }
    },
    "suitability.weightedSum": {
     "input": {
      "scope": "visible"
     },
     "band": 1,
     "weights": {},
     "sample": "f32",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Ağırlıklı toplam"
     }
    },
    "suitability.weightedOverlay": {
     "input": {
      "scope": "visible"
     },
     "band": 1,
     "low": 1,
     "high": 9,
     "influence": {},
     "classes": {},
     "bounds": "upperClosed",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Ağırlıklı çakıştırma"
     }
    },
    "suitability.pairwise": {
     "input": {
      "scope": "visible"
     },
     "comparisons": [],
     "write": true,
     "band": 1,
     "sample": "f32",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Ağırlıklı toplam (AHP)"
     }
    },
    "suitability.roc": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "presence": {
      "scope": "layer",
      "layerId": "heyelan"
     },
     "background": "cells",
     "absence": {
      "scope": "layer",
      "layerId": "heyelan"
     },
     "higher": true
    }
   }
  }
 },
