{
  "format": "kentos.processing-cases",
  "version": 1,
  "tolerance": 1e-09,
  "documents": {
    "parcels.kcad": {
      "defaults": {"lengthDecimals": 3, "areaDecimals": 2, "angleUnit": "grad", "plotScale": 1000, "drawingFont": "barlow", "activeLayer": "cizim"},
      "tools": {
        "points.numberVertices": {
          "input": {"scope": "selection"},
          "direction": "cw",
          "start": "northwest",
          "startPoint": null,
          "prefix": "P",
          "length": 6,
          "pad": "0",
          "first": 1,
          "step": 1,
          "shared": true,
          "tolerance": 0.001,
          "output": "points",
          "textHeight": 2,
          "layer": {"newName": "Köşe noktaları"}
        },
        "annotation.edgeLengths": {
          "input": {"scope": "selection"},
          "decimals": 3,
          "side": "outside",
          "textHeight": 2,
          "prefix": "",
          "suffix": "",
          "minLength": 0,
          "shared": true,
          "layer": {"newName": "Kenar ölçüleri"}
        },
        "attributes.calculate": {"input": {"scope": "selection"}, "field": "Hesap alanı", "value": "metin($alan, 2)", "where": "", "empty": "keep", "label": true},
        "selection.byExpression": {"input": {"scope": "all"}, "condition": "$alan > 500", "mode": "new"},
        "builtin.parcelSheet": {"parcels": {"scope": "selection"}, "prefix": "P"}
      }
    }
  },
  "cases": [
    {
      "id": "number-vertices",
      "title": "Köşe noktalarını numarala, varsayılanlarla: iki komşu parsel, saat yönünde kuzeybatıdan; ortak köşeler tek numara, yeni katman",
      "document": "parcels.kcad",
      "selection": [1, 2],
      "run": {"tool": "points.numberVertices"},
      "values": {},
      "expect": {
        "status": "ok",
        "summary": "2 nesnede 6 köşe numaralandı: P00001 – P00006; 2 ortak köşe komşularıyla tek numara aldı.",
        "undo": "Köşe noktalarını numarala",
        "layers": [
          {
            "id": "islem-kose-noktalari",
            "name": "Köşe noktaları",
            "style": {
              "color": "#E5C07B",
              "lineType": "continuous",
              "lineWeight": 0.18,
              "point": {"symbol": "cross", "size": 7},
              "label": {"placement": "beside", "size": 10.5}
            }
          }
        ],
        "added": [
          {
            "kind": "point",
            "layerId": "islem-kose-noktalari",
