{
 "format": "kentos.processing-cases",
 "version": 1,
 "tolerance": 1e-09,
 "rasters": {
  "kaynak-raster.tif": "distance/kaynak-raster.tif",
  "izgara.tif": "distance/izgara.tif",
  "maliyet.tif": "distance/maliyet.tif",
  "engel.tif": "distance/engel.tif",
  "yukseklik.tif": "distance/yukseklik.tif",
  "sifir.tif": "distance/sifir.tif"
 },
 "documents": {
  "distance.kcad": {
   "defaults": {
    "lengthDecimals": 3,
    "areaDecimals": 2,
    "angleUnit": "grad",
    "plotScale": 1000,
    "drawingFont": "barlow",
    "activeLayer": "kaynaklar",
    "measureHeightMm": 2
   },
   "tools": {
    "distance.euclidean": {
     "from": "objects",
     "sources": {
      "scope": "layer",
      "layerId": "kaynaklar"
     },
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "max": 0,
     "result": "distance",
     "margin": 100,
     "cellSize": 0,
     "extent": "objects",
     "grid": {
      "scope": "selection"
     },
     "output": "",
     "add": true,
     "layer": {
      "newName": "Uzaklık"
     }
    },
    "distance.cost": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "sources": {
      "scope": "layer",
      "layerId": "kaynaklar"
     },
     "neighbours": "16",
     "useSurface": false,
     "surface": {
      "scope": "selection"
     },
     "surfaceLength": false,
     "slope": 0,
     "max": 0,
     "result": "cost",
     "sample": "f32",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Birikimli maliyet"
     }
    },
    "distance.path": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "sources": {
      "scope": "layer",
      "layerId": "kaynaklar"
     },
     "targets": {
      "scope": "layer",
      "layerId": "kaynaklar"
     },
     "neighbours": "16",
     "useSurface": false,
     "surface": {
      "scope": "selection"
     },
     "surfaceLength": false,
     "slope": 0,
     "simplify": 0,
     "layer": {
      "newName": "En düşük maliyetli yol"
     }
    },
    "distance.corridor": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "sources": {
      "scope": "layer",
      "layerId": "kaynaklar"
     },
     "targets": {
      "scope": "layer",
      "layerId": "kaynaklar"
     },
     "neighbours": "16",
     "useSurface": false,
     "surface": {
      "scope": "selection"
     },
     "surfaceLength": false,
     "slope": 0,
     "threshold": "none",
     "percent": 10,
     "value": 0,
     "sample": "f32",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Maliyet koridoru"
     }
    }
   }
  }
 },
