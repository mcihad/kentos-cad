{
 "format": "kentos.processing-cases",
 "version": 1,
 "tolerance": 1e-09,
 "documents": {
  "surface.kcad": {
   "defaults": {
    "lengthDecimals": 3,
    "areaDecimals": 2,
    "angleUnit": "grad",
    "plotScale": 1000,
    "drawingFont": "barlow",
    "activeLayer": "dem",
    "measureHeightMm": 2
   },
   "tools": {
    "surface.slope": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "method": "horn",
     "unit": "degrees",
     "zFactor": 1,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Eğim"
     }
    },
    "surface.aspect": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "method": "horn",
     "zFactor": 1,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Bakı"
     }
    },
    "surface.hillshade": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "azimuth": 315,
     "altitude": 45,
     "zFactor": 1,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Gölgeli kabartma"
     }
    },
    "surface.colorRelief": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "colors": "ramp",
     "ramp": "Arazi",
     "invert": false,
     "range": "auto",
     "min": 0,
     "max": 1000,
     "table": "",
     "interp": "linear",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Renkli kabartma"
     }
    },
    "surface.curvature": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "curvature": "total",
     "zFactor": 1,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Eğrilik"
     }
    },
    "surface.ruggedness": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "index": "triRiley",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Pürüzlülük"
     }
    },
    "surface.insolation": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "period": "year",
     "startDay": 21,
     "startMonth": "6",
     "endDay": 21,
     "endMonth": "9",
     "dayStep": 14,
     "hourStep": "0.5",
     "transmissivity": 0.5,
     "latitude": null,
     "zFactor": 1,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Güneşlenme"
     }
    },
    "surface.contours": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "interval": 5,
     "base": 0,
     "indexEvery": 5,
     "simplify": 0,
     "layer": {
      "newName": "Eş yükselti eğrileri"
     }
    }
   }
  }
 },
 "rasters": {
  "tepe.tif": "../../terrain/v1/tepe.tif",
  "donuk.tif": "../../terrain/v1/donuk.tif"
 },
 "cases": [
  {
   "id": "slope",
   "title": "Eğim, varsayılanlar: derece, Horn; kaynağın yanına tepe-egim.tif, Spektral'le",
   "document": "surface.kcad",
   "selection": [
    1
   ],
   "run": {
    "tool": "surface.slope"
   },
   "values": {},
   "expect": {
    "status": "ok",
    "summary": "41 × 33 hücrelik raster; “tepe-egim.tif” yazıldı.",
    "undo": "Eğim",
    "layers": [
     {
      "id": "islem-egim",
      "name": "Eğim",
      "style": {
       "color": "#7A6B5B",
       "lineType": "continuous",
       "lineWeight": 0.25
      }
     }
    ],
    "added": [
     {
      "kind": "raster",
      "layerId": "islem-egim",
      "attrs": {},
      "affine": [
       500100.0,
       10.0,
       0.0,
       4420330.0,
       0.0,
       -10.0
      ],
      "width": 41,
      "height": 33,
      "bands": 1,
      "sample": "f32",
      "file": "tepe-egim.tif",
      "srid": 5254,
      "style": {
       "render": "ramp",
       "bands": [
        1
       ],
       "stretch": "minMax",
       "ramp": "Spektral"
      }
     }
    ],
    "outputs": {
     "file": "tepe-egim.tif"
    },
    "rasterOf": {
     "tepe-egim.tif": "Eğim (derece, Horn)"
    },
    "layerAbove": {
     "islem-egim": "dem"
    }
   }
  },
