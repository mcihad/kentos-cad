{
 "format": "kentos.processing-cases",
 "version": 1,
 "tolerance": 1e-09,
 "rasters": {
  "siniflar.tif": "raster-vector/siniflar.tif",
  "cizgiler.tif": "raster-vector/cizgiler.tif",
  "yukseklik.tif": "raster-vector/yukseklik.tif",
  "tarama.tif": "raster-vector/tarama.tif",
  "pafta.tif": "raster-vector/pafta.tif",
  "pafta2.tif": "raster-vector/pafta2.tif"
 },
 "documents": {
  "raster-vector.kcad": {
   "defaults": {
    "lengthDecimals": 3,
    "areaDecimals": 2,
    "angleUnit": "grad",
    "plotScale": 1000,
    "drawingFont": "barlow",
    "activeLayer": "siniflar",
    "measureHeightMm": 2
   },
   "tools": {
    "raster.rasterize": {
     "input": {
      "scope": "layer",
      "layerId": "siniflar"
     },
     "valueFrom": "constant",
     "value": 1,
     "field": "",
     "overlap": "last",
     "sample": "f32",
     "cellSize": 0,
     "extent": "points",
     "grid": {
      "scope": "selection"
     },
     "output": "",
     "add": true,
     "layer": {
      "newName": "Rasterleştirilmiş"
     }
    },
    "raster.toPolygons": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "connect": "four",
     "layer": {
      "newName": "Bölgeler"
     }
    },
    "raster.toLines": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "select": "nonZero",
     "min": 1,
     "max": 1,
     "color": "#000000",
     "tolerance": 60,
     "spur": 0,
     "simplify": 1,
     "layer": {
      "newName": "Çizgiler"
     }
    },
    "raster.toPoints": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "mode": "step",
     "step": 10,
     "radius": 1,
     "elevation": true,
     "layer": {
      "newName": "Noktalar"
     }
    },
    "scan.captureLine": {
     "input": {
      "scope": "selection"
     },
     "at": null,
     "tolerance": 60,
     "spur": 5,
     "simplify": 1,
     "z": null,
     "layer": {
      "newName": "Yakalanan çizgiler"
     }
    },
    "scan.closeArea": {
     "input": {
      "scope": "selection"
     },
     "at": null,
     "tolerance": 60,
     "holes": "fill",
     "simplify": 1,
     "layer": {
      "newName": "Kapatılan alanlar"
     }
    },
    "scan.contourElevations": {
     "curves": {
      "scope": "selection"
     },
     "start": null,
     "end": null,
     "first": 0,
     "step": 5
    }
   }
  }
 },
 "cases": [
  {
   "id": "rasterize",
   "title": "Rasterleştir, Alandan, Son çizilen, 0,5 m: parseller (biri delikli), daire, yol, eğri yollar, yay ve çok noktalı kuyu; değeri okunmayan nesne söylenir",
   "document": "raster-vector.kcad",
   "selection": [],
   "run": {
    "tool": "raster.rasterize"
   },
   "values": {
    "input": {
     "scope": "layer",
     "layerId": "nesneler"
    },
    "valueFrom": "field",
    "field": "Değer",
    "overlap": "last",
    "cellSize": 0.5
   },
   "expect": {
    "status": "ok",
    "undo": "Rasterleştir",
    "summary": "6 nesneden 38 × 22 hücrelik raster; “Nesneler-raster.tif” yazıldı. Değersiz 359 hücre.",
    "log": [
     {
      "level": "warn",
      "text": "1 nesnenin değeri sayı olarak okunamadığı için alınmadı."
     }
    ],
    "outputs": {
     "file": "Nesneler-raster.tif"
    },
    "layers": [
     {
      "id": "islem-rasterlestirilmis",
      "name": "Rasterleştirilmiş",
      "style": {
       "color": "#7A6B5B",
       "lineType": "continuous",
       "lineWeight": 0.25
      }
     }
    ],
    "added": [
     {
      "kind": "raster",
      "layerId": "islem-rasterlestirilmis",
      "attrs": {},
      "affine": [
       500.0,
       0.5,
       0.0,
       311.0,
       0.0,
       -0.5
      ],
      "width": 38,
      "height": 22,
      "bands": 1,
      "sample": "f32",
      "file": "Nesneler-raster.tif",
      "srid": 5254,
      "style": {
       "render": "ramp",
       "bands": [
        1
       ],
       "stretch": "minMax",
       "ramp": "Viridis",
       "resampling": "nearest"
      }
     }
    ],
    "layerBelow": {
     "islem-rasterlestirilmis": "nesneler"
    },
    "rasterVectorOf": {
     "Nesneler-raster.tif": "rasterlestir-last"
    }
   }
  },
