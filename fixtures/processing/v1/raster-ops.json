{
 "format": "kentos.processing-cases",
 "version": 1,
 "tolerance": 1e-09,
 "rasters": {
  "kot.tif": "raster-ops/kot.tif",
  "fark.tif": "raster-ops/fark.tif",
  "egim.tif": "raster-ops/egim.tif",
  "buyuk.tif": "raster-ops/buyuk.tif",
  "pafta1.tif": "raster-ops/pafta1.tif",
  "pafta2.tif": "raster-ops/pafta2.tif",
  "pafta3.tif": "raster-ops/pafta3.tif",
  "dem.tif": "raster-ops/dem.tif",
  "bolge.tif": "raster-ops/bolge.tif",
  "arazi.tif": "raster-ops/arazi.tif",
  "yil1.tif": "raster-ops/yil1.tif",
  "yil2.tif": "raster-ops/yil2.tif",
  "yil3.tif": "raster-ops/yil3.tif"
 },
 "documents": {
  "raster-ops.kcad": {
   "defaults": {
    "lengthDecimals": 3,
    "areaDecimals": 2,
    "angleUnit": "grad",
    "plotScale": 1000,
    "drawingFont": "barlow",
    "activeLayer": "kot",
    "measureHeightMm": 2
   },
   "tools": {
    "raster.calculator": {
     "input": {
      "scope": "visible"
     },
     "expression": "",
     "empty": "propagate",
     "sample": "f32",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Hesap"
     }
    },
    "raster.reclassify": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "table": "",
     "bounds": "upperClosed",
     "unmatched": "keep",
     "sample": "f32",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Sınıflar"
     }
    },
    "raster.clipByMask": {
     "input": {
      "scope": "selection"
     },
     "mask": {
      "scope": "layer",
      "layerId": "kot"
     },
     "crop": true,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Kırpılmış"
     }
    },
    "raster.mosaic": {
     "input": {
      "scope": "selection"
     },
     "overlap": "top",
     "sampling": "nearest",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Mozaik"
     }
    },
    "raster.resample": {
     "input": {
      "scope": "selection"
     },
     "cell": 0,
     "method": "nearest",
     "output": "",
     "add": true,
     "layer": {
      "newName": "Örneklenmiş"
     }
    },
    "raster.zonalStatistics": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "zones": {
      "scope": "layer",
      "layerId": "kot"
     },
     "stat": "mean",
     "output": "Ortalama",
     "decimals": 3
    },
    "raster.histogram": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "bins": 20,
     "min": null,
     "max": null
    },
    "raster.focalStatistics": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "shape": "rect",
     "width": 3,
     "height": 3,
     "radius": 3,
     "inner": 1,
     "stat": "mean",
     "ignore": true,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Komşuluk"
     }
    },
    "raster.cellStatistics": {
     "input": {
      "scope": "selection"
     },
     "band": 1,
     "stat": "mean",
     "ignore": true,
     "output": "",
     "add": true,
     "layer": {
      "newName": "Hücre istatistiği"
     }
    }
   }
  }
 },
 "cases": [
  {
   "id": "calculator",
   "title": "Raster hesaplayıcı: [Kot] * 2 + [Fark], iki raster seçili; değersizler değersiz kalır",
   "document": "raster-ops.kcad",
   "selection": [
    1,
    2
   ],
   "run": {
    "tool": "raster.calculator"
   },
   "values": {
    "input": {
     "scope": "selection"
    },
    "expression": "[Kot] * 2 + [Fark]"
   },
   "expect": {
    "status": "ok",
    "undo": "Raster hesaplayıcı",
    "summary": "9 × 7 hücrelik raster; “kot-hesap.tif” yazıldı.",
    "outputs": {
     "file": "kot-hesap.tif"
    },
    "layers": [
     {
      "id": "islem-hesap",
      "name": "Hesap",
      "style": {
       "color": "#7A6B5B",
       "lineType": "continuous",
       "lineWeight": 0.25
      }
     }
    ],
    "added": [
     {
      "kind": "raster",
      "layerId": "islem-hesap",
      "attrs": {},
      "affine": [
       500000.0,
       2.0,
       0.0,
       4420000.0,
       0.0,
       -2.0
      ],
      "width": 9,
      "height": 7,
      "bands": 1,
      "sample": "f32",
      "file": "kot-hesap.tif",
      "srid": 5254,
      "style": {
       "render": "ramp",
       "bands": [
        1
