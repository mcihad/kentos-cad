{
  "format": "kentos.document-ops",
  "version": 1,
  "title": "Katmanlar: görünürlük, kilit, klasör, ad ve stil",
  "note": "Katman beklentisinde visible, locked, expanded, name ve style düğümün kendi değeridir; isVisible ve isLocked üst grupları da hesaba katan yanıttır (LayerStore.isVisible, isLocked). Görünürlük, kilit ve ad proje verisidir: belgeyi kirletir, ama geri alma geçmişine girmez. Katman stili (setLayerStyle), katman ekleme (addLayer, layer-add.json) ve silme (removeLayer, layer-remove.json) geri alınabilir.",
  "setup": {
    "format": "kentos.document",
    "version": 1,
    "name": "Katmanlar",
    "settings": {
      "srid": 5256,
      "lengthDecimals": 3,
      "areaDecimals": 2,
      "areaUnit": "m2",
      "angleUnit": "grad",
      "plotScale": 1000,
      "workspace": "gis",
      "drawingFont": "barlow"
    },
    "origin": {"x": 486500, "y": 4420100},
    "layers": [
      {
        "id": "g",
        "name": "Yapılar",
        "type": "group",
        "visible": true,
        "locked": false,
        "expanded": true,
        "style": {"color": "fg", "lineType": "continuous", "lineWeight": 0.18},
        "children": [
          {
            "id": "a",
            "name": "Bina",
            "type": "layer",
            "visible": true,
            "locked": false,
            "expanded": true,
            "style": {"color": "fg", "lineType": "continuous", "lineWeight": 0.18},
            "children": []
          },
          {
            "id": "b",
            "name": "Yol",
            "type": "layer",
            "visible": false,
            "locked": false,
            "expanded": true,
            "style": {"color": "fg", "lineType": "continuous", "lineWeight": 0.18},
            "children": []
          }
        ]
      },
      {
        "id": "c",
        "name": "Parsel",
        "type": "layer",
        "visible": true,
        "locked": false,
        "expanded": true,
        "style": {"color": "fg", "lineType": "continuous", "lineWeight": 0.18},
        "children": []
      }
    ],
    "activeLayer": "a",
    "entities": [
      {"id": 1, "kind": "point", "layerId": "a", "p": {"x": 486512.34, "y": 4420123.45}, "attrs": {}},
      {"id": 2, "kind": "point", "layerId": "b", "p": {"x": 486520.25, "y": 4420110.5}, "attrs": {}},
      {"id": 3, "kind": "point", "layerId": "c", "p": {"x": 486530, "y": 4420130}, "attrs": {}}
    ],
    "styles": {"items": [], "categories": []}
  },
  "scenarios": [
    {
      "name": "Görünürlük katmanda ve üst gruplarında aranır; düzenlemedir ama geri alınmaz",
      "steps": [
        {
          "op": "check",
          "expect": {
            "dirty": false,
            "layers": {
              "g": {"visible": true, "isVisible": true},
              "a": {"visible": true, "isVisible": true},
              "b": {"visible": false, "isVisible": false},
              "c": {"visible": true, "isVisible": true}
            }
          }
        },
        {
          "op": "setVisible",
          "id": "g",
          "visible": false,
          "expect": {
            "dirty": true,
            "revision": "changed",
            "canUndo": false,
            "layers": {
              "g": {"visible": false, "isVisible": false},
              "a": {"visible": true, "isVisible": false},
              "c": {"visible": true, "isVisible": true}
            }
          }
        },
        {"op": "setVisible", "id": "g", "visible": false, "expect": {"revision": "same"}},
        {
          "op": "toggleVisible",
          "id": "a",
          "expect": {"revision": "changed", "layers": {"a": {"visible": false}}}
        },
        {
          "op": "undo",
          "returns": null,
          "note": "Görünürlük geri alma geçmişine girmez.",
          "expect": {"layers": {"g": {"visible": false}, "a": {"visible": false}}}
        },
        {
          "op": "showAll",
          "expect": {
            "revision": "changed",
            "layers": {
              "g": {"visible": true},
              "a": {"visible": true, "isVisible": true},
              "b": {"visible": true, "isVisible": true},
              "c": {"visible": true}
            }
          }
        },
        {"op": "captureRevision", "as": "kayıt"},
        {"op": "markSaved", "revision": "kayıt", "expect": {"dirty": false}},
        {
          "op": "showAll",
          "note": "Her şey zaten görünürken hiçbir şey değişmez: düzenleme değildir (docs/adr/0020).",
          "expect": {"dirty": false, "revision": "same"}
        },
        {"op": "setVisible", "id": "yok", "visible": false, "expect": {"revision": "same"}}
      ]
    },
    {
      "name": "Yalnızca bunu göster: katman, üst grupları ve altındakiler görünür, öbürleri gizlenir",
      "steps": [
        {
          "op": "isolate",
          "id": "a",
          "expect": {
            "dirty": true,
            "revision": "changed",
            "canUndo": false,
            "layers": {"g": {"visible": true}, "a": {"visible": true}, "b": {"visible": false}, "c": {"visible": false}}
          }
        },
        {
          "op": "isolate",
          "id": "g",
          "expect": {
            "layers": {"g": {"visible": true}, "a": {"visible": true}, "b": {"visible": true}, "c": {"visible": false}}
          }
        },
        {
          "op": "isolate",
          "id": "c",
          "expect": {
            "layers": {
              "g": {"visible": false},
              "a": {"visible": false, "isVisible": false},
              "b": {"visible": false},
              "c": {"visible": true, "isVisible": true}
            }
          }
        },
        {
          "op": "isolate",
          "id": "yok",
          "note": "Bilinmeyen katman hiçbir şeyi gizlemez; düzenleme değildir (docs/adr/0020; önce web bütün katmanları gizliyordu).",
          "expect": {
            "revision": "same",
            "layers": {"g": {"visible": false}, "a": {"visible": false}, "b": {"visible": false}, "c": {"visible": true}}
          }
        }
      ]
    },
    {
      "name": "Katmanı yalıt: birden çok katman ya da grup, üstlerindeki gruplar ve altındakiler görünür, öbürleri gizlenir; hiçbir şey değişmezse düzenleme değildir (docs/adr/0177 §1)",
      "steps": [
        {
          "op": "isolateLayers",
          "ids": ["b"],
          "returns": true,
          "note": "Gizli katman yalıtılınca görünür olur.",
          "expect": {
            "dirty": true,
            "revision": "changed",
            "canUndo": false,
            "layers": {
              "g": {"visible": true},
              "a": {"visible": false},
              "b": {"visible": true, "isVisible": true},
              "c": {"visible": false}
            }
          }
        },
        {
          "op": "isolateLayers",
          "ids": ["a", "c"],
          "returns": true,
          "expect": {
            "revision": "changed",
            "layers": {
              "g": {"visible": true},
              "a": {"visible": true, "isVisible": true},
              "b": {"visible": false},
              "c": {"visible": true}
            }
          }
        },
        {
          "op": "captureRevision",
          "as": "yalıtık"
        },
        {
          "op": "markSaved",
          "revision": "yalıtık",
          "expect": {"dirty": false}
        },
        {
          "op": "isolateLayers",
          "ids": ["c", "yok", "a"],
          "returns": false,
          "note": "Aynı katmanlar yeniden: hiçbir şey değişmez, düzenleme değildir; bilinmeyen kimlik atlanır.",
          "expect": {"dirty": false, "revision": "same"}
        },
        {
          "op": "isolateLayers",
          "ids": ["g"],
          "returns": true,
          "note": "Grup altındakilerle görünür.",
          "expect": {
            "dirty": true,
            "layers": {
              "g": {"visible": true},
              "a": {"visible": true},
              "b": {"visible": true},
              "c": {"visible": false, "isVisible": false}
            }
          }
        },
        {
          "op": "isolateLayers",
          "ids": ["yok"],
          "returns": false,
          "note": "Bilinen kimlik yoksa hiçbir şey değişmez.",
          "expect": {"revision": "same", "layers": {"c": {"visible": false}}}
        },
        {
          "op": "isolateLayers",
          "ids": [],
          "returns": false,
          "expect": {"revision": "same"}
        }
      ]
    },
    {
      "name": "Kilit üst gruptan miras alınır; model kilitli katmandaki düzenlemeyi reddetmez",
      "note": "Kilitli katmana yazmayı araçlar, komutlar, işlem çalıştırıcısı ve içe aktarma isLocked ile sorup reddeder; CadDocument'in kendisi denetlemez (web bugün böyle).",
      "steps": [
        {
          "op": "toggleLocked",
          "id": "g",
          "expect": {
            "dirty": true,
            "revision": "changed",
            "canUndo": false,
            "layers": {
              "g": {"locked": true, "isLocked": true},
              "a": {"locked": false, "isLocked": true},
              "b": {"isLocked": true},
              "c": {"isLocked": false}
            }
          }
        },
        {
          "op": "add",
          "entity": {"kind": "point", "layerId": "a", "p": {"x": 1, "y": 1}, "attrs": {}},
          "returns": 4,
          "expect": {"ids": [1, 2, 3, 4], "canUndo": true}
        },
        {
          "op": "update",
          "id": 1,
          "patch": {"attrs": {"N": "kilitli"}},
          "expect": {
            "entities": {
              "1": {
                "id": 1,
                "kind": "point",
                "layerId": "a",
                "p": {"x": 486512.34, "y": 4420123.45},
                "attrs": {"N": "kilitli"}
              }
            }
          }
        },
        {"op": "undo", "returns": "Değiştir"},
        {"op": "undo", "returns": "Ekle", "expect": {"ids": [1, 2, 3], "layers": {"g": {"locked": true}}}},
        {
          "op": "toggleLocked",
          "id": "g",
          "expect": {"layers": {"g": {"locked": false}, "a": {"isLocked": false}}}
        },
        {
          "op": "toggleLocked",
          "id": "a",
          "expect": {
            "layers": {"a": {"locked": true, "isLocked": true}, "g": {"isLocked": false}, "b": {"isLocked": false}}
          }
        }
      ]
    },
    {
      "name": "Katmanın kendi keneti: katmana ya da grubun her katmanına yazılır; düzenlemedir ama geri alınmaz",
      "note": "docs/adr/0163 §4. Grup kenet taşımaz; düğmesi içindeki katmanların hepsine yazar. Aynı değeri yeniden yazmak ve bilinmeyen katman düzenleme değildir.",
      "steps": [
        {
          "op": "setSnap",
          "id": "a",
          "snap": {"off": true},
          "expect": {"dirty": true, "revision": "changed", "canUndo": false, "layers": {"a": {"snap": {"off": true}}, "b": {"snap": null}, "g": {"snap": null}}}
        },
        {
          "op": "setSnap",
          "id": "a",
          "snap": {"off": true},
          "note": "Aynısı: düzenleme değildir.",
          "expect": {"revision": "same"}
        },
        {
          "op": "setSnap",
          "id": "g",
          "snap": {"kinds": ["endpoint", "intersection"]},
          "note": "Grubun düğmesi: içindeki her katmana; grup kenet taşımaz.",
          "expect": {
            "revision": "changed",
            "layers": {"a": {"snap": {"kinds": ["endpoint", "intersection"]}}, "b": {"snap": {"kinds": ["endpoint", "intersection"]}}, "g": {"snap": null}, "c": {"snap": null}}
          }
        },
        {
          "op": "setSnap",
          "id": "b",
          "snap": null,
          "note": "Genel türlere döner.",
          "expect": {"revision": "changed", "layers": {"a": {"snap": {"kinds": ["endpoint", "intersection"]}}, "b": {"snap": null}}}
        },
        {"op": "setSnap", "id": "yok", "snap": {"off": true}, "expect": {"revision": "same"}}
      ]
    },
    {
      "name": "Klasörü açıp kapamak ve etkin katmanı seçmek düzenleme değildir",
      "note": "İkisi de dosyaya yazılır (expanded, activeLayer), ama belgeyi kirletmez (web bugün böyle).",
      "steps": [
        {
          "op": "setExpanded",
          "id": "g",
          "expanded": false,
          "expect": {"dirty": false, "revision": "same", "layers": {"g": {"expanded": false}}}
        },
        {"op": "setActive", "id": "c", "expect": {"activeLayer": "c", "dirty": false, "revision": "same"}},
        {"op": "setActive", "id": "g", "note": "Grup etkin katman olamaz.", "expect": {"activeLayer": "c"}},
        {"op": "setActive", "id": "yok", "expect": {"activeLayer": "c"}},
        {
          "op": "setExpanded",
          "id": "g",
          "expanded": true,
          "expect": {"dirty": false, "layers": {"g": {"expanded": true}}}
        }
      ]
    },
    {
      "name": "Katman adı kırpılır; boş ad yok sayılır",
      "steps": [
        {
          "op": "rename",
          "id": "a",
          "name": "  Bina 2  ",
          "expect": {"dirty": true, "revision": "changed", "canUndo": false, "layers": {"a": {"name": "Bina 2"}}}
        },
        {
          "op": "rename",
          "id": "a",
          "name": "   ",
          "expect": {"revision": "same", "layers": {"a": {"name": "Bina 2"}}}
        },
        {"op": "captureRevision", "as": "kayıt"},
        {"op": "markSaved", "revision": "kayıt", "expect": {"dirty": false}},
        {
          "op": "rename",
          "id": "a",
          "name": "Bina 2",
          "note": "Aynı adı yeniden vermek hiçbir şeyi değiştirmez: düzenleme değildir (docs/adr/0020).",
          "expect": {"dirty": false, "revision": "same"}
        },
        {"op": "rename", "id": "yok", "name": "X", "expect": {"revision": "same"}}
      ]
    },
    {
      "name": "Katman stili geri alınabilir bir düzenlemedir; değişmeyen stil adım bırakmaz",
      "steps": [
        {
          "op": "setLayerStyle",
          "id": "a",
          "patch": {"color": "#FF0000"},
          "expect": {
            "canUndo": true,
            "dirty": true,
            "revision": "changed",
            "layers": {"a": {"style": {"color": "#FF0000", "lineType": "continuous", "lineWeight": 0.18}}}
          }
        },
        {
          "op": "setLayerStyle",
          "id": "a",
          "patch": {"color": "#FF0000"},
          "expect": {"revision": "same", "canUndo": true}
        },
        {
          "op": "undo",
          "returns": "Katman stili",
          "expect": {
            "canUndo": false,
            "canRedo": true,
            "layers": {"a": {"style": {"color": "fg", "lineType": "continuous", "lineWeight": 0.18}}}
          }
        },
        {
          "op": "redo",
          "returns": "Katman stili",
          "expect": {"layers": {"a": {"style": {"color": "#FF0000", "lineType": "continuous", "lineWeight": 0.18}}}}
        },
        {
          "op": "setLayerStyle",
          "id": "a",
          "patch": {"fill": "#7FB2E526", "lineWeight": 0.35},
          "label": "Dolgu",
          "expect": {
            "layers": {
              "a": {
                "style": {"color": "#FF0000", "lineType": "continuous", "lineWeight": 0.35, "fill": "#7FB2E526"}
              }
            }
          }
        },
        {
          "op": "undo",
          "returns": "Dolgu",
          "expect": {"layers": {"a": {"style": {"color": "#FF0000", "lineType": "continuous", "lineWeight": 0.18}}}}
        },
        {
          "op": "setLayerStyle",
          "id": "a",
          "patch": {"renderer": {"type": "single", "symbols": {"fill": {"ref": "temel.alan.dolu"}}}},
          "expect": {
            "layers": {
              "a": {
                "style": {
                  "color": "#FF0000",
                  "lineType": "continuous",
                  "lineWeight": 0.18,
                  "renderer": {"type": "single", "symbols": {"fill": {"ref": "temel.alan.dolu"}}}
                }
              }
            }
          }
        },
        {
          "op": "setLayerStyle",
          "id": "a",
          "patch": {"renderer": null},
          "note": "null alanı siler.",
          "expect": {"layers": {"a": {"style": {"color": "#FF0000", "lineType": "continuous", "lineWeight": 0.18}}}}
        },
        {
          "op": "undo",
          "returns": "Katman stili",
          "expect": {
            "layers": {
              "a": {
                "style": {
                  "color": "#FF0000",
                  "lineType": "continuous",
                  "lineWeight": 0.18,
                  "renderer": {"type": "single", "symbols": {"fill": {"ref": "temel.alan.dolu"}}}
                }
              }
            }
          }
        },
        {"op": "setLayerStyle", "id": "yok", "patch": {"color": "#00FF00"}, "expect": {"revision": "same"}}
      ]
    },
    {
      "name": "Katman stili ile nesne değişikliği aynı işlemde tek adımdır",
      "steps": [
        {
          "op": "transact",
          "label": "Katman ve nesne",
          "steps": [
            {"op": "setLayerStyle", "id": "c", "patch": {"lineType": "dashed"}},
            {
              "op": "add",
              "entity": {"kind": "point", "layerId": "c", "p": {"x": 5, "y": 5}, "attrs": {}},
              "returns": 4
            }
          ],
          "expect": {
            "ids": [1, 2, 3, 4],
            "canUndo": true,
            "dirty": true,
            "revision": "changed",
            "layers": {"c": {"style": {"color": "fg", "lineType": "dashed", "lineWeight": 0.18}}}
          }
        },
        {
          "op": "undo",
          "returns": "Katman ve nesne",
          "expect": {
            "ids": [1, 2, 3],
            "layers": {"c": {"style": {"color": "fg", "lineType": "continuous", "lineWeight": 0.18}}}
          }
        },
        {
          "op": "redo",
          "returns": "Katman ve nesne",
          "expect": {
            "ids": [1, 2, 3, 4],
            "layers": {"c": {"style": {"color": "fg", "lineType": "dashed", "lineWeight": 0.18}}}
          }
        }
      ]
    },
    {
      "name": "Görünürlük işlemin dışındadır: geri alınan işlem onu geri çevirmez",
      "note": "Görünürlük, kilit ve ad işlemin adımı olmadığı için geri alınan işlem onları olduğu gibi bırakır; belge bu yüzden kirli kalır (web bugün böyle).",
      "steps": [
        {
          "op": "transact",
          "label": "Yarım",
          "steps": [
            {"op": "setVisible", "id": "c", "visible": false},
            {
              "op": "add",
              "entity": {"kind": "point", "layerId": "c", "p": {"x": 5, "y": 5}, "attrs": {}},
              "returns": 4
            }
          ],
          "throw": "geri",
          "catch": "geri",
          "expect": {
            "ids": [1, 2, 3],
            "canUndo": false,
            "dirty": true,
            "revision": "changed",
            "layers": {"c": {"visible": false}}
          }
        }
      ]
    },
    {
      "name": "Katman ekleme: grubun içine, katmanın grubuna, en üste; girdiği grup açılır; her ekleme bir geri alma adımıdır (ayrıntısı layer-add.json)",
      "note": "Kimliksiz katman layer-N alır; sayaç platformun kendisidir (web modül genelinde sayar), bu yüzden senaryolar kimliği verir.",
      "steps": [
        {"op": "setExpanded", "id": "g", "expanded": false, "expect": {"dirty": false, "layers": {"g": {"expanded": false}}}},
        {
          "op": "addLayer",
          "layer": {"id": "d", "name": "Duvar"},
          "parent": "g",
          "returns": "d",
          "expect": {
            "tree": {"": ["g", "c"], "g": ["a", "b", "d"]},
            "dirty": true,
            "revision": "changed",
            "canUndo": true,
            "activeLayer": "a",
            "layers": {
              "g": {"expanded": true},
              "d": {"name": "Duvar", "visible": true, "locked": false, "expanded": true, "style": {"color": "fg", "lineType": "continuous", "lineWeight": 0.18}, "isVisible": true, "isLocked": false}
            }
          }
        },
        {
          "op": "addLayer",
          "layer": {"id": "e", "name": "Kapı"},
          "parent": "a",
          "returns": "e",
          "note": "Katmanın altına değil, katmanın grubuna, en sona.",
          "expect": {"tree": {"g": ["a", "b", "d", "e"]}}
        },
        {
          "op": "addLayer",
          "layer": {"id": "f", "name": "Ağaç"},
          "parent": "c",
          "returns": "f",
          "note": "En üstteki katmanın grubu yoktur: en üste.",
          "expect": {"tree": {"": ["g", "c", "f"]}}
        },
        {
          "op": "addLayer",
          "layer": {"id": "h", "name": "Harita", "type": "group"},
          "parent": null,
          "returns": "h",
          "expect": {"tree": {"": ["g", "c", "f", "h"], "h": []}, "layers": {"h": {"expanded": true, "style": {"color": "fg", "lineType": "continuous", "lineWeight": 0.18}}}}
        },
        {"op": "addLayer", "layer": {"id": "i", "name": "Pafta"}, "parent": "h", "returns": "i", "expect": {"tree": {"h": ["i"]}}},
        {
          "op": "addLayer",
          "layer": {"id": "j", "name": "Sınır"},
          "parent": "yok",
          "returns": "j",
          "note": "Bilinmeyen üst: en üste.",
          "expect": {"tree": {"": ["g", "c", "f", "h", "j"]}}
        },
        {"op": "undo", "returns": "Katman ekle", "note": "Son ekleme (Sınır) geri alınır.", "expect": {"tree": {"": ["g", "c", "f", "h"]}, "dirty": true}}
      ]
    },
    {
      "name": "Yeni katmanın görünürlüğü, kilidi ve stili verilir; verilmeyen stil alanı varsayılandır; gizli gruba giren katman görünmez",
      "steps": [
        {
          "op": "addLayer",
          "layer": {"id": "k", "name": "Kot", "visible": false, "locked": true, "style": {"color": "#ff0000", "lineWeight": 0.35}},
          "parent": null,
          "returns": "k",
          "expect": {
            "layers": {
              "k": {"visible": false, "locked": true, "isVisible": false, "isLocked": true, "style": {"color": "#ff0000", "lineType": "continuous", "lineWeight": 0.35}}
            }
          }
        },
        {"op": "setVisible", "id": "g", "visible": false},
        {
          "op": "addLayer",
          "layer": {"id": "m", "name": "Merdiven"},
          "parent": "g",
          "returns": "m",
          "expect": {"layers": {"m": {"visible": true, "isVisible": false}, "g": {"visible": false}}}
