<?xml version="1.0" encoding="UTF-8"?>
<WMS_Capabilities version="1.3.0" xmlns="http://www.opengis.net/wms" xmlns:xlink="http://www.w3.org/1999/xlink">
  <Service>
    <Name>WMS</Name>
    <Title>Ankara Kent Bilgi Sistemi</Title>
    <Abstract>Parseller, yapılar ve imar planı.</Abstract>
  </Service>
  <Capability>
    <Request>
      <GetCapabilities><Format>text/xml</Format><DCPType><HTTP><Get><OnlineResource xlink:type="simple" xlink:href="https://kbs.ornek.bel.tr/geoserver/wms?"/></Get></HTTP></DCPType></GetCapabilities>
      <GetMap>
        <Format>image/png</Format><Format>image/jpeg</Format><Format>image/png; mode=8bit</Format>
        <DCPType><HTTP><Get><OnlineResource xlink:type="simple" xlink:href="https://kbs.ornek.bel.tr/geoserver/ows?"/></Get></HTTP></DCPType>
      </GetMap>
      <GetFeatureInfo>
        <Format>text/plain</Format><Format>application/json</Format><Format>text/html</Format>
        <DCPType><HTTP><Get><OnlineResource xlink:type="simple" xlink:href="https://kbs.ornek.bel.tr/geoserver/ows?"/></Get></HTTP></DCPType>
      </GetFeatureInfo>
    </Request>
    <Exception><Format>XML</Format></Exception>
    <Layer>
      <Title>Kent bilgi sistemi</Title>
      <CRS>EPSG:5254</CRS>
      <CRS>EPSG:3857</CRS>
      <EX_GeographicBoundingBox><westBoundLongitude>32.3</westBoundLongitude><eastBoundLongitude>33.2</eastBoundLongitude><southBoundLatitude>39.6</southBoundLatitude><northBoundLatitude>40.2</northBoundLatitude></EX_GeographicBoundingBox>
      <Layer>
        <Title>Kadastro</Title>
        <CRS>EPSG:5255</CRS>
        <Layer queryable="1">
          <Name>kadastro:parsel</Name>
          <Title>Parseller</Title>
          <Abstract>Tapu parselleri.</Abstract>
          <CRS>EPSG:4326</CRS>
          <EX_GeographicBoundingBox><westBoundLongitude>32.5</westBoundLongitude><eastBoundLongitude>33.0</eastBoundLongitude><southBoundLatitude>39.7</southBoundLatitude><northBoundLatitude>40.1</northBoundLatitude></EX_GeographicBoundingBox>
          <BoundingBox CRS="EPSG:4326" minx="39.7" miny="32.5" maxx="40.1" maxy="33.0"/>
          <Style><Name>parsel_cizgi</Name><Title>Parsel çizgisi</Title></Style>
          <Style><Name>parsel_dolgu</Name><Title>Parsel dolgusu</Title></Style>
        </Layer>
        <Layer queryable="0">
          <Name>kadastro:yapi</Name>
          <Title>Yapılar</Title>
          <Style><Name>default</Name><Title>Varsayılan</Title></Style>
        </Layer>
      </Layer>
      <Layer queryable="1" opaque="1">
        <Name>imar:plan</Name>
        <Title>İmar planı</Title>
        <MinScaleDenominator>500</MinScaleDenominator>
        <MaxScaleDenominator>25000</MaxScaleDenominator>
      </Layer>
    </Layer>
  </Capability>
</WMS_Capabilities>
