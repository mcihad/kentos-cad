  {
   "name": "Parsel katmanı",
   "command": "cad.layers.edit",
   "input": {
    "operation": "add",
    "name": "Parsel",
    "activate": true
   },
   "bind": {
    "parsel": "layer"
   }
  },
  {
   "name": "Parsel katmanının tipli alanları",
   "command": "cad.layers.edit",
   "input": {
    "operation": "fields",
    "layer": "$parsel",
    "fields": [
     {
      "name": "ada",
      "kind": "integer"
     },
     {
      "name": "parsel",
      "kind": "integer"
     },
     {
      "name": "malik",
      "kind": "text"
     },
     {
      "name": "tapu_alani",
      "kind": "decimal"
     },
     {
      "name": "hesap_alani",
      "kind": "decimal"
     },
