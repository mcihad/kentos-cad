      "arch": {
       "level": "zemin"
      }
     },
     {
      "seed": {
       "x": 4.775,
       "y": 7.375
      },
      "number": "03",
      "name": "Tesisat şaftı",
      "void": true,
      "arch": {
       "level": "zemin"
      }
     }
    ]
   },
   "as": [
    "yatak",
    "salon",
    "shaft"
   ],
   "label": "Mahal",
   "expect": {
    "count": 9,
    "measures": {
