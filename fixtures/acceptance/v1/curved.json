{
 "format": "kentos.acceptance",
 "version": 1,
 "id": "curved",
 "title": "Eğrisel ve şaftlı zor örnek: yarım daire cumba, tesisat şaftı, döner merdiven, yaydaki pencere",
 "source": "plan/architecture-advanced.md ADV-07 (kabul korpusu); docs/adr/0798",
 "project": {
  "name": "Cumba",
  "workspace": "cad",
  "coords": "local",
  "drawingUnit": "m",
  "plotScale": 100
 },
 "tolerance": 1e-09,
 "undone": 8,
 "steps": [
  {
   "name": "Proje ayarları › Mimari: zemin kat, 3.00 m",
   "command": "cad.settings.set",
   "input": {
    "arch": {
     "levels": [
      {
       "id": "zemin",
       "name": "Zemin kat",
       "elevation": 0,
       "height": 3.0
      }
     ]
    }
   },
   "label": null,
   "expect": {
    "count": 0
   }
  },
  {
   "name": "Dış duvar: 10 × 8 m, doğusu yarım daire cumba (büküm 1), ortalı 25 cm",
   "command": "cad.walls.create",
   "input": {
    "layerId": "$layer",
    "walls": [
     {
      "pts": [
       {
        "x": 0.0,
        "y": 0.0
       },
       {
        "x": 10.0,
        "y": 0.0
       },
       {
        "x": 10.0,
        "y": 8.0
       },
       {
        "x": 0.0,
        "y": 8.0
       }
      ],
      "bulges": [
       0.0,
       1.0,
       0.0,
       0.0
      ],
      "closed": true,
      "width": 0.25,
      "arch": {
       "level": "zemin"
      }
     }
    ]
   },
   "as": "shell",
   "label": "Duvar",
   "expect": {
    "count": 1,
    "objects": {
     "shell": {
      "bulges": [
       0.0,
       1.0,
       0.0,
       0.0
      ]
     }
    }
   }
  },
  {
   "name": "Bölme: batı yüzden 4.00 net",
   "command": "cad.walls.partition",
   "input": {
    "source": {
     "wall": "$shell",
     "edge": 3
    },
    "side": "left",
    "measure": "clear",
    "distance": 4.0,
    "wall": {
     "layerId": "$layer",
     "walls": [
      {
       "pts": [],
       "closed": false,
       "width": 0.15,
       "arch": {
        "level": "zemin"
       }
      }
     ]
    }
   },
   "as": "p1",
   "label": "Duvar",
   "expect": {
    "count": 2,
    "objects": {
     "p1": {
      "pts": [
       [
        4.2,
        8.0
       ],
       [
        4.2,
        0.0
       ]
      ]
     }
    }
   }
  },
  {
   "name": "Şaft: bölme ile kuzey duvarı köşesinde 1 × 1 m net, L duvar",
   "command": "cad.walls.create",
   "input": {
    "layerId": "$layer",
    "walls": [
     {
      "pts": [
       {
        "x": 5.35,
        "y": 8.0
       },
       {
        "x": 5.35,
        "y": 6.8
       },
       {
        "x": 4.2,
        "y": 6.8
       }
      ],
      "closed": false,
      "width": 0.15,
      "arch": {
       "level": "zemin"
      }
     }
    ]
   },
   "as": "shaftWall",
   "label": "Duvar",
   "expect": {
    "count": 3
   }
  },
  {
   "name": "Açıklıklar: iç kapı, cumbanın ortasında pencere, batı pencere",
   "command": "cad.openings.create",
   "input": {
    "layerId": "$layer",
    "openings": [
     {
      "host": "$p1",
      "at": 5.0,
      "form": "door",
      "width": 0.9
     },
     {
      "host": "$shell",
      "at": 16.283185307179586,
      "form": "window",
      "width": 1.2,
      "sill": 0.9
     },
     {
      "host": "$shell",
      "at": 36.56637061435917,
      "form": "window",
      "width": 1.2,
      "sill": 0.9
     }
    ]
   },
   "as": [
    "door",
    "bay",
    "west"
   ],
   "label": "Kapı",
   "expect": {
    "count": 6,
    "objects": {
     "bay": {
      "host": "$shell",
      "at": 16.283185307179586
     }
    }
   }
  },
  {
   "name": "Mahaller: Yatak, cumbalı Salon, şaft (boşluk)",
   "command": "cad.spaces.create",
   "input": {
    "layerId": "$layer",
    "spaces": [
     {
      "seed": {
       "x": 2.0,
       "y": 4.0
      },
      "number": "01",
      "name": "Yatak odası",
