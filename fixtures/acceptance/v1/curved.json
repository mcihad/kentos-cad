      "area": 31.0
     },
     "salon": {
      "area": 66.63273859452961
     },
     "shaft": {
      "area": 0.9999999999999991
     }
    }
   }
  },
  {
   "name": "Döner merdiven: cumbada, kat yüksekliğine bağlı, yürüme çizgisi 1.50",
   "command": "cad.stairs.create",
