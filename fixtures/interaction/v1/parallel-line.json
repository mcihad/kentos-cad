{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "parallel-line",
  "title": "Paralel çizgi: eksen tıklanırken iki yan, köşelerde birleşik; Geri (G), sağ tıkla bitirme, tek adımda geri alma; yazılan ve iki noktayla gösterilen mesafe, Enter eski değeri korur; eksen çizilmeden koridor alanı, Kapat (K)",
  "source": "Web'in ParallelLineTool'u (parallelTool.ts) ve cad.entities.create, ADR 0057",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "empty.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.parallel", "expect": { "tool": "parallel", "points": 0, "options": ["S", "A", "E", "U"], "entities": 0 } },
    { "click": [-20, 0], "expect": { "points": 1, "options": ["G", "S", "A", "E", "U"] } },
    { "click": [0, 0], "expect": { "points": 2, "options": ["G", "S", "A", "E", "U"] } },
    { "click": [0, 10], "expect": { "points": 3, "options": ["G", "K", "S", "A", "E", "U"] } },
    { "key": "G", "note": "Geri (G) eksenin son noktasını alır.", "expect": { "points": 2 } },
    { "move": [0, 10], "note": "Önizleme: eksen ve 5'er metre iki yanı, köşede birleşik." },
    { "click": [0, 10], "expect": { "points": 3 } },
    { "rightClick": [10, 10], "note": "Sağ tık bitirir: sol yan, sağ yan ve eksen tek adımda.", "expect": { "entities": 3, "points": 0, "log": "success", "objects": [{ "id": 1, "kind": "polyline", "points": [[-20, 5], [-5, 5], [-5, 10]] }, { "id": 2, "kind": "polyline", "points": [[-20, -5], [5, -5], [5, 10]] }, { "id": 3, "kind": "polyline", "points": [[-20, 0], [0, 0], [0, 10]] }] } },
    { "key": "Ctrl+Z", "note": "Üç nesne tek adımda geri alınır; araç sürer.", "expect": { "entities": 0, "canRedo": true, "tool": "parallel" } },
    { "key": "S", "note": "Sol mesafe sorulur.", "expect": { "options": [], "points": 0 } },
    { "key": "Enter", "note": "Enter soruyu bırakır, eski mesafe kalır.", "expect": { "options": ["S", "A", "E", "U"], "tool": "parallel" } },
    { "key": "S" },
    { "text": "2" },
    { "key": "Enter", "note": "Sol mesafe yazıldı.", "expect": { "options": ["S", "A", "E", "U"], "log": "info" } },
    { "key": "A", "note": "Sağ mesafe iki noktayla gösterilir.", "expect": { "options": [] } },
    { "click": [0, -10], "expect": { "points": 0, "options": [] } },
    { "click": [0, -13], "expect": { "options": ["S", "A", "E", "U"], "log": "info" } },
    { "key": "E", "note": "Eksen çizilmez.", "expect": { "options": ["S", "A", "E", "U"] } },
    { "key": "U", "note": "Alan olarak: iki yanın arası tek alan.", "expect": { "options": ["S", "A", "E", "U"] } },
    { "click": [-20, -10] },
    { "move": [10, -10], "note": "Önizleme: koridor alanı dolgulu, eksen kesikli." },
    { "click": [10, -10], "expect": { "points": 2 } },
    { "key": "Enter", "note": "Solu 2, sağı 3 metre: 30 × 5 m'lik alan; eksen yok.", "expect": { "entities": 1, "newest": { "kind": "polygon", "points": [[-20, -13], [10, -13], [10, -8], [-20, -8]] }, "points": 0, "log": "success" } },
    { "click": [-20, 5] },
    { "click": [-10, 5] },
    { "click": [-10, 15], "expect": { "points": 3, "options": ["G", "K", "S", "A", "E", "U"] } },
    { "key": "K", "note": "Kapalı eksen: koridor delikli tek alan.", "expect": { "entities": 2, "newest": { "kind": "polygon" }, "points": 0, "log": "success" } },
    { "key": "S", "note": "Mesafeler, eksen ve alan seçimi oturum boyunca kalır: iz onları başladığı gibi bırakır." },
    { "text": "5" },
    { "key": "Enter" },
    { "key": "A" },
    { "text": "5" },
    { "key": "Enter" },
    { "key": "E" },
    { "key": "U", "expect": { "options": ["S", "A", "E", "U"], "entities": 2 } },
    { "key": "Enter", "note": "Nokta yokken Enter araçtan çıkar.", "expect": { "tool": "select", "entities": 2 } }
  ]
}
