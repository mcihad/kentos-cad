{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "arc-variants",
  "title": "Yay aracı: devam edilecek nesne yokken Devam uyarır; üç nokta; başlangıç–merkez ve yazılan açı; başlangıç–bitiş ve yazılan yarıçap; önce merkez; çizgiye teğet Devam; Ctrl+Z",
  "source": "Web'in ArcTool'u (curveTools.ts) ve cad.arc.create, ADR 0032",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "empty.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.arc", "expect": { "tool": "arc", "points": 0, "options": ["M", "D"] } },
    { "key": "D", "note": "Devam edilecek çizgi, yay ya da çoklu çizgi yok.", "expect": { "log": "warn", "points": 0, "entities": 0 } },
    { "click": [10, 0], "expect": { "points": 1, "options": ["M", "B"] } },
    { "click": [0, 10], "expect": { "points": 2, "options": [] } },
    { "move": [-6, 8], "note": "Önizleme: üç noktadan geçen yay, yarıçapı ve açısı." },
    { "click": [-10, 0], "note": "Üç noktadan: saat yönünün tersine saklanır.", "expect": { "entities": 1, "newest": { "kind": "arc", "center": [0, 0], "radius": 10, "points": [[10, 0], [-10, 0]] }, "log": "success", "points": 0, "options": ["M", "D"] } },
    { "click": [25, 0] },
    { "key": "M", "expect": { "options": [], "points": 1 } },
    { "click": [20, 0], "expect": { "points": 2, "options": ["A", "U"] } },
    { "key": "A", "expect": { "options": ["N", "U"] } },
    { "text": "90" },
    { "key": "Enter", "note": "Başlangıç, merkez ve yazılan açı.", "expect": { "entities": 2, "newest": { "kind": "arc", "center": [20, 0], "radius": 5, "points": [[25, 0], [20, 5]] }, "options": ["M", "D"] } },
    { "click": [0, -10] },
    { "key": "B", "expect": { "options": [], "points": 1 } },
    { "click": [10, -10], "expect": { "points": 2, "options": ["A", "Y", "R"] } },
    { "key": "R", "expect": { "options": ["M", "A", "Y"] } },
    { "text": "5" },
    { "key": "Enter", "note": "Başlangıç, bitiş ve yazılan yarıçap: küçük yay, saat yönünün tersine.", "expect": { "entities": 3, "newest": { "kind": "arc", "center": [5, -10], "radius": 5, "points": [[0, -10], [10, -10]] } } },
    { "key": "M", "note": "Önce merkez.", "expect": { "options": [], "points": 0 } },
    { "click": [-20, 5], "expect": { "points": 1 } },
    { "click": [-15, 5], "expect": { "points": 2, "options": ["A", "U"] } },
    { "click": [-20, 10], "expect": { "entities": 4, "newest": { "kind": "arc", "center": [-20, 5], "radius": 5, "points": [[-15, 5], [-20, 10]] } } },
    { "run": "tool.line" },
    { "click": [-25, -15] },
    { "click": [-15, -15] },
    { "key": "Enter", "expect": { "entities": 5, "tool": "line" } },
    { "run": "tool.arc", "expect": { "options": ["M", "D"] } },
    { "key": "D", "note": "Son çizginin ucundan, doğrultusuna teğet.", "expect": { "points": 1, "options": [] } },
    { "move": [-15, -5], "note": "Önizleme: çizgiye teğet devam eden yay." },
    { "click": [-15, -5], "expect": { "entities": 6, "newest": { "kind": "arc", "center": [-15, -10], "radius": 5, "points": [[-15, -15], [-15, -5]] }, "log": "success" } },
    { "key": "Ctrl+Z", "expect": { "entities": 5, "tool": "arc", "canRedo": true } },
    { "key": "Esc", "expect": { "tool": "select" } }
  ]
}
