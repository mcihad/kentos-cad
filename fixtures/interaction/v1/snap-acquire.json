{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "snap-acquire",
  "title": "Uzantı ve Paralel'in alınması: bir uçta durmak ucun uzantısını, bir kenarda durmak doğrultusunu alır (nesne izleme kapalıyken de); imleç uzantıya ve son noktadan geçen paralele oturur, yazılan mesafe onların boyuncadır; aynı uçta yeniden durmak bırakır",
  "source": "ADR 0163 §2; web ViewportController.updateTracking, trackAlong",
  "covers": ["HYB-09"],
  "document": "snap-acquire.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": true, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "draft.snap.extension", "note": "Kenet hücresinin menüsünden Uzantı ve Paralel; nesne izleme kapalı." },
    { "run": "draft.snap.parallel" },
    { "run": "tool.polyline", "expect": { "tool": "polyline" } },
    { "text": "486988,4420006", "note": "İlk köşe yazılarak (−12; 6): köşe farkları kesin." },
    { "key": "Enter", "expect": { "points": 1 } },
    { "move": [3, -9.9], "note": "Bir şey alınmadan burada kenet yok.", "expect": { "snap": null } },
    { "rest": [-6, -10], "note": "1 numaralı çizginin ucunda durmak ucun uzantısını alır.", "expect": { "snap": "endpoint", "trackPoints": [[-6, -10]] } },
    { "move": [-1, -9.8], "expect": { "snap": "extension" } },
    { "text": "4", "note": "Yazılan mesafe uçtan uzantı boyuncadır: (−2; −10)." },
    { "key": "Enter", "expect": { "points": 2 } },
    { "rest": [7, -11.75], "note": "2 numaralı çizginin dörtte birinde (uç ya da orta değil) durmak doğrultusunu alır.", "expect": { "snap": null, "trackPoints": [[-6, -10]] } },
    { "move": [1.91, -6.88], "note": "Son noktadan geçen paralel.", "expect": { "snap": "parallel" } },
    { "text": "5", "note": "Yazılan mesafe son noktadan paralel boyuncadır: (2; −7)." },
    { "key": "Enter", "expect": { "points": 3 } },
    { "move": [3, -9.9], "note": "Uzantı alınmış durur.", "expect": { "snap": "extension" } },
    { "rest": [-6, -10], "note": "Aynı uçta yeniden durmak bırakır.", "expect": { "trackPoints": [] } },
    { "move": [3, -9.9], "expect": { "snap": null } },
    {
      "key": "Enter",
      "expect": { "entities": 3, "newest": { "kind": "polyline", "points": [[-12, 6], [-2, -10], [2, -7]], "edges": [[10, -16], [4, 3]] } }
    },
    { "key": "Esc", "expect": { "tool": "select" } }
  ]
}
