{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "measure-parcel",
  "title": "Mesafe ölç, Alan hesapla ve Parsel oluştur: yolun uzunluğu, Uzunluk (U) beklerken Ctrl+Z (Geri), yazılmayan ölçü; ilk köşeye tıklayarak kapanan alanın alanı ve çevresi; parsel katmanına numarasıyla yazılan ve seçilen parsel, tek adımda geri alma",
  "source": "Web'in PathTool'u (pathTool.ts: measureOnly, parcelLayer), ADR 0067",
  "covers": ["UX-01", "UX-09"],
  "document": "areas.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.measure", "expect": { "tool": "measure", "points": 0, "entities": 10 } },
    { "click": [-14, 4], "expect": { "points": 1, "log": "info" } },
    { "click": [-14, 10], "expect": { "points": 2, "options": ["Y", "U", "G", "Enter"] } },
    { "key": "U", "note": "Son doğrultuda yazılacak uzunluk beklenir.", "expect": { "options": ["G"] } },
    { "key": "Ctrl+Z", "note": "Ctrl+Z, Geri (G) gibi, son noktayı alır ve uzunluk beklemesini bitirir; beklerken G tuşu istemde olmadığı için Kapalı alan kısayoludur.", "expect": { "points": 1, "options": ["Y", "U", "G"] } },
    { "click": [-14, 10], "expect": { "points": 2 } },
    { "move": [-8, 10], "note": "İmlecin yanında kenarın uzunluğu, semti ve yolun toplamı." },
    { "click": [-8, 10], "expect": { "points": 3 } },
    { "key": "Enter", "note": "Toplam uzunluk ileti satırında; hiçbir şey yazılmaz.", "expect": { "tool": "measure", "points": 0, "log": "success", "entities": 10, "canUndo": false } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "run": "tool.area", "expect": { "tool": "area", "points": 0 } },
    { "click": [-14, 4] },
    { "click": [-8, 4] },
    { "click": [-8, 10] },
    { "click": [-14, 10], "expect": { "points": 4 } },
    { "move": [-14, 4], "note": "Kapanan alan kesikli ve soluk dolgulu; imlecin yanında alanı." },
    { "click": [-14, 4], "note": "İlk köşeye tıklamak alanı kapatır: alanı ve çevresi ileti satırında, hiçbir şey yazılmaz.", "expect": { "tool": "area", "points": 0, "log": "success", "entities": 10, "canUndo": false } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "run": "tool.parcel", "expect": { "tool": "parcel", "points": 0 } },
    { "click": [-14, 12] },
    { "click": [-8, 12] },
    { "click": [-8, 18] },
    { "click": [-14, 18], "expect": { "points": 4 } },
    { "click": [-14, 12], "note": "Parsel Parseller katmanına 4 numarasıyla yazılır ve seçilir; tapu alanı boş kalır.", "expect": { "tool": "parcel", "points": 0, "log": "success", "entities": 11, "selected": [11], "newest": { "kind": "polygon", "points": [[-14, 12], [-8, 12], [-8, 18], [-14, 18]] }, "canUndo": true } },
    { "key": "Ctrl+Z", "note": "Tek adım: “Ekle”.", "expect": { "entities": 10, "canRedo": true } },
    { "key": "Esc", "expect": { "tool": "select" } }
  ]
}
