    {"shot": "tam-xyz-onizleme"},
    {"dialog": "DXF içe aktar", "press": "İçe aktar", "expect": {"entities": 1,
      "newest": {"kind": "line", "points": [[-6,-3.6],[6,3.6]], "zs": [36,55.6]}}},
    {"click": [0,0], "expect": {"selected": [1]}},
    {"shot": "kotlu-cizgi"},
    {"key": "Ctrl+Z", "expect": {"entities": 0}},
    {"key": "Ctrl+Y", "expect": {"entities": 1,
      "newest": {"kind": "line", "points": [[-6,-3.6],[6,3.6]], "zs": [36,55.6]}}},
    {"saveAndReopen": true, "expect": {"entities": 1,
      "newest": {"kind": "line", "points": [[-6,-3.6],[6,3.6]], "zs": [36,55.6]}}},
    {"shot": "yeniden-acildi"}
  ]
