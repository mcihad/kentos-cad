    {"run": "tool.boundary", "expect": {"tool": "boundary"}},
    {"move": [4, -4], "note": "Önizleme cad.entities.boundary'nin bölgesi: çizgilerin kapattığı sol göz, içindeki kapalı çoklu çizgi delik."},
    {"shot": "alan-onizleme"},
