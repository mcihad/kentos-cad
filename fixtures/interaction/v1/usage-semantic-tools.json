    {"text": "4"},
    {"shot": "bol-onizleme"},
    {"key": "Enter", "note": "Dört parça: tıklamaya yakın uçtan üç nokta (20, 14, 8), tek adım “Böl”.", "expect": {"entities": 13, "newest": {"kind": "point", "points": [[8, -6]]}, "log": "success"}},
    {"key": "Esc", "expect": {"tool": "select"}},
    {"run": "tool.break", "expect": {"tool": "break"}},
    {"click": [18, 10], "note": "Kırılacak çizgi ilk kırılma noktasından seçilir."},
    {"move": [22, 10], "note": "Önizleme cad.entities.break'in planı: kalkacak kısım."},
    {"shot": "kir-onizleme"},
    {"click": [22, 10], "note": "İki nokta arası kalkar: çizgi iki parça, tek adım “Kır”.", "expect": {"entities": 14, "log": "success"}},
    {"key": "Esc", "expect": {"tool": "select"}},
    {"key": "Esc", "note": "Alan oluştur'un yazdığı alan seçimden çıkar: seçim varken Esnet yalnız seçileni esnetir."},
    {"run": "tool.stretch", "expect": {"tool": "stretch"}},
    {"drag": [[24, -8], [27.5, 12]], "note": "Pencere sağ kenarın iki ucuna değer.", "expect": {"tool": "stretch"}},
    {"click": [26, 10], "note": "Temel nokta."},
    {"move": [29, 10], "note": "Önizleme cad.entities.stretch'in planı: penceredeki uçlar imleçle kayar."},
    {"shot": "esnet-onizleme"},
    {"text": "@3,0"},
    {"key": "Enter", "note": "Pencere içindeki uçlar 3 m doğuya kayar, tek adım “Esnet”.", "expect": {"tool": "select", "entities": 14, "log": "success", "objects": [{"id": 4, "kind": "line", "points": [[29, -6], [29, 10]]}]}},
    {"run": "tool.circle", "expect": {"tool": "circle"}},
    {"click": [20, 2]},
    {"text": "3"},
    {"key": "Enter", "expect": {"entities": 15, "newest": {"kind": "circle"}}},
    {"key": "Esc", "expect": {"tool": "select"}},
    {"run": "tool.dimension", "expect": {"tool": "dimension"}},
    {"text": "r", "note": "Yarıçap."},
    {"click": [23, 2], "note": "Daire seçilir: komutun girdisinde dairenin kimliği ve tıklanan yer."},
    {"move": [25, 6], "note": "Önizleme cad.dimensions.create'in ölçüsü: imlecin yönünde yarıçap."},
    {"shot": "olcu-onizleme"},
    {"click": [25, 6], "note": "Ölçü komutla yazılır (“Ekle”).", "expect": {"entities": 16, "newest": {"kind": "dimension"}, "log": "success"}},
    {"shot": "sonuc"},
    {"text": "h", "note": "Bellek başladığı gibi bırakılır: Hizalı."},
    {"key": "Esc", "expect": {"tool": "select"}}
