  "id": "usage-semantic-tools",
  "title": "Tarama, Alan oluştur, Böl, Kır, Esnet ve Ölçülendirme anlamsal komutlarla: önizleme komutun bölgesi ya da ölçüsü, tıklama komutun kendisi",
  "source": "docs/adr/0254 (cad.entities.hatch, .boundary, .divide, .break, .stretch), docs/adr/0255 (cad.dimensions.create)",
  "covers": ["CAD-CMD-05", "CAD-CMD-06"],
  "document": "hatch.kcad",
  "view": {"center": [487000, 4420000], "metresPerPixel": 0.09},
  "draft": {"snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false},
  "prefs": {"cursorInput": true},
  "clickTolerance": 0.125,
  "steps": [
