{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "perpendiculars",
  "title": "Dik in ve Dik çık: referans hat (başlangıcı tıklamaya yakın uç), hatta ve uzantısına dik inme, hattın üstündeki nokta, daireye merkezden dik, Başka hat (H); yazılan ve gösterilen dik ayak ve dik boy, kilitli katmandaki kenar referans olur",
  "source": "Web'in PerpendicularInTool'u ve PerpendicularOutTool'u (perpTools.ts) ve cad.entities.create, ADR 0057",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "tools.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.perpIn", "expect": { "tool": "perpIn", "points": 0, "options": [], "entities": 4 } },
    { "move": [-20, -12], "note": "Referans aranırken kenarı imlecin altındaki nesne vurgulanır.", "expect": { "hover": 2 } },
    { "click": [-20, -12], "note": "2 numaralı çizgi referans: başlangıcı (A) tıklamaya yakın uç.", "expect": { "options": ["H"], "hover": null, "entities": 4 } },
    { "move": [-16, -4], "note": "Önizleme: dik, dik açı işareti, dik boy ve dik ayak; referans kenet renginde." },
    { "click": [-16, -4], "expect": { "entities": 5, "newest": { "kind": "line", "points": [[-16, -4], [-16, -12]] }, "log": "success", "tool": "perpIn" } },
    { "click": [-28, -6], "note": "Hattın uzantısına da dik inilir.", "expect": { "entities": 6, "newest": { "kind": "line", "points": [[-28, -6], [-28, -12]] } } },
    { "text": "486992,4419988" },
    { "key": "Enter", "note": "Hattın üstündeki noktadan dik olmaz.", "expect": { "entities": 6, "log": "warn" } },
    { "key": "Ctrl+Z", "note": "Aracın geri alacağı yok: çizim geri alınır.", "expect": { "entities": 5, "canRedo": true, "tool": "perpIn" } },
    { "key": "H", "note": "Başka hat.", "expect": { "options": [] } },
    { "click": [16, -4], "note": "Daire referans: dik merkeze doğru.", "expect": { "options": ["H"], "entities": 5 } },
    { "click": [24, -8], "expect": { "entities": 6, "newest": { "kind": "line", "points": [[24, -8], [20, -8]] } } },
    { "text": "487016,4419992" },
    { "key": "Enter", "note": "Dairenin merkezinden dik inilemez.", "expect": { "entities": 6, "log": "warn" } },
    { "key": "Enter", "note": "Enter araçtan çıkar.", "expect": { "tool": "select", "entities": 6 } },
    { "run": "tool.perpOut", "expect": { "tool": "perpOut", "options": [] } },
    { "click": [-22, -12], "expect": { "options": ["H"] } },
    { "text": "4" },
    { "key": "Enter", "note": "Dik ayak A ucundan 4 m.", "expect": { "options": ["H"], "entities": 6 } },
    { "text": "-3" },
    { "key": "Enter", "note": "Dik boy sola 3 m (sağa artı).", "expect": { "entities": 7, "newest": { "kind": "line", "points": [[-20, -12], [-20, -9]] }, "log": "success" } },
    { "move": [-14, -12], "note": "Önizleme: A'dan imlecin ayağına kalın çizgi ve dik ayak." },
    { "click": [-14, -12] },
    { "move": [-14, -16], "note": "Önizleme: dik, dik açı işareti, dik ayak ve dik boy (sağ)." },
    { "click": [-14, -16], "expect": { "entities": 8, "newest": { "kind": "line", "points": [[-14, -12], [-14, -16]] } } },
    { "key": "H" },
    { "click": [10, 4], "note": "Kilitli katmandaki kenar da referanstır; dik etkin katmana çizilir.", "expect": { "options": ["H"] } },
    { "text": "6" },
    { "key": "Enter" },
    { "text": "2" },
    { "key": "Enter", "expect": { "entities": 9, "newest": { "kind": "line", "points": [[10, 4], [10, 2]] } } },
    { "key": "Esc", "expect": { "tool": "select", "entities": 9 } }
  ]
