{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "corner-tools",
  "title": "Köşe yuvarla ve Pah: imleç altındaki köşe (çoklu çizginin köşesi, uç uca gelen iki çizgi), yazılan yarıçap, Enter ile son yarıçap; sırayla seçilen iki çizgi ve iki mesafeli pah; Kırp (K) kapalıyken yalnız pah çizgisi; tek adımda geri alma",
  "source": "Web'in EdgePickTool, CornerTool, FilletTool, ChamferTool ('tool.fillet', 'tool.chamfer') ve cad.entities.edit, ADR 0047",
  "covers": ["UX-01", "UX-07", "CMD-04", "CMD-07", "CAD-02"],
  "document": "edits.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "move": [-20, 0] },
    { "run": "tool.fillet", "note": "Kırp (K) tek seçenek; son yarıçap varsa istemde not olarak görünür.", "expect": { "tool": "fillet", "options": ["K"] } },
    { "move": [0.25, 4.25], "note": "Çoklu çizginin köşesi imlecin altında: halkayla gösterilir, vurgu kalkar.", "expect": { "hover": null } },
    { "click": [0.25, 4.25], "note": "Köşe seçildi; boyut fareyle çekilir ya da yazılır.", "expect": { "tool": "fillet", "points": 0 } },
    { "move": [0.25, 6] },
    { "text": "2", "expect": { "dynamicInput": "2" } },
    { "key": "Enter", "note": "Yazılan yarıçap hemen uygulanır: köşe yayla yuvarlanır, çoklu çizgi yerinde kalır.", "expect": { "log": "success", "entities": 13, "objects": [{ "id": 4, "kind": "polyline", "points": [[0, 14], [0, 6], [2, 4], [10, 4]], "arcs": 1 }] } },
    { "move": [14.25, 4.25], "note": "Uç uca gelen iki çizginin köşesi.", "expect": { "hover": null } },
    { "click": [14.25, 4.25] },
    { "key": "Enter", "note": "Enter son yarıçapı kullanır: çizgiler kısalır, yay yeni nesnedir.", "expect": { "log": "success", "entities": 14, "newest": { "kind": "arc", "points": [[14, 6], [16, 4]], "center": [16, 6], "radius": 2 }, "objects": [{ "id": 5, "kind": "line", "points": [[26, 4], [16, 4]] }, { "id": 6, "kind": "line", "points": [[14, 16], [14, 6]] }] } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "run": "tool.chamfer", "expect": { "tool": "chamfer", "options": ["K"] } },
    { "move": [3, -4], "expect": { "hover": 8 } },
    { "click": [3, -4], "note": "Köşe yok: tıklanan çizgi ilk çizgidir; sıra ikincisinde.", "expect": { "options": [] } },
    { "move": [8, -9] },
    { "click": [8, -9], "note": "İkinci çizgi: köşe kesişimleridir, her çizgi tıklandığı tarafı tutar." },
    { "move": [7, -6] },
    { "text": "1,2", "expect": { "dynamicInput": "1,2" } },
    { "key": "Enter", "note": "İki mesafe: ilk çizgide 1 m, ikincide 2 m.", "expect": { "log": "success", "entities": 15, "newest": { "kind": "line", "points": [[7, -4], [8, -6]] }, "objects": [{ "id": 8, "kind": "line", "points": [[0, -4], [7, -4]] }, { "id": 9, "kind": "line", "points": [[8, -12], [8, -6]] }] } },
    { "key": "K", "note": "Kırp: hayır. Kenarlar olduğu gibi kalır, yalnız pah çizgisi eklenir.", "expect": { "options": ["K"] } },
    { "move": [14.25, -13.75] },
    { "click": [14.25, -13.75], "note": "Kapalı alanın köşesi." },
    { "text": "1" },
    { "key": "Enter", "expect": { "log": "success", "entities": 16, "newest": { "kind": "line", "points": [[14, -13], [15, -14]] }, "objects": [{ "id": 10, "kind": "polygon", "points": [[14, -14], [24, -14], [24, -6], [14, -6]] }] } },
    { "key": "K", "note": "Kırp yine açık: araçların belleği başladığı gibi kalır." },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "key": "Ctrl+Z", "note": "Her köşe tek adımdır.", "expect": { "entities": 15 } },
    { "key": "Ctrl+Z", "expect": { "entities": 14, "objects": [{ "id": 8, "kind": "line", "points": [[0, -4], [8, -4]] }, { "id": 9, "kind": "line", "points": [[8, -4], [8, -12]] }] } }
  ]
}
