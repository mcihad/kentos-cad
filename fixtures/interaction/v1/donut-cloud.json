{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "donut-cloud",
  "title": "Halka ve Revizyon bulutu: her tıkta dolu halka, Dış çap (D) ve İç çap (İ) yazılır, iç çaptan küçük dış çap reddedilir, iç çap 0 dolu daire, Ctrl+Z; dikdörtgen bulut ve Yay boyu (U), Çokgen (Ç), üç köşesiz bulut uyarısı",
  "source": "Web'in DonutTool'u ve RevCloudTool'u (markupTools.ts); cad.entities.create ve cad.polygon.create, ADR 0057",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "empty.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.donut", "expect": { "tool": "donut", "points": 0, "options": ["İ", "D"], "entities": 0 } },
    { "move": [0, 0], "note": "Önizleme: imlecin altında dolgulu halka." },
    { "click": [0, 0], "note": "Her tık bir halka: dolu tarama, deliğiyle; ileti noktanın yankısıdır.", "expect": { "entities": 1, "newest": { "kind": "hatch" }, "points": 0, "log": "info", "tool": "donut" } },
    { "key": "D", "note": "Dış çap sorulur.", "expect": { "options": ["İ", "D"], "points": 0 } },
    { "click": [10, 0], "note": "Çap sorulurken tık halka koymaz.", "expect": { "entities": 1 } },
    { "text": "0.2" },
    { "key": "Enter", "note": "Dış çap iç çaptan büyük olmalı.", "expect": { "log": "warn", "entities": 1 } },
    { "text": "3" },
    { "key": "Enter", "expect": { "entities": 1 } },
    { "click": [10, 0], "expect": { "entities": 2, "newest": { "kind": "hatch" } } },
    { "key": "I", "note": "I, İ seçeneğini seçer: iç çap sorulur.", "expect": { "options": ["İ", "D"] } },
    { "text": "0" },
    { "key": "Enter" },
    { "click": [-10, 0], "note": "İç çap 0: dolu daire.", "expect": { "entities": 3, "newest": { "kind": "hatch" } } },
    { "key": "Ctrl+Z", "note": "En yeni halka geri alınır; araç sürer.", "expect": { "entities": 2, "canRedo": true, "tool": "donut" } },
    { "key": "I", "note": "Çaplar oturum boyunca kalır: iz onları başladığı gibi bırakır." },
    { "text": "0.5" },
    { "key": "Enter" },
    { "key": "D" },
    { "text": "1" },
    { "key": "Enter", "expect": { "options": ["İ", "D"], "entities": 2 } },
    { "key": "Enter", "note": "Halka nokta tutmaz: Enter araçtan çıkar.", "expect": { "tool": "select", "entities": 2 } },
    { "run": "tool.revcloud", "expect": { "tool": "revcloud", "points": 0, "options": ["Ç", "U"] } },
    { "key": "U", "note": "Yay boyu, kâğıt milimetresi.", "expect": { "options": [] } },
    { "text": "2" },
    { "key": "Enter", "expect": { "options": ["Ç", "U"] } },
    { "click": [-20, -14], "expect": { "points": 1, "options": [] } },
    { "move": [-10, -8], "note": "Önizleme: dikdörtgenin çevresinde dışa bombeli yaylar." },
    { "click": [-10, -8], "note": "1:1000'de 2 mm'lik yaylar: 10 m'lik kenarda 5, 6 m'likte 3.", "expect": { "entities": 3, "newest": { "kind": "polygon", "arcs": 16 }, "points": 0, "log": "success" } },
    { "key": "C", "note": "C, Ç seçeneğini seçer: çokgen bulut.", "expect": { "options": ["D", "U"] } },
    { "click": [0, -14] },
    { "click": [10, -14] },
    { "click": [10, -4], "expect": { "points": 3, "options": [] } },
    { "key": "Enter", "expect": { "entities": 4, "newest": { "kind": "polygon" }, "points": 0, "log": "success" } },
    { "click": [15, 0] },
    { "key": "Enter", "note": "Tek köşeden bulut olmaz.", "expect": { "entities": 4, "log": "warn", "points": 0 } },
    { "key": "D", "note": "Biçim ve yay boyu oturum boyunca kalır: iz onları başladığı gibi bırakır.", "expect": { "options": ["Ç", "U"] } },
    { "key": "U" },
    { "text": "8" },
    { "key": "Enter", "expect": { "options": ["Ç", "U"] } },
    { "key": "Enter", "expect": { "tool": "select", "entities": 4 } }
  ]
}
