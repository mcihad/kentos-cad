{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "arrays",
  "title": "Dizi ve Kutupsal dizi: Enter son satır ve sütun sayısını alır, aralık iki noktayla gösterilir (aynı nokta dikkate alınmaz); yazılan sayılar ve aralık; satır aralığı sıfırken komut reddeder, araç yeni aralık bekler; kilitli çizginin kopyası yapılmaz; kutupsal dizi yazılan merkez ve adetle döner, yarım turda nesneler dönmeden kopyalanır; her dizi tek adımda geri alınır",
  "source": "Web'in ArrayTool ('tool.array') ve PolarArrayTool ('tool.arrayPolar'), cad.entities.array, ADR 0047",
  "covers": ["UX-01", "UX-07", "CMD-04", "CMD-07"],
  "document": "objects.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": true, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "click": [-16, -12], "note": "1. çizgi seçilir.", "expect": { "tool": "select", "selected": [1] } },
    { "run": "tool.array", "expect": { "tool": "array", "options": [] } },
    { "key": "Enter", "note": "Son satır ve sütun sayısı: 2 × 3. Sıra aralıkta.", "expect": { "tool": "array", "entities": 7 } },
    { "move": [-24, -12], "expect": { "snap": "endpoint" } },
    { "click": [-24, -12], "note": "Aralığın ilk noktası." },
    { "click": [-24, -12], "note": "Aynı nokta: aralık yok, tık dikkate alınmaz.", "expect": { "tool": "array", "entities": 7 } },
    { "move": [-20, -8], "note": "Önizleme: kopyalar imlecin aralığıyla görünür.", "expect": { "tool": "array" } },
    { "click": [-20, -8], "note": "Sütunlar 4 m, satırlar 4 m arayla beş kopya; adım Dizi.", "expect": { "tool": "select", "entities": 12, "log": "success", "selected": [1], "newest": { "kind": "line", "points": [[-16, -8], [0, -8]] } } },
    { "key": "Ctrl+Z", "note": "Beş kopya tek adımda geri alınır.", "expect": { "entities": 7 } },
    { "run": "tool.array" },
    { "text": "3,1" },
    { "key": "Enter", "note": "3 satır, 1 sütun.", "expect": { "tool": "array" } },
    { "text": "5,0" },
    { "key": "Enter", "note": "Tek sütunda sütun aralığı önemsizdir ama satır aralığı sıfır: komut reddeder, araç yeni aralık bekler.", "expect": { "tool": "array", "entities": 7, "log": "warn" } },
    { "text": "0,6" },
    { "key": "Enter", "note": "Satırlar 6 m arayla iki kopya.", "expect": { "tool": "select", "entities": 9, "log": "success", "newest": { "kind": "line", "points": [[-24, 0], [-8, 0]] } } },
    { "key": "Ctrl+Z", "expect": { "entities": 7 } },
    { "click": [10, -16], "shift": true, "note": "Kilitli 6. çizgi de seçilir.", "expect": { "selected": [1, 6] } },
    { "run": "tool.array" },
    { "text": "2,3" },
    { "key": "Enter" },
    { "text": "10,10" },
    { "key": "Enter", "note": "Kilitli çizginin kopyası yapılmaz: 1. çizgiden beş kopya, uyarıyla. Son değerler izin başındaki gibi 2 × 3 ve 10, 10 olur.", "expect": { "tool": "select", "entities": 12, "log": "success", "newest": { "kind": "line", "points": [[-4, -2], [12, -2]] } } },
    { "key": "Ctrl+Z", "expect": { "entities": 7 } },
    { "click": [8, 10], "note": "3. çizgi seçilir.", "expect": { "selected": [3] } },
    { "run": "tool.arrayPolar", "expect": { "tool": "arrayPolar", "options": [] } },
    { "text": "487000,4420000" },
    { "key": "Enter", "note": "Merkez yazılır: (0, 0). Kopyalar görünür.", "expect": { "options": ["N", "A", "D"] } },
    { "key": "N", "expect": { "options": [] } },
    { "text": "1" },
    { "key": "Enter", "note": "Adet en az 2: uyarılır, adet yine sorulur.", "expect": { "log": "warn", "options": [] } },
    { "text": "4" },
    { "key": "Enter", "note": "Toplam 4 öğe.", "expect": { "options": ["N", "A", "D"] } },
    { "rightClick": [20, -16], "note": "Tam turda 90° arayla üç kopya, merkez etrafında dönerek; adım Kutupsal dizi.", "expect": { "tool": "select", "entities": 10, "log": "success", "newest": { "kind": "line", "points": [[16, 0], [4, -16]] } } },
    { "key": "Ctrl+Z", "expect": { "entities": 7 } },
    { "run": "tool.arrayPolar" },
    { "text": "487000,4420000" },
    { "key": "Enter" },
    { "key": "A", "expect": { "options": [] } },
    { "text": "180" },
    { "key": "Enter", "expect": { "options": ["N", "A", "D"] } },
    { "key": "D", "note": "Nesneler dönmez." },
    { "key": "N" },
    { "text": "3" },
    { "key": "Enter" },
    { "rightClick": [20, -16], "note": "180° içinde 3 öğe: kopyalar 90° ve 180°'de; yönleri kalır, kutularının ortası (8, 10) merkez etrafında döner.", "expect": { "tool": "select", "entities": 9, "log": "success", "newest": { "kind": "line", "points": [[-16, -4], [0, -16]] } } },
    { "key": "Ctrl+Z", "expect": { "entities": 7 } },
    { "run": "tool.arrayPolar" },
    { "text": "487000,4420000" },
    { "key": "Enter" },
    { "key": "N" },
    { "text": "6" },
    { "key": "Enter" },
    { "key": "A" },
    { "text": "360" },
    { "key": "Enter" },
    { "key": "D", "note": "Değerler izin başındaki gibi: 6 öğe, 360°, dönerek.", "expect": { "options": ["N", "A", "D"] } },
    { "key": "Esc", "note": "Çıkılır; hiçbir şey yazılmaz.", "expect": { "tool": "select", "entities": 7 } }
  ]
}
