{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "dimensions",
  "title": "Ölçülendirme: iki nokta ve yeriyle hizalı ölçü, çizimin geri alması; Düşey (X) kilidiyle yazılan mesafeli doğrusal ölçü, Yön (O), noktalar varken Enter; iki kenar arasında açı (boş yer ve paralel kenar uyarısı, kilitli katmandaki kenar da); dairenin yarıçapı, Ctrl+Z önce seçilen daireyi bırakır; Enter araçtan çıkar",
  "source": "Web'in DimensionTool'u (dimensionTool.ts, 26 Eylül düzeltmeleriyle); cad.entities.create, ADR 0061",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "tools.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.dimension", "expect": { "tool": "dimension", "points": 0, "options": ["D", "A", "R", "Ç"], "entities": 4 } },
    { "click": [-4, -20], "note": "Hizalı ölçünün ilk noktası; biçim artık değişmez.", "expect": { "points": 1, "options": [] } },
    { "click": [6, -20], "note": "İkinci nokta; ölçü çizgisinin yeri sorulur.", "expect": { "points": 2, "options": [] } },
    { "move": [1, -17], "note": "Ölçü imlecin geçtiği yerde önizlenir, değeri imlecin yanında." },
    { "click": [1, -17], "note": "Hizalı ölçü tek adımda (“Ekle”); araç sonraki ölçüyü bekler.", "expect": { "entities": 5, "newest": { "kind": "dimension", "points": [[-4, -20], [6, -20]] }, "log": "success", "points": 0, "options": ["D", "A", "R", "Ç"] } },
    { "key": "Ctrl+Z", "note": "Bekleyen seçim yok: çizimin geri alması ölçüyü kaldırır.", "expect": { "entities": 4, "canRedo": true, "tool": "dimension" } },
    { "key": "D", "note": "Doğrusal (ΔY / ΔX) ölçü.", "expect": { "options": ["H", "A", "R", "Ç"] } },
    { "click": [-4, -20], "expect": { "points": 1 } },
    { "click": [6, -15], "note": "Yatay, Düşey ve Yön seçenekleri.", "expect": { "points": 2, "options": ["Y", "X", "O"] } },
    { "key": "X", "note": "Düşey (ΔX): doğrultu kilitlenir.", "expect": { "options": ["Y", "X", "O"] } },
    { "move": [12, -18], "note": "Kilitli doğrultuda önizleme." },
    { "text": "3" },
    { "key": "Enter", "note": "Yazılan mesafe: ölçü çizgisi ölçülen doğrultunun 3 m solunda; değer ΔX, 5 m.", "expect": { "entities": 5, "newest": { "kind": "dimension", "points": [[-4, -20], [6, -15]] }, "log": "success", "points": 0 } },
    { "click": [-4, -20] },
    { "click": [6, -15], "expect": { "points": 2 } },
    { "key": "O", "note": "Yön yeniden imleçten.", "expect": { "options": ["Y", "X", "O"] } },
    { "key": "Enter", "note": "Noktalar varken Enter yeni ölçüye başlar.", "expect": { "points": 0, "tool": "dimension", "entities": 5, "options": ["H", "A", "R", "Ç"] } },
    { "key": "A", "note": "Açı ölçüsü, iki kenar arasında.", "expect": { "options": ["K", "H", "D", "R", "Ç"] } },
    { "click": [-14, -18], "note": "Boş yere tıklamak uyarır.", "expect": { "log": "warn", "entities": 5, "options": ["K", "H", "D", "R", "Ç"] } },
    { "click": [-10, 10], "note": "Birinci kenar: çizgi 1.", "expect": { "options": [] } },
    { "click": [-16, -12], "note": "Paralel kenar alınmaz.", "expect": { "log": "warn", "entities": 5 } },
    { "move": [24, 13], "note": "Kilitli katmandaki kenar da ölçülür; üzerine gelince vurgulanır.", "expect": { "hover": 4 } },
    { "click": [24, 14], "expect": { "hover": null } },
    { "move": [20, 12], "note": "Yay imlecin bulunduğu açıya çizilir." },
    { "click": [20, 12], "note": "Açı ölçüsü: köşe (24, 10), kollar tıklanan yerlere kadar.", "expect": { "entities": 6, "newest": { "kind": "dimension", "points": [[24, 14], [-10, 10], [24, 10]] }, "log": "success" } },
    { "key": "R", "note": "Yarıçap ölçüsü.", "expect": { "options": ["H", "D", "A", "Ç"] } },
    { "move": [20, -8], "note": "Daire vurgulanır.", "expect": { "hover": 3 } },
    { "click": [20, -8], "expect": { "hover": null, "options": [] } },
    { "key": "Ctrl+Z", "note": "Ctrl+Z önce seçilen daireyi bırakır; çizim değişmez.", "expect": { "entities": 6, "options": ["H", "D", "A", "Ç"] } },
    { "click": [20, -8] },
    { "move": [16, -1], "note": "Daireden dışarı çekince yazı dışarıda." },
    { "click": [16, -1], "note": "Yarıçap ölçüsü.", "expect": { "entities": 7, "newest": { "kind": "dimension", "points": [[16, -8], [16, -4]] }, "log": "success" } },
    { "key": "H", "note": "Hizalı ölçüye dönülür; araçların belleği sonraki çalıştırmaya kalır.", "expect": { "options": ["D", "A", "R", "Ç"] } },
    { "key": "Enter", "note": "Seçilen bir şey yokken Enter araçtan çıkar.", "expect": { "tool": "select", "entities": 7 } }
  ]
}
