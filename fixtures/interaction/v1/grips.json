{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "grips",
  "title": "Tutamaçlar: seçili çizginin ucunu sürükleyerek taşıma ve tek adımda geri alma; tıklanan tutamaç sıcak kalır, sonraki tık yerleştirir; Esc tutamağı bırakır, Enter imlecin olduğu yere koyar; kapalı alanın kenar ortası yeni köşe olur; kilitli katmandaki nesnenin tutamağı alınmaz",
  "source": "Web'in SelectTool'u (SelectTool.ts: grip, gripAt; model/ops/grips.ts), ADR 0068",
  "covers": ["UX-01", "UX-09"],
  "document": "objects.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "click": [-16, -12], "note": "Çizgi 1 seçilir; uçlarında tutamaçlar görünür.", "expect": { "tool": "select", "selected": [1] } },
    { "drag": [[-8, -12], [-8, -6]], "note": "Uç tutamağını sürüklemek ucu taşır; seçim kalır.", "expect": { "tool": "select", "selected": [1], "canUndo": true, "objects": [{ "id": 1, "kind": "line", "points": [[-24, -12], [-8, -6]] }] } },
    { "key": "Ctrl+Z", "note": "Tek adım: “Tutamaçla düzenle”.", "expect": { "objects": [{ "id": 1, "kind": "line", "points": [[-24, -12], [-8, -12]] }] } },
    { "click": [-24, -12], "note": "Sürüklenmeden tıklanan tutamaç sıcak kalır; çizgi değişmez.", "expect": { "tool": "select", "selected": [1], "objects": [{ "id": 1, "kind": "line", "points": [[-24, -12], [-8, -12]] }] } },
    { "move": [-24, -4] },
    { "click": [-24, -4], "note": "Sonraki tık onu yerleştirir.", "expect": { "objects": [{ "id": 1, "kind": "line", "points": [[-24, -4], [-8, -12]] }] } },
    { "click": [-8, -12], "note": "Öbür uç sıcak." },
    { "move": [0, 0] },
    { "key": "Esc", "note": "Esc tutamağı bırakır; çizgi ve seçim yerinde.", "expect": { "selected": [1], "objects": [{ "id": 1, "kind": "line", "points": [[-24, -4], [-8, -12]] }] } },
    { "click": [-8, -12] },
    { "move": [-8, -8] },
    { "key": "Enter", "note": "Enter tutamağı imlecin olduğu yere koyar.", "expect": { "selected": [1], "objects": [{ "id": 1, "kind": "line", "points": [[-24, -4], [-8, -8]] }] } },
    { "click": [-18, 14], "note": "Kapalı alan 4 kenarından seçilir.", "expect": { "selected": [4] } },
    { "drag": [[-18, 4], [-18, 0]], "note": "Alt kenarın orta tutamağı yeni köşe olur.", "expect": { "selected": [4], "objects": [{ "id": 4, "kind": "polygon", "points": [[-24, 4], [-18, 0], [-12, 4], [-12, 14], [-24, 14]] }] } },
    { "click": [10, -16], "note": "Kilitli katmandaki çizgi 6 seçilir…", "expect": { "selected": [6] } },
    { "drag": [[4, -16], [7, -10]], "note": "…ama tutamağı alınmaz: sürükleme seçim kutusudur, içinde nesne yok.", "expect": { "selected": [], "objects": [{ "id": 6, "kind": "line", "points": [[4, -16], [16, -16]] }] } }
  ]
}
