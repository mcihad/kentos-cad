{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "wall-edit",
  "title": "Duvar düzenle: bir duvar çizilir; Duvarı böl ona tıklanan yerde ikiye böler (ikinci parça yeni duvar); Duvarları birleştir iki parçaya tıklanınca Enter ile onları tek duvar yapar, ortadaki köşe kalır; geri alınınca iki parça döner; her yazma cad.walls.edit ile",
  "source": "docs/adr/0340 §4, §6 (Duvarı böl, Duvarları birleştir; komutla yazma)",
  "covers": ["CAD-ARCH-10"],
  "document": "empty.kcad",
  "view": {"center": [487000, 4420000], "metresPerPixel": 0.02},
  "draft": {"snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false},
  "prefs": {"cursorInput": true},
  "clickTolerance": 0.05,
  "steps": [
    {"run": "tool.wall", "expect": {"tool": "wall"}},
    {"click": [0, 0]},
    {"click": [6, 0]},
    {"key": "Enter", "note": "İki köşeli duvar yazılır.", "expect": {"newest": {"kind": "wall", "points": [[0, 0], [6, 0]]}}},
    {"key": "Esc"},
    {"key": "Esc", "expect": {"tool": "select"}},
    {"run": "tool.wallSplit", "expect": {"tool": "wallSplit"}},
    {"click": [2, 0], "note": "Duvar tıklanan yerde bölünür: ikinci parça yeni duvar.", "expect": {"newest": {"kind": "wall", "points": [[2, 0], [6, 0]]}}},
    {"key": "Esc", "expect": {"tool": "select"}},
    {"run": "tool.wallJoin", "expect": {"tool": "wallJoin"}},
    {"click": [1, 0]},
    {"click": [4, 0], "expect": {"points": 2}},
    {"key": "Enter", "note": "İki parça tek duvar olur; ilkinin kimliği kalır.", "expect": {"newest": {"kind": "wall", "points": [[0, 0], [2, 0], [6, 0]]}}},
    {"key": "Ctrl+Z", "note": "Tek geri alma iki parçayı geri getirir.", "expect": {"newest": {"kind": "wall", "points": [[2, 0], [6, 0]]}}},
    {"key": "Esc", "expect": {"tool": "select"}}
  ]
}
