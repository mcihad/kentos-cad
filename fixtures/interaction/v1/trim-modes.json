{
 "format": "kentos.interaction-trace",
 "version": 1,
 "id": "trim-modes",
 "title": "Buda'da AutoCAD'in seçenekleri: Uzantılar (U) sınırın doğrusuyla keser; hızlı kipte hiçbir sınırın kesmediği çizgi silinir; boş yere tıklama Kesişen penceresinin ilk köşesidir, pencereye değen parça gider; Sil (R) tıklananı siler; her biri tek adım",
 "source": "docs/adr/0294 (cad.entities.trim: edgeMode, eraseUncut, crossing; cad.entities.delete)",
 "covers": ["CAD-EDIT-08"],
 "document": "edits.kcad",
 "view": {"center": [487000, 4420000], "metresPerPixel": 0.125},
 "draft": {"snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false},
 "prefs": {"cursorInput": true},
 "clickTolerance": 0.125,
 "steps": [
  {"move": [-30, 0]},
  {"run": "tool.trim", "note": "Seçenekler: Sınır seç, Kesişen, Uzantılar, Sil.", "expect": {"tool": "trim", "options": ["S", "K", "U", "R"]}},
  {"key": "U", "note": "Uzantılar açılır: sınırlar uçlarının ötesinde de keser.", "expect": {"log": "info", "options": ["S", "K", "U", "R"]}},
  {"move": [-24, -12], "expect": {"hover": 11}},
  {"shot": "uzantilar-onizleme"},
  {"click": [-24, -12], "note": "2'nin doğrusu (x = −20) 11'i keser: uçla arası gider.", "expect": {"log": "success", "entities": 13, "objects": [{"id": 11, "kind": "line", "points": [[-20, -12], [-18, -12]]}]}},
  {"key": "Ctrl+Z", "expect": {"objects": [{"id": 11, "kind": "line", "points": [[-28, -12], [-18, -12]]}]}},
  {"key": "U", "note": "Uzantılar kapanır.", "expect": {"log": "info"}},
  {"move": [-24, -12]},
  {"click": [-24, -12], "note": "Hızlı kip: 11'i hiçbir sınır kesmiyor, bütünüyle silinir.", "expect": {"log": "success", "entities": 12}},
  {"key": "Ctrl+Z", "expect": {"entities": 13, "objects": [{"id": 11, "kind": "line", "points": [[-28, -12], [-18, -12]]}]}},
  {"move": [-24, 15]},
  {"click": [-24, 15], "note": "Boş yere tıklama Kesişen penceresinin ilk köşesidir.", "expect": {"tool": "trim", "options": ["K"]}},
  {"move": [-22, 10]},
  {"shot": "kesisen-onizleme"},
  {"click": [-22, 10], "note": "Pencereye değen parça (2'ye kadar) gider; tıklamaya dönülür.", "expect": {"log": "success", "entities": 13, "options": ["S", "K", "U", "R"], "objects": [{"id": 1, "kind": "line", "points": [[-20, 12], [-8, 12]]}]}},
  {"key": "K", "note": "Kesişen tuşla da açılır; iki köşe yazılabilir de.", "expect": {"options": ["K"]}},
  {"key": "Esc", "note": "Esc pencereyi bırakır, araç kalır.", "expect": {"tool": "trim", "options": ["S", "K", "U", "R"]}},
  {"key": "R", "note": "Sil: tıklananlar silinir.", "expect": {"options": ["R"]}},
  {"move": [20, 4]},
  {"click": [20, 4], "expect": {"log": "success", "entities": 12}},
  {"key": "R", "expect": {"options": ["S", "K", "U", "R"]}},
  {"key": "Ctrl+Z", "expect": {"entities": 13}},
  {"key": "Ctrl+Z", "expect": {"objects": [{"id": 1, "kind": "line", "points": [[-28, 12], [-8, 12]]}]}},
  {"key": "Esc", "expect": {"tool": "select"}}
 ]
}
