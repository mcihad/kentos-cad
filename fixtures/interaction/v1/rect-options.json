{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "rect-options",
  "title": "Dikdörtgen aracı: iki köşe; köşe yuvarlama; döndürme ve boyutlar; pah; döndürülmüş dikdörtgen (yazılan genişlik); düzgün çokgen (yazılan kenar sayısı); Ctrl+Z",
  "source": "Web'in RectangleTool, RotatedRectangleTool ve RegularPolygonTool'u (shapeTools.ts) ve cad.polygon.create, ADR 0032",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "empty.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.rectangle", "expect": { "tool": "rectangle", "points": 0, "options": ["Y", "P"] } },
    { "click": [-28, 8], "expect": { "points": 1, "options": ["D", "B"] } },
    { "click": [-18, 16], "expect": { "entities": 1, "newest": { "kind": "polygon", "points": [[-28, 8], [-18, 8], [-18, 16], [-28, 16]], "arcs": 0 }, "log": "success", "points": 0 } },
    { "key": "Y", "expect": { "options": [], "points": 0 } },
    { "text": "2" },
    { "key": "Enter", "note": "Köşe yarıçapı sonraki dikdörtgenler için de kalır.", "expect": { "options": ["Y", "P"] } },
    { "click": [-14, 8] },
    { "click": [-2, 16], "note": "Her köşe 2 m yarıçaplı çeyrek yay: köşe başına iki teğet noktası.", "expect": { "entities": 2, "newest": { "kind": "polygon", "points": [[-14, 10], [-12, 8], [-4, 8], [-2, 10], [-2, 14], [-4, 16], [-12, 16], [-14, 14]], "arcs": 4 } } },
    { "key": "Y" },
    { "text": "0" },
    { "key": "Enter", "note": "0: keskin köşe." },
    { "click": [4, 6] },
    { "key": "D", "expect": { "options": [] } },
    { "text": "30" },
    { "key": "Enter", "expect": { "options": ["D", "B"] } },
    { "key": "B", "expect": { "options": [] } },
    { "text": "10,5" },
    { "key": "Enter", "expect": { "options": [], "points": 1 } },
    { "move": [4, 14], "note": "Önizleme: 30° dönük 10 × 5 dikdörtgen, alanıyla." },
    { "click": [4, 14], "note": "30° dönük, 10 × 5, tıklanan yana açılır.", "expect": { "entities": 3, "newest": { "kind": "polygon", "points": [[4, 6], [12.660254, 11], [10.160254, 15.330127], [1.5, 10.330127]], "arcs": 0 } } },
    { "key": "P" },
    { "text": "1" },
    { "key": "Enter" },
    { "click": [16, 6] },
    { "key": "D" },
    { "text": "0" },
    { "key": "Enter", "note": "Döndürme de kalır: sıfıra döner." },
    { "click": [26, 14], "note": "1 m pahlı köşeler: köşe başına iki kesim noktası, yay yok.", "expect": { "entities": 4, "newest": { "kind": "polygon", "points": [[16, 7], [17, 6], [25, 6], [26, 7], [26, 13], [25, 14], [17, 14], [16, 13]], "arcs": 0 } } },
    { "key": "Y", "note": "İz, aracın hatırladıklarını başladığı gibi bırakır: keskin köşe, dönme 0°." },
    { "text": "0" },
    { "key": "Enter", "expect": { "options": ["Y", "P"], "points": 0 } },
    { "run": "tool.rectangle3", "expect": { "tool": "rectangle3", "options": [] } },
    { "click": [-28, -8] },
    { "click": [-18, -8], "expect": { "points": 2 } },
    { "move": [-23, -11] },
    { "text": "4" },
    { "key": "Enter", "note": "Yazılan genişlik imlecin olduğu yana gider.", "expect": { "entities": 5, "newest": { "kind": "polygon", "points": [[-28, -8], [-18, -8], [-18, -12], [-28, -12]] }, "log": "success" } },
    { "run": "tool.regularPolygon", "expect": { "tool": "regularPolygon", "options": ["S", "Ç", "K"] } },
    { "text": "4" },
    { "key": "Enter", "note": "İlk noktadan önce yazılan sayı kenar sayısıdır.", "expect": { "points": 0, "entities": 5 } },
    { "click": [-5, -10] },
    { "move": [0, -10], "note": "Önizleme: köşelerden geçen çember ve dört kenarlı çokgen." },
    { "click": [0, -10], "note": "Merkezden bir köşe: çember köşelerden geçer.", "expect": { "entities": 6, "newest": { "kind": "polygon", "points": [[0, -10], [-5, -5], [-10, -10], [-5, -15]] }, "log": "success" } },
    { "key": "Ctrl+Z", "expect": { "entities": 5, "tool": "regularPolygon", "canRedo": true } },
    { "text": "6", "note": "Kenar sayısı da başladığı gibi kalır." },
    { "key": "Enter", "expect": { "points": 0, "entities": 5 } },
    { "key": "Esc", "expect": { "tool": "select" } }
  ]
}
