{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "edge-tools",
  "title": "Buda, Uzat ve Ötele: görünen kenarlarla budama, Shift ile öbür işlem, Sınır seç (S) ve Tüm kenarlar (T), kilitli çizgi düzenlenmez, her işlem tek adımda geri alınır; yazılan mesafeyle ve Noktadan geç (N) ile öteleme",
  "source": "Web'in EdgePickTool, BoundaryEdgeTool, TrimTool, ExtendTool, OffsetTool ('tool.trim', 'tool.extend', 'tool.offset') ve cad.entities.edit, ADR 0047",
  "covers": ["UX-01", "UX-07", "CMD-04", "CMD-07", "CAD-02"],
  "document": "edits.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "move": [-20, 0] },
    { "run": "tool.trim", "note": "Sınır: görünen bütün kenarlar; Sınır seç (S) tek seçenek.", "expect": { "tool": "trim", "options": ["S"] } },
    { "move": [-26, 12], "note": "Kenarıyla seçilecek çizgi vurgulanır; önizleme silinecek kısmı gösterir.", "expect": { "hover": 1 } },
    { "click": [-26, 12], "note": "1 ile 2'nin kesiştiği yere kadar olan kısım gider; kalan parça çizginin kendisidir.", "expect": { "entities": 13, "log": "success", "canUndo": true, "objects": [{ "id": 1, "kind": "line", "points": [[-20, 12], [-8, 12]] }] } },
    { "click": [-9, 12], "shift": true, "note": "Shift+tık öbür işlemi yapar: uç, görünen ilk kenara (3) kadar uzar.", "expect": { "log": "success", "objects": [{ "id": 1, "kind": "line", "points": [[-20, 12], [-4, 12]] }] } },
    { "key": "Ctrl+Z", "note": "Her işlem tek adımdır.", "expect": { "objects": [{ "id": 1, "kind": "line", "points": [[-20, 12], [-8, 12]] }] } },
    { "key": "Ctrl+Z", "expect": { "canUndo": false, "objects": [{ "id": 1, "kind": "line", "points": [[-28, 12], [-8, 12]] }] } },
    { "click": [5, -18], "note": "Kilitli katmandaki çizgi düzenlenecek bir kenar değildir.", "expect": { "log": "warn", "entities": 13, "canUndo": false } },
    { "key": "S", "note": "Sınır seç: tıklamalar sınırları seçer.", "expect": { "tool": "trim", "options": ["T"] } },
    { "click": [-4, 10], "expect": { "selected": [3] } },
    { "rightClick": [20, -10], "note": "Sağ tık sınırları alır; seçim olarak vurgulu kalırlar.", "expect": { "tool": "trim", "options": ["T", "S"], "selected": [3] } },
    { "click": [-26, 12], "note": "Seçilen sınır 1'i kesmiyor: budanacak kısım yok.", "expect": { "log": "warn", "objects": [{ "id": 1, "kind": "line", "points": [[-28, 12], [-8, 12]] }] } },
    { "click": [-9, 12], "shift": true, "note": "Uzatma da seçilen sınırlaradır.", "expect": { "log": "success", "objects": [{ "id": 1, "kind": "line", "points": [[-28, 12], [-4, 12]] }] } },
    { "key": "T", "note": "Tüm kenarlar: seçim kalkar.", "expect": { "options": ["S"], "selected": [] } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "run": "tool.extend", "expect": { "tool": "extend", "options": ["S"] } },
    { "move": [-20, 7] },
    { "click": [-20, 7], "note": "2'nin alt ucu, aşağıda rastladığı ilk kenara (7) kadar uzar.", "expect": { "log": "success", "objects": [{ "id": 2, "kind": "line", "points": [[-20, -4], [-20, 18]] }] } },
    { "move": [-24, 12] },
    { "click": [-24, 12], "shift": true, "note": "Uzat'ta Shift+tık budar.", "expect": { "log": "success", "entities": 13, "objects": [{ "id": 1, "kind": "line", "points": [[-20, 12], [-4, 12]] }] } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "key": "Ctrl+Z", "expect": { "objects": [{ "id": 1, "kind": "line", "points": [[-28, 12], [-4, 12]] }] } },
    { "key": "Ctrl+Z", "expect": { "objects": [{ "id": 2, "kind": "line", "points": [[-20, 6], [-20, 18]] }] } },
    { "key": "Ctrl+Z", "expect": { "canUndo": false, "objects": [{ "id": 1, "kind": "line", "points": [[-28, 12], [-8, 12]] }] } },
    { "run": "tool.offset", "note": "Ötele: mesafe istemde; Noktadan geç (N) tek seçenek.", "expect": { "tool": "offset", "options": ["N"] } },
    { "move": [-20, 0] },
    { "text": "2", "expect": { "dynamicInput": "2" } },
    { "key": "Enter", "note": "Yazılan sayı mesafedir.", "expect": { "dynamicInput": null, "tool": "offset" } },
    { "move": [-20, 9], "expect": { "hover": 2 } },
    { "click": [-20, 9], "expect": { "options": ["N"], "hover": null } },
    { "move": [-23, 9] },
    { "click": [-23, 9], "note": "Kopya tıklanan tarafa, 2 m uzağa; ondan yeni bir nesnedir.", "expect": { "entities": 14, "log": "success", "newest": { "kind": "line", "points": [[-22, 6], [-22, 18]] } } },
    { "key": "N", "note": "Noktadan geç: kopya tıklanan noktadan geçer.", "expect": { "options": ["N"] } },
    { "click": [-20, 9] },
    { "move": [-17, 9] },
    { "click": [-17, 9], "expect": { "entities": 15, "newest": { "kind": "line", "points": [[-17, 6], [-17, 18]] } } },
    { "move": [-20, 0] },
    { "text": "1" },
    { "key": "Enter", "note": "Mesafe yine 1 m, Noktadan geç kapalı: araçların belleği başladığı gibi kalır.", "expect": { "tool": "offset" } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "key": "Ctrl+Z", "note": "Her kopya kendi adımıdır.", "expect": { "entities": 14 } }
  ]
}
