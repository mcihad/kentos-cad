{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "spot-divide",
  "title": "Kot noktası ve Böl: tıklanan yere yazılan kotla nokta (kot katmanına), kot beklenirken tık bekler, Ctrl+Z; çizgiyi yazılan parça sayısıyla bölme, tek adımda geri alma, Aralık (A) ile uçtan ölçülen noktalar, kilitli katmandaki nesne de bölünür, geçersiz parça sayısı, Esc",
  "source": "Web'in PointTool'u (askZ, drawTools.ts), DivideTool'u (pathEditTools.ts); cad.point.create ve cad.entities.create, ADR 0057",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "tools.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.spot", "expect": { "tool": "spot", "points": 0, "options": [], "entities": 4 } },
    { "click": [-4, -4], "note": "Nokta tıklandı; kot sorulur (imleç yanında “Kot?”).", "expect": { "points": 0, "entities": 4, "log": "info" } },
    { "click": [4, -4], "note": "Kot beklenirken tık bekler.", "expect": { "entities": 4 } },
    { "text": "12.5" },
    { "key": "Enter", "note": "Kot noktası kot katmanına, kotu ve yazısıyla.", "expect": { "entities": 5, "newest": { "kind": "point", "points": [[-4, -4]] }, "points": 0, "tool": "spot" } },
    { "key": "Ctrl+Z", "note": "En yeni kot noktası geri alınır.", "expect": { "entities": 4, "canRedo": true, "tool": "spot" } },
    { "key": "Enter", "note": "Nokta tutulmaz: Enter araçtan çıkar.", "expect": { "tool": "select", "entities": 4 } },
    { "run": "tool.divide", "expect": { "tool": "divide", "points": 0, "options": ["A"] } },
    { "move": [-18, 10], "note": "Bölünecek nesnenin kenarı vurgulanır.", "expect": { "hover": 1 } },
    { "click": [-18, 10], "note": "Ölçme tıklamaya yakın uçtan başlar; konacak noktalar görünür.", "expect": { "options": ["A"], "hover": null, "entities": 4 } },
    { "text": "4" },
    { "key": "Enter", "note": "Dört parça: üç nokta, tek adım “Böl”.", "expect": { "entities": 7, "newest": { "kind": "point", "points": [[-5, 10]] }, "log": "success", "tool": "divide" } },
    { "key": "Ctrl+Z", "note": "Üç nokta tek adımda geri alınır.", "expect": { "entities": 4, "canRedo": true } },
    { "key": "A", "note": "Aralıkla bölme.", "expect": { "options": ["P"] } },
    { "click": [24, 10], "note": "Kilitli katmandaki çoklu çizgi de bölünür (noktalar etkin katmana); tıklama uca yakın.", "expect": { "options": ["P"], "entities": 4 } },
    { "text": "10" },
    { "key": "Enter", "note": "Uçtan 10 m arayla üç nokta.", "expect": { "entities": 7, "newest": { "kind": "point", "points": [[6, 4]] }, "log": "success" } },
    { "key": "P", "note": "Parça sayısına dönülür: kip oturum boyunca kalır, iz onu başladığı gibi bırakır.", "expect": { "options": ["A"] } },
    { "click": [-18, 10] },
    { "text": "1" },
    { "key": "Enter", "note": "Parça sayısı 2 ile 10 000 arasında bir tam sayı olmalı; nesne seçili kalır.", "expect": { "log": "warn", "entities": 7, "options": ["A"] } },
    { "key": "Esc", "note": "Esc seçilen nesneyi bırakır; araç sürer.", "expect": { "tool": "divide", "entities": 7 } },
    { "key": "Esc", "expect": { "tool": "select", "entities": 7 } }
  ]
}
