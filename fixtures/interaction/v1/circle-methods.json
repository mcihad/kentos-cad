{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "circle-methods",
  "title": "Daire aracı: merkez ve yarıçap (tıklanan, yazılan, Çap ile yazılan çap), 2N, 3N, iki nesneye teğet ve yarıçaplı (yazılan, sonra Enter ile son yarıçap), üç nesneye teğet; Ctrl+Z",
  "source": "Web'in CircleTool'u (curveTools.ts) ve cad.circle.create, ADR 0032",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "objects.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.circle", "expect": { "tool": "circle", "points": 0, "options": ["2N", "3N", "TTY", "TTT"], "entities": 7 } },
    { "click": [10, -4], "expect": { "points": 1, "options": ["Ç"] } },
    { "click": [13, 0], "note": "Merkezden 5 m.", "expect": { "entities": 8, "newest": { "kind": "circle", "center": [10, -4], "radius": 5 }, "points": 0, "log": "success" } },
    { "click": [-4, -8] },
    { "key": "C", "note": "C, Ç seçeneğini seçer: ikinci değer çaptır.", "expect": { "options": ["R"], "points": 1 } },
    { "text": "6" },
    { "key": "Enter", "expect": { "entities": 9, "newest": { "kind": "circle", "center": [-4, -8], "radius": 3 }, "log": "success" } },
    { "click": [22, 8], "note": "Çap seçimi sonraki daire için de kalır.", "expect": { "options": ["R"] } },
    { "key": "R", "expect": { "options": ["Ç"] } },
    { "text": "2" },
    { "key": "Enter", "expect": { "entities": 10, "newest": { "kind": "circle", "center": [22, 8], "radius": 2 } } },
    { "text": "2N", "note": "Rakamla başlayan seçenek değer alanında yazılır; harf Shift'siz gelir, araç büyük harfle okur.", "expect": { "dynamicInput": "2n" } },
    { "key": "Enter", "expect": { "options": [], "points": 0, "dynamicInput": null } },
    { "click": [-20, -4] },
    { "click": [-12, -4], "note": "Çapın iki ucu.", "expect": { "entities": 11, "newest": { "kind": "circle", "center": [-16, -4], "radius": 4 } } },
    { "text": "3N" },
    { "key": "Enter", "note": "Yöntem ilk noktadan önce değişir.", "expect": { "options": [], "points": 0 } },
    { "click": [18, 0] },
    { "click": [22, 0] },
    { "click": [20, 2], "expect": { "entities": 12, "newest": { "kind": "circle", "center": [20, 0], "radius": 2 } } },
    { "focus": "commandLine" },
    { "text": "TTY" },
    { "key": "Enter", "note": "Teğet-teğet-yarıçap: nesneler seçilir, kenet yok.", "expect": { "options": [], "points": 0, "tool": "circle", "entities": 12 } },
    { "click": [-16, -12], "note": "1 numaralı çizgi.", "expect": { "points": 0 } },
    { "click": [-12, 8], "note": "Kapalı alanın doğu kenarı.", "expect": { "points": 0, "entities": 12 } },
    { "text": "2" },
    { "key": "Enter", "expect": { "entities": 13, "newest": { "kind": "circle", "center": [-14, -10], "radius": 2 }, "log": "success" } },
    { "click": [-16, -12] },
    { "click": [-12, 8] },
    { "key": "Enter", "note": "Yarıçap yazılmazsa Enter son dairenin yarıçapını alır.", "expect": { "entities": 14, "newest": { "kind": "circle", "center": [-14, -10], "radius": 2 } } },
    { "focus": "commandLine" },
    { "text": "TTT" },
    { "key": "Enter", "expect": { "options": [], "tool": "circle" } },
    { "click": [-16, -12] },
    { "click": [-24, 8], "note": "Kapalı alanın batı kenarı." },
    { "click": [-12, 8], "note": "Üç nesneye teğet: iki paralel kenar arasında, çizginin üstünde.", "expect": { "entities": 15, "newest": { "kind": "circle", "center": [-18, -6], "radius": 6 }, "log": "success" } },
    { "key": "Ctrl+Z", "expect": { "entities": 14, "tool": "circle", "canRedo": true } },
    { "key": "Esc", "expect": { "tool": "select", "entities": 14 } }
  ]
}
