{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "rotate-scale",
  "title": "Döndür ve Ölçekle: kenetlenen merkez, Kopya (K) ile yazılan 90° döndürme; kenetlenen referans uzunluğu (R) ve yazılan yeni uzunlukla ölçekleme; yazılan faktörle ölçekleme ve tek adımda geri alma",
  "source": "Web'in RotateTool ('tool.rotate'), ScaleTool ('tool.scale') ve cad.entities.transform kuralları, ADR 0037",
  "covers": ["UX-01", "UX-07", "CMD-04", "CMD-07"],
  "document": "objects.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": true, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "click": [12, 10], "note": "Komut yokken tıklama seçer.", "expect": { "tool": "select", "selected": [2] } },
    { "run": "tool.rotate", "note": "Seçim varken dönme merkezi sorulur.", "expect": { "tool": "rotate", "options": [] } },
    { "move": [0.375, 4], "expect": { "snap": "endpoint" } },
    { "click": [0.375, 4], "note": "Merkez çizginin ucuna kenetlenir.", "expect": { "options": ["R", "K"] } },
    { "key": "K", "note": "Kopya açılır: asıl yerinde kalacak.", "expect": { "options": ["R", "K"], "entities": 7 } },
    { "text": "90" },
    { "key": "Enter", "note": "Saat yönünün tersine 90°: döndürülmüş kopya eklenir, asıl yerinde kalır, araç biter.", "expect": { "tool": "select", "entities": 8, "log": "success", "newest": { "kind": "line", "points": [[0, 4], [-12, 28]] }, "objects": [{ "id": 2, "kind": "line", "points": [[0, 4], [24, 16]] }] } },
    { "click": [-16, -12], "expect": { "selected": [1] } },
    { "run": "tool.scale", "expect": { "tool": "scale", "options": [] } },
    { "move": [-23.625, -12], "expect": { "snap": "endpoint" } },
    { "click": [-23.625, -12], "note": "Temel nokta çizginin ucuna kenetlenir.", "expect": { "options": ["R", "K"] } },
    { "key": "R", "note": "Referans: önce referans uzunluğu gösterilir.", "expect": { "options": [] } },
    { "click": [-23.625, -12], "expect": { "options": [] } },
    { "move": [-8.375, -12], "expect": { "snap": "endpoint" } },
    { "click": [-8.375, -12], "note": "Referans uzunluk 16 m: çizginin kendisi.", "expect": { "options": ["K"] } },
    { "text": "8" },
    { "key": "Enter", "note": "Yeni uzunluk 8 m: faktör 0,5.", "expect": { "tool": "select", "log": "success", "entities": 8, "objects": [{ "id": 1, "kind": "line", "points": [[-24, -12], [-16, -12]] }] } },
    { "click": [-18, 14], "expect": { "selected": [4] } },
    { "run": "tool.scale" },
    { "move": [-23.625, 4], "expect": { "snap": "endpoint" } },
    { "click": [-23.625, 4] },
    { "text": "2" },
    { "key": "Enter", "note": "Yazılan faktör: köşeden iki katına.", "expect": { "tool": "select", "objects": [{ "id": 4, "kind": "polygon", "points": [[-24, 4], [0, 4], [0, 24], [-24, 24]] }] } },
    { "key": "Ctrl+Z", "note": "Ölçekleme tek adımda geri alınır.", "expect": { "objects": [{ "id": 4, "kind": "polygon", "points": [[-24, 4], [-12, 4], [-12, 14], [-24, 14]] }] } }
  ]
}
