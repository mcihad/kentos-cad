{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "time-version",
  "title": "Yeni sürüm oluştur ve Sona erdir: sürgü 2020'deyken 102'nin yeni sürümü 01.01.2020'de başlar (102 o gün biter), kopya seçilir, tek adımda geri alınır; 103 yazılan 15.06.2019'da sona erer; zamansal olmayan yol ve tarihi kapsamayan 2011 reddedilir",
  "source": "docs/adr/0210",
  "covers": ["GIS-12"],
  "document": "temporal.kcad",
  "view": {"center": [487050, 4420025], "metresPerPixel": 0.25},
  "clickTolerance": 0.5,
  "steps": [
    {"run": "time.slider", "expect": {"time": {"label": "01.01.2024", "position": 14, "last": 14}}},
    {"timebar": "Geri"},
    {"timebar": "Geri"},
    {"timebar": "Geri"},
    {"timebar": "Geri", "expect": {"time": {"label": "01.01.2020", "position": 10, "last": 14}}},
    {"click": [5, 0], "expect": {"selected": [4]}},
    {"run": "tool.timeVersion", "expect": {"tool": "timeVersion", "prompt": "Yeni sürüm oluştur: tarih 01.01.2020: Enter yazar, başka bir tarih yazılabilir"}},
    {"key": "Enter", "expect": {"entities": 15, "selected": [15], "canUndo": true, "logged": ["Yeni sürüm: 1 nesne 01.01.2020 tarihinde sona erdi, 1 yeni sürümü yazıldı ve seçildi."], "newest": {"kind": "polygon", "attrs": {"parsel_no": "102", "gecerlilik_baslangic": "2020-01-01"}}, "objects": [{"id": 4, "kind": "polygon", "attrs": {"parsel_no": "102", "gecerlilik_baslangic": "2012-01-01", "gecerlilik_bitis": "2020-01-01"}}]}},
    {"key": "Esc", "expect": {"tool": "select"}},
    {"key": "Ctrl+Z", "note": "iki komut tek adımda: “Yeni sürüm”", "expect": {"entities": 14, "objects": [{"id": 4, "kind": "polygon", "attrs": {"parsel_no": "102", "gecerlilik_baslangic": "2012-01-01"}}]}},
    {"click": [35, 0], "expect": {"selected": [5]}},
    {"run": "tool.timeEnd", "expect": {"tool": "timeEnd", "prompt": "Sona erdir: tarih 01.01.2020: Enter yazar, başka bir tarih yazılabilir"}},
    {"text": "15.06.2019"},
    {"key": "Enter", "expect": {"entities": 14, "logged": ["Sona erdi: 1 nesne, 15.06.2019."], "objects": [{"id": 5, "kind": "polygon", "attrs": {"parsel_no": "103", "gecerlilik_baslangic": "2015-07-01", "gecerlilik_bitis": "2019-06-15"}}]}},
    {"key": "Esc", "expect": {"tool": "select"}},
    {"click": [-40, 11], "expect": {"selected": [12]}},
    {"run": "tool.timeVersion"},
    {"key": "Enter", "expect": {"entities": 14, "logged": ["“Yol” katmanı başlangıç ve bitiş alanı olan bir zamansal katman değil; sürüm yalnız aralıklı katmanda yapılır. Katmanın zaman ayarlarına bakın. Hiçbir nesne yazılmadı."]}},
    {"key": "Esc"},
    {"key": "Esc", "expect": {"tool": "select"}},
    {"click": [5, 0], "expect": {"selected": [4]}},
    {"run": "tool.timeVersion"},
    {"text": "2011-01-01"},
    {"key": "Enter", "expect": {"entities": 14, "logged": ["1 nesnenin zamanı 01.01.2011 anını içermiyor: başlangıcı bu tarihten önce, bitişi sonra olmalı. Hiçbir nesne yazılmadı."]}}
  ]
}
