{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "move-copy",
  "title": "Taşı ve Kopyala: seçim yokken araç önce seçer (tıklama ve pencere, sağ tıkla devam); temel nokta uç noktaya kenetlenir; yazılan @dY,dX ile taşıma, tek adımda geri alma; seçim varken kopyalama temel noktadan başlar, her tık bir kopya, kilitli katmandaki nesne kopyalanmaz, Bitir (Enter)",
  "source": "Web'in SelectionFirstTool, MoveTool ('tool.move', 'tool.copy') ve cad.entities.transform kuralları, ADR 0037",
  "covers": ["UX-01", "UX-07", "UX-09", "CMD-04", "CMD-07"],
  "document": "objects.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": true, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.move", "note": "Seçim yok: araç önce nesneleri seçtirir.", "expect": { "tool": "move", "options": [], "selected": [] } },
    { "click": [-16, -12], "note": "Tıklama nesneyi seçime ekler (ya da çıkarır).", "expect": { "selected": [1] } },
    { "drag": [[-26, 2], [-10, 16]], "note": "Soldan sağa pencere, Shift olmadan da ekler.", "expect": { "selected": [1, 4] } },
    { "rightClick": [26, -18], "note": "Sağ tık (Enter) seçimi onaylar: sıra temel noktada.", "expect": { "tool": "move", "options": [], "selected": [1, 4] } },
    { "move": [-24, -11.625], "expect": { "snap": "endpoint" } },
    { "click": [-24, -11.625], "note": "Temel nokta çizginin ucuna kenetlenir.", "expect": { "options": [] } },
    { "move": [-10, -3] },
    { "text": "@12.5,-7.25" },
    { "key": "Enter", "note": "Yazılan fark kesindir: iki nesne tek adımda taşınır, araç biter, seçim kalır.", "expect": { "tool": "select", "log": "success", "canUndo": true, "selected": [1, 4], "objects": [{ "id": 1, "kind": "line", "points": [[-11.5, -19.25], [4.5, -19.25]] }, { "id": 4, "kind": "polygon", "points": [[-11.5, -3.25], [0.5, -3.25], [0.5, 6.75], [-11.5, 6.75]] }] } },
    { "key": "Ctrl+Z", "note": "Taşıma tek adımda geri alınır.", "expect": { "canUndo": false, "objects": [{ "id": 1, "kind": "line", "points": [[-24, -12], [-8, -12]] }, { "id": 4, "kind": "polygon", "points": [[-24, 4], [-12, 4], [-12, 14], [-24, 14]] }] } },
    { "click": [10, -16], "shift": true, "note": "Kilitli katmanın çizgisi de seçilir.", "expect": { "tool": "select", "selected": [1, 4, 6] } },
    { "run": "tool.copy", "note": "Seçim varken kopyalama temel noktadan başlar.", "expect": { "tool": "copy", "options": [] } },
    { "click": [-4, -18], "expect": { "options": ["Enter"] } },
    { "move": [-4, -10] },
    { "click": [-4, -10], "note": "Her tık bir kopya: kilitli katmandaki çizgi kopyalanmaz (uyarı), öbür ikisi kopyalanır.", "expect": { "tool": "copy", "entities": 9, "log": "success", "newest": { "kind": "polygon", "points": [[-24, 12], [-12, 12], [-12, 22], [-24, 22]] } } },
    { "text": "@8,0" },
    { "key": "Enter", "note": "Yazılan fark temel noktadandır.", "expect": { "tool": "copy", "entities": 11, "newest": { "kind": "polygon", "points": [[-16, 4], [-4, 4], [-4, 14], [-16, 14]] } } },
    { "key": "Enter", "note": "Bitir (Enter): araç biter.", "expect": { "tool": "select", "entities": 11 } },
    { "key": "Ctrl+Z", "note": "Her kopya kendi adımıdır.", "expect": { "entities": 9 } }
  ]
}
