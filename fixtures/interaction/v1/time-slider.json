{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "time-slider",
  "title": "Zaman sürgüsü: açılınca son konumda (01.01.2024, yıl adımı, Anlık); 103'ün yerinde 104 seçilir, Başa'da (2010) hiçbiri, Sona'da yine 104; Geri'yle 2021'de 103 bitmiş ve 104 başlamamıştır, Zamanı karşılaştır 2020 ile 2021 arasında 103'ün silindiğini söyler, 2020'de 103 seçilir; Anlık'ta 2020-09-30'daki arıza görünmez, Aralık'ta (2020 – 2021) seçilir; Kapat süzgeci kaldırır",
  "source": "docs/adr/0210",
  "covers": ["GIS-12"],
  "document": "temporal.kcad",
  "view": {"center": [487050, 4420025], "metresPerPixel": 0.25},
  "clickTolerance": 0.5,
  "steps": [
    {"run": "time.slider", "expect": {"time": {"label": "01.01.2024", "position": 14, "last": 14}}},
    {"click": [35, 0], "note": "103 bitti (2021), 104 başladı (2022)", "expect": {"selected": [6]}},
    {"key": "Esc", "expect": {"selected": []}},
    {"timebar": "Başa", "expect": {"time": {"label": "01.01.2010", "position": 0, "last": 14}}},
    {"click": [35, 0], "note": "103 de 104 de henüz yok", "expect": {"selected": []}},
    {"timebar": "Sona", "expect": {"time": {"label": "01.01.2024", "position": 14, "last": 14}}},
    {"click": [35, 0], "expect": {"selected": [6]}},
    {"key": "Esc", "expect": {"selected": []}},
    {"timebar": "Geri"},
    {"timebar": "Geri"},
    {"timebar": "Geri", "expect": {"time": {"label": "01.01.2021", "position": 11, "last": 14}}},
    {"click": [35, 0], "note": "103'ün bitişi 01.01.2021 (o an dahil değil), 104 2022'de", "expect": {"selected": []}},
    {"run": "time.compare", "note": "Zamanı karşılaştır: Parsel'in bir önceki konumu (01.01.2020) ile bu konumu, parsel numarasıyla", "expect": {"dialog": "Veri karşılaştır"}},
    {"dialog": "Veri karşılaştır", "press": "Karşılaştır", "note": "103 01.01.2021'de bitti", "expect": {"dialog": "Veri karşılaştır", "logged": ["Karşılaştırıldı: 1 silinen, 3 aynı."]}},
    {"dialog": "Veri karşılaştır", "press": "Kapat", "expect": {"dialog": null}},
    {"timebar": "Geri", "expect": {"time": {"label": "01.01.2020", "position": 10, "last": 14}}},
    {"click": [35, 0], "expect": {"selected": [5]}},
    {"key": "Esc", "expect": {"selected": []}},
    {"click": [10, 14], "note": "Anlık: arıza 30.09.2020'de, konum 01.01.2020", "expect": {"selected": []}},
    {"timebar": "Aralık", "expect": {"time": {"label": "01.01.2020 – 01.01.2021", "position": 10, "last": 14}}},
    {"click": [10, 14], "expect": {"selected": [11]}},
    {"key": "Esc", "expect": {"selected": []}},
    {"timebar": "Kapat", "expect": {"time": null}},
    {"click": [-20, 0], "note": "süzgeç yok: 101 ile 101/2 üst üste, küçüğü seçilir", "expect": {"selected": [3]}}
  ]
}
