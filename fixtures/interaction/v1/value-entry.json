{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "value-entry",
  "title": "Değer alanı: ilk karakter, parantezli toplam, metrik birim, eksi değer, Tab ile kilit, Enter, Boşluk ve Esc",
  "source": "plan/cad.md CAD-INPUT-01, CAD-INPUT-02; docs/adr/0266; ADR 0018 (tuş anlamları), 0166 §6 (Tab)",
  "covers": ["UX-04", "UX-06"],
  "document": "empty.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.line", "expect": { "tool": "line", "points": 0 } },
    { "click": [0, 0], "expect": { "points": 1 } },
    { "move": [20, 0], "note": "İmleç ilk noktanın doğusunda: yazılan uzunluk doğuya gider." },
    { "text": "(", "note": "Parantez değer alanını açar (docs/adr/0266 §2).", "expect": { "dynamicInput": "(" } },
    { "text": "10+2.5)", "expect": { "dynamicInput": "(10+2.5)" } },
    { "key": "Enter", "note": "Toplam bir uzunluktur: 12.5 m doğuya.", "expect": { "dynamicInput": null, "points": 2, "entities": 1, "newest": { "kind": "line", "points": [[0, 0], [12.5, 0]] } } },
    { "text": "@-3,(2*2)", "note": "Eksi göreli fark ve parantezli toplam yan yana.", "expect": { "dynamicInput": "@-3,(2*2)" } },
    { "key": "Enter", "expect": { "points": 3, "entities": 2, "newest": { "kind": "line", "points": [[12.5, 0], [9.5, 4]] } } },
    { "move": [9.5, 20], "note": "İmleç son noktanın kuzeyinde." },
    { "text": "250cm", "note": "Birimin harfleri değer alanına yazılır; seçenek harfi sayılmaz.", "expect": { "dynamicInput": "250cm", "tool": "line" } },
    { "key": "Space", "note": "Boşluk Enter gibi uygular: 250 cm, 2.5 m kuzeye.", "expect": { "dynamicInput": null, "points": 4, "entities": 3, "newest": { "kind": "line", "points": [[9.5, 4], [9.5, 6.5]] } } },
    { "move": [-10, 6.5], "note": "İmleç batıda." },
    { "text": "2m", "expect": { "dynamicInput": "2m" } },
    { "key": "Tab", "note": "Tab birimli uzunluğu da kilitler (docs/adr/0166 §6).", "expect": { "dynamicInput": "", "locks": ["Uzunluk 2.000 m"] } },
    { "key": "Enter", "note": "Boş doğrultu alanında imlecin doğrultusu alınır.", "expect": { "dynamicInput": null, "points": 5, "entities": 4, "newest": { "kind": "line", "points": [[9.5, 6.5], [7.5, 6.5]] } } },
    { "text": "(1+", "expect": { "dynamicInput": "(1+" } },
    { "key": "Enter", "note": "Kapanmayan parantez uzunluk değildir: alan kapanır, nokta konmaz, uyarılır; araç sürer.", "expect": { "dynamicInput": null, "entities": 4, "points": 5, "tool": "line", "log": "warn" } },
    { "text": "7", "expect": { "dynamicInput": "7" } },
    { "key": "Esc", "note": "İlk Esc yalnız değer alanını kapatır; çizgi aracı ve noktaları sürer.", "expect": { "dynamicInput": null, "tool": "line", "points": 5 } },
    { "key": "Esc", "expect": { "tool": "select", "entities": 4 } }
  ]
}
