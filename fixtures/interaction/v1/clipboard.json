{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "clipboard",
  "title": "Pano: Ctrl+C seçimi panoya koyar, çizim değişmez; Ctrl+V yapıştırma aracını başlatır, tıklanan yere temel noktayla (kutunun sol alt köşesi) yapıştırır, tek adımda geri alınır; yazılan @dY,dX temel noktadandır; Ctrl+X kilitli nesneyi kesmez, seçili bırakır; Ctrl+Shift+V özgün koordinatlara yapıştırır; Esc ve Enter yapıştırmadan çıkar",
  "source": "Web'in Clipboard'u, 'edit.cut', 'edit.copy', 'edit.paste' ve 'edit.pasteOriginal' komutları, PasteTool ve pasteEntities; ADR 0056",
  "covers": ["UX-01", "UX-04", "UX-09"],
  "document": "objects.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "click": [-16, -12], "expect": { "tool": "select", "selected": [1] } },
    { "key": "Ctrl+C", "note": "Panoya kopyalamak çizimi değiştirmez; seçim kalır.", "expect": { "log": "success", "entities": 7, "canUndo": false, "selected": [1] } },
    { "key": "Ctrl+V", "note": "Yapıştır aracı: nesneler temel noktalarıyla imleci izler.", "expect": { "tool": "paste", "points": 0, "options": [] } },
    { "move": [-4, -18], "expect": { "tool": "paste", "entities": 7 } },
    { "click": [-4, -18], "note": "Temel nokta (−24, −12) tıklanan yere gelir; yapıştırılan yeni nesne seçilir, araç çıkar.", "expect": { "tool": "select", "entities": 8, "log": "success", "canUndo": true, "selected": [8], "newest": { "kind": "line", "points": [[-4, -18], [12, -18]] } } },
    { "key": "Ctrl+Z", "note": "Yapıştırma tek adımda geri alınır.", "expect": { "ids": [1, 2, 3, 4, 5, 6, 7], "selected": [] } },
    { "key": "Ctrl+V", "note": "Pano yapıştırmadan sonra da dolu kalır.", "expect": { "tool": "paste" } },
    { "text": "@10,0", "expect": { "dynamicInput": "@10,0" } },
    { "key": "Enter", "note": "Yazılan fark temel noktadandır ve kesindir; nesne yeni bir kimlik alır.", "expect": { "tool": "select", "ids": [1, 2, 3, 4, 5, 6, 7, 9], "selected": [9], "newest": { "kind": "line", "points": [[-14, -12], [2, -12]], "edges": [[16, 0]] } } },
    { "click": [10, -16], "note": "Kilitli katmandaki çizgi de seçilir.", "expect": { "selected": [6] } },
    { "click": [12, 10], "shift": true, "expect": { "selected": [6, 2] } },
    { "key": "Ctrl+X", "note": "Kilitli çizgi kesilmez (uyarı) ve seçili kalır; öbürü panoya alınıp çizimden çıkar.", "expect": { "log": "success", "selected": [6], "ids": [1, 3, 4, 5, 6, 7, 9], "canUndo": true } },
    { "key": "Ctrl+Shift+V", "note": "Özgün koordinatlara yapıştır: kesilen çizgi yerine, yeni bir nesne olarak gelir ve seçilir.", "expect": { "tool": "select", "ids": [1, 3, 4, 5, 6, 7, 9, 10], "selected": [10], "newest": { "kind": "line", "points": [[0, 4], [24, 16]] } } },
    { "key": "Ctrl+Z", "expect": { "ids": [1, 3, 4, 5, 6, 7, 9] } },
    { "key": "Ctrl+Z", "note": "Kesme de tek adımda geri alınır: çizgi kendi kimliğiyle yerine döner.", "expect": { "ids": [1, 2, 3, 4, 5, 6, 7, 9], "selected": [], "objects": [{ "id": 2, "kind": "line", "points": [[0, 4], [24, 16]] }] } },
    { "key": "Ctrl+V", "expect": { "tool": "paste" } },
    { "key": "Esc", "note": "Esc yapıştırmadan çıkar.", "expect": { "tool": "select", "entities": 8 } },
    { "key": "Ctrl+V", "expect": { "tool": "paste" } },
    { "key": "Enter", "note": "Enter da yapıştırmadan çıkar.", "expect": { "tool": "select", "entities": 8, "ids": [1, 2, 3, 4, 5, 6, 7, 9] } }
  ]
}
