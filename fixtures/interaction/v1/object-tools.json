{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "object-tools",
  "title": "Birleştir ve Patlat: seçim yokken önce seçtirir (tıklama, kesişim penceresi, sağ tıkla devam), kilitli çizgi atlanır, uç uca gelen çizgiler ilk nesnenin yerinde çoklu çizgi olur; seçimle hemen çalışır, kapalı alan çizgilerine ayrılır, parçalar seçilir; temel nesne patlatılmaz",
  "source": "Web'in SelectionFirstTool, SelectionActionTool, JoinTool, ExplodeTool ('tool.join', 'tool.explode') ve cad.entities.edit, ADR 0047",
  "covers": ["UX-01", "UX-07", "CMD-04", "CMD-07", "CAD-02"],
  "document": "edits.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "move": [-20, 0] },
    { "run": "tool.join", "note": "Seçim yok: araç önce seçtirir; istemde uç boşluğu toleransı.", "expect": { "tool": "join", "options": [], "selected": [] } },
    { "click": [4, -4], "expect": { "selected": [8] } },
    { "drag": [[10, -5], [7, -19]], "note": "Sağdan sola kesişim penceresi: dokunduğu çizgiler de eklenir.", "expect": { "selected": [8, 9, 13] } },
    { "rightClick": [20, 10], "note": "Sağ tık birleştirir: kilitli katmandaki çizgi atlanır, iki çizgi ilk nesnenin yerinde çoklu çizgi olur; araç biter.", "expect": { "tool": "select", "log": "success", "entities": 12, "selected": [8], "objects": [{ "id": 8, "kind": "polyline", "points": [[0, -4], [8, -4], [8, -12]] }] } },
    { "key": "Ctrl+Z", "note": "Tek adımda geri alınır; silinen çizgi yerine döner.", "expect": { "entities": 13, "objects": [{ "id": 8, "kind": "line", "points": [[0, -4], [8, -4]] }, { "id": 9, "kind": "line", "points": [[8, -4], [8, -12]] }] } },
    { "key": "Esc", "expect": { "selected": [] } },
    { "click": [19, -14], "expect": { "selected": [10] } },
    { "run": "tool.explode", "note": "Seçimle hemen çalışır: kapalı alan dört çizgiye ayrılır, parçalar seçilir, araç biter.", "expect": { "tool": "select", "log": "success", "entities": 16, "selected": [14, 15, 16, 17], "newest": { "kind": "line", "points": [[14, -6], [14, -14]] } } },
    { "key": "Ctrl+Z", "expect": { "entities": 13, "objects": [{ "id": 10, "kind": "polygon", "points": [[14, -14], [24, -14], [24, -6], [14, -6]] }] } },
    { "key": "Esc", "expect": { "selected": [] } },
    { "run": "tool.explode", "expect": { "tool": "explode", "options": [] } },
    { "click": [0, 10], "expect": { "selected": [4] } },
    { "key": "Enter", "note": "Çoklu çizgi kenarlarına ayrılır.", "expect": { "tool": "select", "log": "success", "entities": 14, "newest": { "kind": "line", "points": [[0, 4], [10, 4]] } } },
    { "key": "Esc", "expect": { "selected": [] } },
    { "click": [4, -4], "expect": { "selected": [8] } },
    { "run": "tool.explode", "note": "Çizgi zaten temel nesnedir: uyarı, hiçbir şey değişmez.", "expect": { "tool": "select", "log": "warn", "entities": 14 } },
    { "key": "Esc" },
    { "run": "tool.join", "expect": { "tool": "join" } },
    { "key": "Enter", "note": "Seçim yokken Enter araçtan çıkar.", "expect": { "tool": "select", "entities": 14 } }
  ]
}
