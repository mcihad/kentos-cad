{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "ellipse-spline",
  "title": "Elips ve Eğri: eksenin iki ucu ve yazılan yarı eksen; Yay ve Merkez ile döndürme açısından eliptik yay, başlangıç ve bitiş açısı; eğrinin noktaları, Geri (G), Enter ile açık, Kapat (K) ile kapalı eğri, Ctrl+Z, tek noktayla Enter",
  "source": "Web'in EllipseTool'u (ellipseTool.ts), SplineTool'u (curveTools.ts) ve cad.entities.create, ADR 0057",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "empty.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.ellipse", "expect": { "tool": "ellipse", "points": 0, "options": ["M", "Y"], "entities": 0 } },
    { "click": [-20, 10], "expect": { "points": 1, "options": [] } },
    { "click": [0, 10], "note": "Eksenin iki ucu: sıra diğer yarı eksende.", "expect": { "points": 2, "options": ["D"] } },
    { "move": [-10, 16], "note": "Önizleme: elips, merkezden imlece kesikli çizgi, yarı eksenler imleç yanında." },
    { "text": "4", "expect": { "dynamicInput": "4" } },
    { "key": "Enter", "note": "Büyük yarı eksen 10 m, küçüğü yazılan 4 m; elips tek adım “Ekle”.", "expect": { "entities": 1, "newest": { "kind": "ellipse", "center": [-10, 10], "points": [[0, 10], [-10, 14], [-20, 10], [-10, 6]] }, "points": 0, "options": ["M", "Y"], "log": "success", "canUndo": true } },
    { "key": "Y", "note": "Yay açılır: elipsten sonra başlangıç ve bitiş açısı sorulur.", "expect": { "options": ["M", "Y"], "points": 0 } },
    { "key": "M", "note": "Merkezden: ilk nokta merkezdir; seçenek Eksenden (E) olur.", "expect": { "options": ["E", "Y"], "points": 0 } },
    { "click": [10, -10] },
    { "click": [20, -10], "expect": { "points": 2, "options": ["D"] } },
    { "key": "D", "note": "Döndürme: diğer eksen açıyla verilir.", "expect": { "options": [], "points": 2 } },
    { "text": "95" },
    { "key": "Enter", "note": "Açı 0 ile 89.4 derece arasında olmalı.", "expect": { "log": "warn", "points": 2, "entities": 1 } },
    { "text": "60" },
    { "key": "Enter", "note": "Küçük yarı eksen 10 × cos 60° = 5 m; yayın açıları beklenir.", "expect": { "points": 0, "entities": 1, "options": [] } },
    { "move": [16, -2], "note": "Önizleme: elips kesikli, merkezden imlece çizgi." },
    { "text": "0" },
    { "key": "Enter", "expect": { "entities": 1, "points": 0 } },
    { "text": "90" },
    { "key": "Enter", "note": "Büyük eksenden 90°'ye eliptik yay.", "expect": { "entities": 2, "newest": { "kind": "ellipse", "center": [10, -10], "points": [[20, -10], [10, -5]] }, "log": "success", "options": ["E", "Y"] } },
    { "key": "Esc", "expect": { "tool": "select", "entities": 2 } },
    { "run": "tool.spline", "expect": { "tool": "spline", "points": 0, "options": [] } },
    { "click": [-20, -14], "expect": { "points": 1, "options": [] } },
    { "click": [-12, -6], "expect": { "points": 2, "options": ["K", "G", "Enter"] } },
    { "click": [-4, -14] },
    { "click": [4, -6], "expect": { "points": 4 } },
    { "move": [10, -14], "note": "Önizleme: noktalardan ve imleçten geçen eğri, altında kesikli nokta zinciri." },
    { "key": "G", "note": "Geri (G) son noktayı alır.", "expect": { "points": 3, "entities": 2 } },
    { "key": "Enter", "note": "Açık eğri: üç nokta, tek adım.", "expect": { "entities": 3, "newest": { "kind": "spline", "points": [[-20, -14], [-12, -6], [-4, -14]] }, "points": 0, "log": "success" } },
    { "click": [-20, 0] },
    { "click": [-12, 8] },
    { "click": [-4, 0] },
    { "key": "Ctrl+Z", "note": "Çizerken Ctrl+Z son noktayı alır.", "expect": { "points": 2, "entities": 3 } },
    { "click": [-4, 0] },
    { "key": "K", "note": "Kapat (K) üç noktadan kapalı eğri yazar.", "expect": { "entities": 4, "newest": { "kind": "spline", "points": [[-20, 0], [-12, 8], [-4, 0]] }, "points": 0, "log": "success" } },
    { "key": "Ctrl+Z", "note": "Nokta kalmadı: çizim geri alınır, araç sürer.", "expect": { "entities": 3, "canRedo": true, "tool": "spline" } },
    { "click": [10, 0], "expect": { "points": 1 } },
    { "key": "Enter", "note": "Tek noktayla eğri olmaz: hiçbir şey yazılmadan baştan.", "expect": { "points": 0, "entities": 3, "tool": "spline" } },
    { "key": "Enter", "note": "Nokta yokken Enter araçtan çıkar.", "expect": { "tool": "select", "entities": 3 } }
  ]
}
