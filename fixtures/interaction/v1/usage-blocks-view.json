    { "key": "Enter", "expect": { "tool": "select" } },
    { "click": [8, 4.8], "note": "Doğudaki direk seçilir.", "expect": { "selected": [8] } },
    { "run": "tool.mirror", "expect": { "tool": "mirror", "options": ["S"] } },
    { "text": "487020,4420010" },
    { "key": "Enter", "note": "Eksen yolun ekseni." },
    { "text": "487030,4420010" },
    { "key": "Enter", "note": "Direk karşı kaldırıma aynalanır, kolu yine yola döner; asıl yerinde kalır.", "expect": { "tool": "select", "entities": 16, "log": "success", "newest": { "kind": "insert", "points": [[8, -4.8], [8, -3.8], [9, -4.8]] }, "objects": [{ "id": 8, "kind": "insert", "points": [[8, 4.8], [8, 3.8], [9, 4.8]] }] } },
    { "shot": "aynala" },
    { "click": [-2, 7.5], "note": "Ortadaki ağaç.", "expect": { "selected": [10] } },
    { "run": "tool.move", "expect": { "tool": "move" } },
    { "move": [-2, 7.5], "expect": { "snap": "node" } },
    { "click": [-2, 7.5] },
    { "text": "@1.5,-0.5" },
    { "key": "Enter", "note": "Ağaç yazılan farkla taşınır.", "expect": { "tool": "select", "log": "success", "objects": [{ "id": 10, "kind": "insert", "points": [[-0.5, 7], [0.5, 7], [-0.5, 8]] }] } },
    { "click": [4.5, 7.5], "note": "Doğudaki küçük ağaç.", "expect": { "selected": [11] } },
    { "run": "tool.scale", "expect": { "tool": "scale" } },
    { "move": [4.5, 7.5] },
    { "click": [4.5, 7.5] },
    { "text": "1.5" },
    { "key": "Enter", "note": "Gövdesinin merkezinden 1,5 katına: ölçeği 0,8'den 1,2'ye.", "expect": { "tool": "select", "objects": [{ "id": 11, "kind": "insert", "points": [[4.5, 7.5], [5.7, 7.5], [4.5, 8.7]] }] } },
    { "shot": "agaclar" },
    { "click": [-4, -7], "note": "Trafo.", "expect": { "selected": [12] } },
    { "run": "tool.rotate", "expect": { "tool": "rotate" } },
    { "move": [-4, -7] },
    { "click": [-4, -7], "note": "Merkez trafonun yerleştirme noktası." },
    { "text": "90" },
    { "key": "Enter", "note": "Saat yönünün tersine 90°: trafo taramasıyla ve yazısıyla döner.", "expect": { "tool": "select", "objects": [{ "id": 12, "kind": "insert", "points": [[-4, -7], [-4, -6], [-5, -7]] }] } },
    { "shot": "dondur" },
    { "drag": [[7, 7], [-10.5, 6.5]], "note": "Sağdan sola kesişim penceresi üç ağacın tepesine değer.", "expect": { "selected": [9, 10, 11] } },
    { "shot": "secim" },
    { "key": "Esc", "expect": { "selected": [] } },
    { "key": "Ctrl+Z", "note": "Döndürme geri alınır.", "expect": { "objects": [{ "id": 12, "kind": "insert", "points": [[-4, -7], [-3, -7], [-4, -6]] }] } },
    { "key": "Ctrl+Y", "note": "Ve yinelenir.", "expect": { "objects": [{ "id": 12, "kind": "insert", "points": [[-4, -7], [-4, -6], [-5, -7]] }] } },
    {
      "saveAndReopen": true,
      "note": "Kaydedilip yeniden açılan çizimde bloklar ve yerleştirmeler aynıdır.",
      "expect": {
        "entities": 16,
