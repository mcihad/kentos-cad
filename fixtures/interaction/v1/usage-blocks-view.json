        "newest": { "kind": "insert", "points": [[8, -4.8], [8, -3.8], [9, -4.8]] },
        "objects": [
          { "id": 10, "kind": "insert", "points": [[-0.5, 7], [0.5, 7], [-0.5, 8]] },
          { "id": 11, "kind": "insert", "points": [[4.5, 7.5], [5.7, 7.5], [4.5, 8.7]] },
          { "id": 12, "kind": "insert", "points": [[-4, -7], [-4, -6], [-5, -7]] },
          { "id": 15, "kind": "insert", "points": [[1, 4.8], [1, 3.8], [2, 4.8]] }
        ]
      }
    },
    { "shot": "yeniden-acildi" }
  ]
