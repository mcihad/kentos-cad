{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "usage-blocks-view",
  "title": "Kullanım: bloklu bir yol kesiti; yerleştirmeler tanımlarının parçalarıyla çizilir, vurgulanır ve seçilir, rögarların merkezine kenetlenen kanal hattı, direği kopyalama ve karşı kaldırıma aynalama, ağacı taşıma ve ölçekleme, trafoyu döndürme, kesişim penceresi, geri alma ve yineleme, kaydedip yeniden açma",
  "source": "Kullanım senaryosu (kentos-cad kullan, apps/web/scripts/e2e/use.mjs); ADR 0144, 2. adım",
  "covers": ["CAD-04"],
  "document": "blocks.kcad",
  "view": { "center": [487020, 4420010], "metresPerPixel": 0.0625 },
  "draft": { "snap": true, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "clickTolerance": 0.0625,
  "steps": [
    { "shot": "cizim", "note": "Açılan çizim: her yerleştirme tanımının parçalarıyla, kendi katmanının rengiyle çizilir; direğin lambası iç içe bir bloktur, rögarın ve trafonun yazısı bloğun içindedir, trafonun taraması onunla yerleşir." },
    { "move": [0, -0.75], "note": "Ortadaki rögarın dış çemberine gelinir: yerleştirme bütün parçalarıyla vurgulanır.", "expect": { "hover": 5 } },
    { "shot": "uzerine-gelme" },
    { "click": [0, -0.75], "note": "Tıklama yerleştirmeyi seçer; Öznitelikler bloğun adını, yerini, ölçeğini ve dönüşünü gösterir, tutamacı yerleştirme noktasıdır.", "expect": { "tool": "select", "selected": [5] } },
    { "shot": "secili" },
    { "key": "Esc", "expect": { "selected": [] } },
    { "run": "tool.line", "note": "Kanal hattı: rögarların merkezleri arasında." },
    { "move": [-10, -1.5], "note": "Rögarın yerleştirme noktası (merkezi) kenettir.", "expect": { "snap": "node" } },
    { "click": [-10, -1.5], "note": "Hat batıdaki rögarın merkezinden başlar." },
    { "move": [0, -1.5], "expect": { "snap": "node" } },
    { "click": [0, -1.5], "expect": { "entities": 13, "newest": { "kind": "line", "points": [[-10, -1.5], [0, -1.5]] } } },
    { "move": [10, -1.5], "expect": { "snap": "node" } },
    { "click": [10, -1.5], "note": "Her parça ayrı çizgidir.", "expect": { "entities": 14, "newest": { "kind": "line", "points": [[0, -1.5], [10, -1.5]] } } },
    { "key": "Enter", "note": "Enter zinciri bitirir, araç yeni zincire hazırdır.", "expect": { "tool": "line", "points": 0, "entities": 14 } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "shot": "kanal" },
    { "click": [-6, 4.8], "note": "Batıdaki direğin temeli tıklanır.", "expect": { "selected": [7] } },
    { "run": "tool.copy", "expect": { "tool": "copy" } },
    { "move": [-6, 4.8], "expect": { "snap": "node" } },
    { "click": [-6, 4.8], "note": "Temel nokta yerleştirme noktasına kenetlenir." },
    { "text": "@7,0" },
