{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "layer-states",
  "title": "Katman durumları: pencerede “Tüm katmanlar” görünürlük ve stilleriyle kaydedilir; Katmanı yalıt'tan sonra Yeni katman durumu kaydet şimdiki hâli “Durum 1” olarak kaydeder; pencerede seçilen durum uygulanır (görünürlükler döner), öbürü uygulanır, adı değişir, silinir; durumlar dosyayla kaydedilip açılır, uygulanan durum söylenir",
  "source": "docs/adr/0177 §4",
  "covers": ["HYB-20"],
  "document": "layer-admin.kcad",
  "view": {"center": [487000, 4420000], "metresPerPixel": 0.125},
  "clickTolerance": 0.2,
  "steps": [
    {"run": "layer.states", "expect": {"dialog": "Katman durumları"}},
    {"dialog": "Katman durumları", "fill": {"Ad": "Tüm katmanlar"}, "check": {"Kilitler": false, "Stiller": true}, "press": "Yeni durum kaydet", "note": "Görünürlük ve stiller kaydedilir: projenin ayarı, geri alma adımı değil", "expect": {"dialog": "Katman durumları", "dirty": true, "canUndo": false, "logged": ["“Tüm katmanlar” katman durumu kaydedildi: görünürlük ve stil."]}},
    {"dialog": "Katman durumları", "press": "Kapat", "expect": {"dialog": null}},
    {"run": "tool.layerIsolate"},
    {"click": [0, 5]},
    {"key": "Enter", "note": "Yalnız Parsel görünür kalır; öbür katmanlar ve yalnız onları tutan Arşiv grubu gizlenir", "expect": {"hiddenLayers": ["Kadastro / Eski parsel", "Arşiv", "Arşiv / 2019", "Arşiv / 2020", "Yol", "Bina", "Lejant", "Kilitli"]}},
    {"run": "layer.stateSave", "note": "Şimdiki hâl “Durum 1” olarak kaydedilir", "expect": {"logged": ["“Durum 1” katman durumu kaydedildi: görünürlük ve stil."]}},
    {"run": "layer.states", "expect": {"dialog": "Katman durumları"}},
    {"dialog": "Katman durumları", "press": "Tüm katmanlar", "note": "Durum seçilir: adı ve parçaları alanlara gelir"},
    {"shot": "durumlar-pencere", "note": "Katman durumları: iki durum, şimdiki hâle uyan Durum 1 işaretli, Tüm katmanlar seçili"},
    {"dialog": "Katman durumları", "press": "Uygula", "note": "Görünürlükler döner; stiller zaten aynı", "expect": {"dialog": "Katman durumları", "hiddenLayers": [], "canUndo": false, "logged": ["“Tüm katmanlar” katman durumu uygulandı: 8 görünürlük değişti."]}},
    {"dialog": "Katman durumları", "press": "Durum 1"},
    {"dialog": "Katman durumları", "press": "Uygula", "expect": {"hiddenLayers": ["Kadastro / Eski parsel", "Arşiv", "Arşiv / 2019", "Arşiv / 2020", "Yol", "Bina", "Lejant", "Kilitli"], "logged": ["“Durum 1” katman durumu uygulandı: 8 görünürlük değişti."]}},
    {"dialog": "Katman durumları", "fill": {"Ad": "Yalnız parsel"}, "press": "Yeniden adlandır", "expect": {"logged": ["“Durum 1” katman durumunun adı “Yalnız parsel” oldu."]}},
    {"dialog": "Katman durumları", "press": "Yalnız parsel"},
    {"dialog": "Katman durumları", "press": "Sil", "expect": {"logged": ["“Yalnız parsel” katman durumu silindi."]}},
    {"dialog": "Katman durumları", "press": "Kapat", "expect": {"dialog": null}},
    {"saveAndReopen": true, "note": "Durumlar projenin ayarıdır: dosyayla gider ve gelir"},
    {"run": "layer.states", "expect": {"dialog": "Katman durumları"}},
    {"dialog": "Katman durumları", "press": "Tüm katmanlar"},
    {"dialog": "Katman durumları", "press": "Uygula", "expect": {"hiddenLayers": [], "logged": ["“Tüm katmanlar” katman durumu uygulandı: 8 görünürlük değişti."]}},
    {"dialog": "Katman durumları", "press": "Uygula", "note": "Katmanlar zaten o durumda", "expect": {"logged": ["Katmanlar zaten “Tüm katmanlar” durumunda."]}},
    {"dialog": "Katman durumları", "press": "Kapat", "expect": {"dialog": null}}
  ]
}
