{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "right-angle",
  "title": "Dik açı ve Dik kapat (ADR 0166 §4): Dik açı açıkken Kapalı alan'ın ilk kenarı serbest, sonrakiler öncekine dik; Dik kapat (D) son köşeyi ilk kenara dik kapatır; yazılan mesafe dik doğrultuda, imlecin tarafına; ilk ve son kenar paralelken Dik kapat söylenir; Çoklu çizgi'de Dik kapat yok",
  "source": "docs/adr/0166-digitizing-locks.md §4",
  "covers": ["HYB-10"],
  "document": "empty.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.1 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.1,
  "steps": [
    { "run": "draft.rightAngle", "note": "Durum çubuğunda Dik açı." },
    { "run": "tool.polygon" },
    { "click": [-10, -10], "expect": { "points": 1 } },
    { "click": [6, -2], "note": "İlk kenar serbest.", "expect": { "points": 2, "options": ["Y", "U", "İ", "A", "G"] } },
    { "move": [10, 5] },
    { "click": [10, 5], "note": "İkinci kenar ilk kenara dik: tık dik doğrunun üstüne, (4, 2)'ye iner. Üç köşeyle Dik kapat (D) gelir.", "expect": { "points": 3, "options": ["Y", "U", "İ", "A", "D", "G", "Enter"] } },
    { "key": "D", "note": "Dik kapat: dördüncü köşe iki dik doğrunun kesişiminde; alan kapanır ve yazılır.", "expect": { "entities": 1, "points": 0, "newest": { "kind": "polygon", "points": [[-10, -10], [6, -2], [4, 2], [-12, -6]] } } },
    { "click": [-15, 10], "expect": { "points": 1 } },
    { "click": [-5, 10], "expect": { "points": 2 } },
    { "move": [-3, 14] },
    { "text": "4" },
    { "key": "Enter", "note": "Yazılan 4 m dik doğrultuda, imlecin tarafına (kuzeye).", "expect": { "points": 3 } },
    { "move": [-20, 12] },
    { "click": [-20, 12], "note": "Üçüncü kenar ikinciye dik: batıya, (−20, 14)'e.", "expect": { "points": 4 } },
    { "key": "D", "note": "İlk ve son kenar paralel: Dik kapat olmaz, söylenir; noktalar kalır.", "expect": { "logged": ["Dik kapatılamıyor: ilk kenar ile son kenar paralel."], "points": 4, "entities": 1 } },
    { "key": "Enter", "note": "Enter düz kapatır.", "expect": { "entities": 2, "newest": { "kind": "polygon", "points": [[-15, 10], [-5, 10], [-5, 14], [-20, 14]] } } },
    { "run": "draft.rightAngle", "note": "Dik açı kapanır: bellek başladığı gibi bırakılır." },
    { "run": "tool.polyline" },
    { "click": [0, 0] },
    { "click": [5, 0] },
    { "click": [5, 5], "note": "Çoklu çizgi halka değil: Dik kapat yok.", "expect": { "points": 3, "options": ["Y", "U", "İ", "A", "G", "Enter"] } },
    { "key": "Esc", "note": "Esc bitmemiş çizgiyi bırakır.", "expect": { "tool": "select", "entities": 2 } }
  ]
}
