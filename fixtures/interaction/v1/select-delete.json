{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "select-delete",
  "title": "Seçim: üzerine gelme, tıklama, Shift ile ekleyip çıkarma, soldan sağa pencere ve sağdan sola kesişim kutusu, Esc, gizli ve kilitli katmanlar; Delete seçimi siler, kilitli nesne kalır, Ctrl+Z aynı nesneleri yerlerine getirir; seçimsiz Delete tıklananı siler",
  "source": "Web'in SelectTool, EraseTool ve cad.entities.delete kuralları, ADR 0029",
  "covers": ["UX-09", "CMD-07"],
  "document": "objects.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "move": [4, 6.25], "note": "Komut yokken imlecin altındaki nesne vurgulanır: 2 numaralı çizgi.", "expect": { "tool": "select", "hover": 2, "selected": [] } },
    { "click": [-16, -12.25], "note": "Seçim yarıçapı (5 piksel) içinde tıklamak nesneyi seçer.", "expect": { "selected": [1] } },
    { "click": [4, 6.25], "note": "Tıklama seçimin yerine geçer.", "expect": { "selected": [2] } },
    { "click": [12, 7.25], "shift": true, "note": "Shift ile tıklama ekler…", "expect": { "selected": [2, 3] } },
    { "click": [4, 6.25], "shift": true, "note": "…ya da çıkarır.", "expect": { "selected": [3] } },
    { "click": [26, 18], "note": "Boşluğa tıklamak seçimi kaldırır.", "expect": { "selected": [] } },
    { "drag": [[-26, -14], [-6, 16]], "note": "Soldan sağa pencere: tamamı içeride kalanlar, belge sırasıyla.", "expect": { "selected": [1, 4] } },
    { "key": "Esc", "note": "Komut yokken Esc seçimi kaldırır.", "expect": { "selected": [], "tool": "select" } },
    { "drag": [[13, 11], [6, 7]], "note": "Sağdan sola kesişim: kutuya dokunanlar.", "expect": { "selected": [2, 3] } },
    { "drag": [[6, 7], [13, 11]], "note": "Aynı kutu soldan sağa: içinde tamamı kalan yok.", "expect": { "selected": [] } },
    { "drag": [[-26, -14], [-6, 16]], "shift": true, "expect": { "selected": [1, 4] } },
    { "drag": [[13, 11], [6, 7]], "shift": true, "note": "Shift ile kutu seçime ekler.", "expect": { "selected": [1, 4, 2, 3] } },
    { "click": [10, -16.25], "note": "Kilitli katmanın nesnesi seçilir.", "expect": { "selected": [6] } },
    { "click": [0, -4], "note": "Gizli katmanın nesnesi seçilmez: tıklama boşluğa düşer.", "expect": { "selected": [] } },
    { "click": [-16, -12.25] },
    { "click": [4, 6.25], "shift": true, "expect": { "selected": [1, 2] } },
    { "key": "Delete", "note": "Seçim silinir: tek geri alma adımı; Sil aracı bitince seçime dönülür.", "expect": { "entities": 5, "ids": [3, 4, 5, 6, 7], "selected": [], "tool": "select", "log": "success", "canUndo": true } },
    { "key": "Ctrl+Z", "note": "Geri alma aynı nesneleri yerlerine getirir.", "expect": { "entities": 7, "ids": [1, 2, 3, 4, 5, 6, 7], "canUndo": false, "canRedo": true } },
    { "click": [10, -16.25] },
    { "click": [12, 7.25], "shift": true, "expect": { "selected": [6, 3] } },
    { "key": "Delete", "note": "Kilitli katmandaki nesne silinmez, uyarı verilir; öbürü silinir.", "expect": { "entities": 6, "ids": [1, 2, 4, 5, 6, 7], "selected": [6], "log": "success", "tool": "select" } },
    { "key": "Delete", "note": "Yalnız kilitli nesne: hiçbir şey silinmez.", "expect": { "entities": 6, "selected": [6], "log": "warn", "tool": "select" } },
    { "key": "Ctrl+Z", "expect": { "entities": 7, "ids": [1, 2, 3, 4, 5, 6, 7] } },
    { "key": "Esc", "expect": { "selected": [] } },
    { "key": "Delete", "note": "Seçim yokken Sil aracı tıklanan nesneyi bekler.", "expect": { "tool": "erase", "entities": 7 } },
    { "move": [-18, 9], "note": "Sil aracı da silinecek nesneyi vurgular: kapalı alanın içi.", "expect": { "hover": 4 } },
    { "click": [-18, 9], "expect": { "entities": 6, "ids": [1, 2, 3, 5, 6, 7], "tool": "erase" } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "key": "Ctrl+Z", "expect": { "entities": 7, "ids": [1, 2, 3, 4, 5, 6, 7] } }
  ]
}
