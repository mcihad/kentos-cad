{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "areas",
  "title": "Alan işlemleri: iki parseli tıklayarak seçip birleştirme ve geri alma; alanı tıklanan noktalarla bölme; iki seçimle alan çıkarma; çizgilerin kapattığı yerin içine tıklayarak alan; alanı delikli çoklu çizgilere çevirme",
  "source": "Web'in alan araçları (areaTools.ts: AreaUnionTool, AreaSplitTool, AreaSubtractTool, BoundaryTool, ToPolylineTool), ADR 0065",
  "covers": ["UX-01", "UX-09"],
  "document": "areas.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.areaUnion", "expect": { "tool": "areaUnion", "options": [], "entities": 10 } },
    { "click": [2, 8], "note": "Parsel 1 seçilir (alanın içine tıklamak onu seçer).", "expect": { "selected": [1] } },
    { "click": [14, 12], "expect": { "selected": [1, 2] } },
    { "key": "Enter", "note": "İki parsel tek alanda; ilki katmanını ve özniteliklerini verir.", "expect": { "tool": "select", "entities": 9, "newest": { "kind": "polygon" }, "log": "success" } },
    { "key": "Ctrl+Z", "note": "Tek adım: “Alan birleştir”.", "expect": { "entities": 10, "canRedo": true } },
    { "run": "tool.areaSplit", "expect": { "tool": "areaSplit", "entities": 10 } },
    { "click": [2, 8], "expect": { "selected": [1] } },
    { "key": "Enter", "note": "Kesme çizgisi istenir.", "expect": { "options": ["N"] } },
    { "click": [5, -3], "expect": { "options": ["G", "N"] } },
    { "move": [5, 13], "note": "Oluşacak parçalar ve alanları önizlenir." },
    { "click": [5, 13] },
    { "key": "Enter", "note": "İki parça: ilki alanın kendisi.", "expect": { "tool": "select", "entities": 11, "log": "success" } },
    { "key": "Ctrl+Z", "note": "Geri alınan bölmenin ilk parçası parselin kendisidir: seçili kalır.", "expect": { "entities": 10, "selected": [1] } },
    { "key": "Esc", "note": "Esc seçimi bırakır.", "expect": { "selected": [] } },
    { "run": "tool.areaSubtract", "note": "Önce kesilecek alanlar.", "expect": { "tool": "areaSubtract", "options": [] } },
    { "click": [2, 8] },
    { "key": "Enter", "note": "Sonra çıkarılacak alanlar; Çıkarılanları sil seçeneği gelir.", "expect": { "tool": "areaSubtract", "options": ["S"] } },
    { "click": [14, 12] },
    { "key": "Enter", "note": "Parsel 1'den parsel 2'nin örtüştüğü yer çıkarılır; parsel 2 yerinde kalır.", "expect": { "tool": "select", "entities": 10, "newest": { "kind": "polygon" }, "log": "success" } },
    { "key": "Ctrl+Z", "expect": { "entities": 10, "canRedo": true } },
    { "run": "tool.boundary", "expect": { "tool": "boundary", "options": ["A", "K"] } },
    { "move": [-23, -10], "note": "Çizgilerin kapattığı kare boyanır; alanı imlecin yanında." },
    { "click": [-23, -10], "note": "Kare, etkin katmanda alan olur; köşeleri sol alttan saat yönünün tersine.", "expect": { "entities": 11, "newest": { "kind": "polygon", "points": [[-28, -15], [-18, -15], [-18, -5], [-28, -5]] }, "log": "success", "tool": "boundary" } },
    { "key": "Enter", "note": "Oluşan alan seçili kalır; kimliği 14 (geri alınan yazmalar 11, 12 ve 13'ü harcadı, kimlik yeniden verilmez).", "expect": { "tool": "select", "selected": [14] } },
    { "key": "Esc", "expect": { "selected": [] } },
    { "run": "tool.toPolyline", "expect": { "tool": "toPolyline" } },
    { "click": [20, -7], "note": "Delikli parsel seçilir." },
    { "key": "Enter", "note": "Dış halka parselin kendisi, delik ayrı çoklu çizgi.", "expect": { "tool": "select", "entities": 12, "log": "success" } }
  ]
}
