{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "path-edit-tools",
  "title": "Kır, Köşe ekle/sil ve Uzat-kısalt: kenetlenen kırılma noktası, iki nokta arası silinir, Enter ile tek noktadan bölme; kenara köşe ekleme ve köşeyi silme; ucu fareyle izleyip yazılan toplam uzunluk, Toplam (T) kipinde tıklanan uç; tek adımda geri alma",
  "source": "Web'in EdgePickTool, BreakTool, VertexTool, LengthenTool ('tool.break', 'tool.vertex', 'tool.lengthen') ve cad.entities.edit, ADR 0047",
  "covers": ["UX-01", "UX-07", "CMD-04", "CMD-07", "CAD-02"],
  "document": "edits.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": true, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "move": [-20, 0] },
    { "run": "tool.break", "expect": { "tool": "break", "options": [] } },
    { "move": [-24, -4], "expect": { "hover": 7, "snap": null } },
    { "click": [-24, -4], "note": "Nesne ilk kırılma noktasından seçilir.", "expect": { "options": ["Enter"], "hover": null } },
    { "move": [-18.25, -4.25], "note": "İkinci nokta çizginin ortasına kenetlenir.", "expect": { "snap": "midpoint" } },
    { "click": [-18.25, -4.25], "note": "Aradaki kısım gider: ilk parça çizginin kendisidir, ikincisi yeni nesne.", "expect": { "log": "success", "entities": 14, "objects": [{ "id": 7, "kind": "line", "points": [[-28, -4], [-24, -4]] }], "newest": { "kind": "line", "points": [[-18, -4], [-8, -4]] } } },
    { "move": [-13.25, -3.75], "expect": { "snap": "midpoint" } },
    { "click": [-13.25, -3.75] },
    { "key": "Enter", "note": "Aynı noktadan böl: yeni parçanın ortasından ikiye.", "expect": { "log": "success", "entities": 15, "tool": "break", "objects": [{ "id": 14, "kind": "line", "points": [[-18, -4], [-13, -4]] }], "newest": { "kind": "line", "points": [[-13, -4], [-8, -4]] } } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "key": "Ctrl+Z", "expect": { "entities": 14 } },
    { "key": "Ctrl+Z", "note": "Her kırma tek adımdır.", "expect": { "entities": 13, "objects": [{ "id": 7, "kind": "line", "points": [[-28, -4], [-8, -4]] }] } },
    { "run": "tool.vertex", "expect": { "tool": "vertex", "options": [] } },
    { "move": [-18, -18], "expect": { "hover": 12 } },
    { "click": [-18, -18], "note": "Kenara tıklamak köşe ekler: çizgi yerinde çoklu çizgi olur.", "expect": { "log": "success", "entities": 13, "objects": [{ "id": 12, "kind": "polyline", "points": [[-28, -18], [-18, -18], [-8, -18]] }] } },
    { "click": [-18, -18], "note": "Köşeye tıklamak onu siler.", "expect": { "log": "success", "objects": [{ "id": 12, "kind": "polyline", "points": [[-28, -18], [-8, -18]] }] } },
    { "move": [19, -14] },
    { "click": [19, -14], "note": "Kapalı alanın kenarına da köşe eklenir.", "expect": { "log": "success", "objects": [{ "id": 10, "kind": "polygon", "points": [[14, -14], [19, -14], [24, -14], [24, -6], [14, -6]] }] } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "key": "Ctrl+Z", "expect": { "objects": [{ "id": 10, "kind": "polygon", "points": [[14, -14], [24, -14], [24, -6], [14, -6]] }] } },
    { "key": "Ctrl+Z", "expect": { "objects": [{ "id": 12, "kind": "polyline", "points": [[-28, -18], [-18, -18], [-8, -18]] }] } },
    { "key": "Ctrl+Z", "expect": { "canUndo": false, "objects": [{ "id": 12, "kind": "line", "points": [[-28, -18], [-8, -18]] }] } },
    { "run": "tool.lengthen", "note": "Kip Dinamik; Fark, Yüzde ve Toplam değerleriyle istemde.", "expect": { "tool": "lengthen", "options": ["D", "F", "Y", "T"] } },
    { "move": [-19, -12], "expect": { "hover": 11 } },
    { "click": [-19, -12], "note": "Uca yakın tıklama o ucu seçer; uç fareyi izler.", "expect": { "options": [] } },
    { "move": [-15, -12] },
    { "text": "12", "expect": { "dynamicInput": "12" } },
    { "key": "Enter", "note": "Yazılan sayı yeni toplam uzunluktur.", "expect": { "log": "success", "objects": [{ "id": 11, "kind": "line", "points": [[-28, -12], [-16, -12]] }] } },
    { "key": "T", "note": "Toplam: önce değeri sorar.", "expect": { "options": [] } },
    { "text": "15" },
    { "key": "Enter", "expect": { "options": ["D", "F", "Y", "T"] } },
    { "move": [-27, -12] },
    { "click": [-27, -12], "note": "Toplam kipinde tıklanan uç hemen değişir: başlangıç, 15 m olacak kadar uzar.", "expect": { "log": "success", "objects": [{ "id": 11, "kind": "line", "points": [[-31, -12], [-16, -12]] }] } },
    { "key": "T" },
    { "text": "10" },
    { "key": "Enter" },
    { "key": "D", "note": "Toplam yine 10 m, kip yine Dinamik: araçların belleği başladığı gibi kalır.", "expect": { "options": ["D", "F", "Y", "T"] } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "key": "Ctrl+Z", "expect": { "objects": [{ "id": 11, "kind": "line", "points": [[-28, -12], [-16, -12]] }] } },
    { "key": "Ctrl+Z", "expect": { "canUndo": false, "objects": [{ "id": 11, "kind": "line", "points": [[-28, -12], [-18, -12]] }] } }
  ]
}
