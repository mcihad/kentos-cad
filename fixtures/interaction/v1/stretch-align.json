{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "stretch-align",
  "title": "Esnet ve Hizala: tıklanan ya da sürüklenen pencere içindeki köşeler yazılan farkla kayar, dışındakiler kalır; kilitli çizgi atlanır ve pencere yeniden istenir; seçim varken yalnız seçili nesne esner. Hizala birinci kaynağı birinci hedefe taşır, ikinci çiftle döndürür, Ölçekle (Ö) ile boyu da eşitler; yalnız taşımak için sağ tık; çakışan ikinci hedef uyarıyla yeniden istenir",
  "source": "Web'in StretchTool ('tool.stretch', cad.entities.edit) ve AlignTool ('tool.align', cad.entities.transform), ADR 0047",
  "covers": ["UX-01", "UX-07", "CMD-04", "CMD-07"],
  "document": "objects.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": true, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.stretch", "expect": { "tool": "stretch", "options": [] } },
    { "click": [20, 12], "note": "Pencerenin ilk köşesi; pencerenin köşeleri kenetlenmez." },
    { "click": [28, 18], "note": "Pencere 2. çizginin (24, 16) ucuna değer: yalnız o çizgi esner.", "expect": { "tool": "stretch", "entities": 7 } },
    { "move": [24, 16], "expect": { "snap": "endpoint" } },
    { "click": [24, 16], "note": "Temel nokta ucun kendisi." },
    { "text": "@4,-2" },
    { "key": "Enter", "note": "Pencere içindeki uç (4, −2) kayar, öbür uç yerinde kalır; araç biter.", "expect": { "tool": "select", "entities": 7, "log": "success", "canUndo": true, "objects": [{ "id": 2, "kind": "line", "points": [[0, 4], [28, 14]] }] } },
    { "key": "Ctrl+Z", "note": "Tek adımda geri alınır.", "expect": { "objects": [{ "id": 2, "kind": "line", "points": [[0, 4], [24, 16]] }] } },
    { "run": "tool.stretch" },
    { "drag": [[2, -18], [8, -14]], "note": "Sürüklenen pencere yalnız kilitli 6. çizginin ucuna değer: atlanır, pencere yeniden istenir.", "expect": { "tool": "stretch", "log": "warn", "entities": 7 } },
    { "drag": [[-14, 2], [-10, 16]], "note": "Kapalı alanın doğu kenarının iki köşesi pencerede.", "expect": { "tool": "stretch" } },
    { "move": [-12, 4], "expect": { "snap": "endpoint" } },
    { "click": [-12, 4] },
    { "text": "@3,0" },
    { "key": "Enter", "note": "Doğu kenarı 3 m kayar, batı kenarı kalır.", "expect": { "tool": "select", "log": "success", "objects": [{ "id": 4, "kind": "polygon", "points": [[-24, 4], [-9, 4], [-9, 14], [-24, 14]] }] } },
    { "key": "Ctrl+Z", "expect": { "objects": [{ "id": 4, "kind": "polygon", "points": [[-24, 4], [-12, 4], [-12, 14], [-24, 14]] }] } },
    { "click": [12, 10], "note": "2. çizgi seçilir.", "expect": { "tool": "select", "selected": [2] } },
    { "run": "tool.stretch" },
    { "click": [-2, 2] },
    { "click": [2, 18], "note": "Pencere 2. ve 3. çizginin uçlarına değer; seçim varken yalnız seçili nesne esner." },
    { "move": [0, 4], "expect": { "snap": "endpoint" } },
    { "click": [0, 4] },
    { "text": "@0,-2" },
    { "key": "Enter", "expect": { "tool": "select", "log": "success", "objects": [{ "id": 2, "kind": "line", "points": [[0, 2], [24, 16]] }, { "id": 3, "kind": "line", "points": [[0, 16], [16, 4]] }] } },
    { "key": "Ctrl+Z", "expect": { "objects": [{ "id": 2, "kind": "line", "points": [[0, 4], [24, 16]] }] } },
    { "click": [-16, -12], "note": "1. çizgi seçilir.", "expect": { "selected": [1] } },
    { "run": "tool.align", "expect": { "tool": "align", "options": [] } },
    { "move": [-24, -12], "expect": { "snap": "endpoint" } },
    { "click": [-24, -12], "note": "Birinci kaynak: çizginin batı ucu." },
    { "text": "486976,4419996" },
    { "key": "Enter", "note": "Birinci hedef yazılır: (−24, −4).", "expect": { "tool": "align", "options": ["Ö"] } },
    { "move": [-8, -12], "expect": { "snap": "endpoint" } },
    { "click": [-8, -12], "note": "İkinci kaynak: doğu ucu; kaynak doğrultusu doğu." },
    { "text": "486976,4420012" },
    { "key": "Enter", "note": "İkinci hedef (−24, 12): doğrultu kuzey; çizgi çeyrek tur döner, boyu 16 m kalır.", "expect": { "tool": "select", "entities": 7, "log": "success", "objects": [{ "id": 1, "kind": "line", "points": [[-24, -4], [-24, 12]] }] } },
    { "key": "Ctrl+Z", "note": "Tek adımda geri alınır.", "expect": { "objects": [{ "id": 1, "kind": "line", "points": [[-24, -12], [-8, -12]] }] } },
    { "run": "tool.align" },
    { "click": [-24, -12] },
    { "text": "486976,4419996" },
    { "key": "Enter" },
    { "key": "O", "note": "Ölçekle açılır (O, Ö'nün yerine).", "expect": { "options": ["Ö"] } },
    { "click": [-8, -12] },
    { "text": "486976,4420004" },
    { "key": "Enter", "note": "İkinci hedef 8 m ötede: çizgi döner ve yarı boyuna iner.", "expect": { "tool": "select", "log": "success", "objects": [{ "id": 1, "kind": "line", "points": [[-24, -4], [-24, 4]] }] } },
    { "key": "Ctrl+Z" },
    { "run": "tool.align" },
    { "click": [-24, -12] },
    { "text": "486976,4419996" },
    { "key": "Enter" },
    { "key": "O", "note": "Ölçekle yeniden kapanır: izin başladığı gibi.", "expect": { "options": ["Ö"] } },
    { "key": "Esc", "expect": { "tool": "select", "entities": 7, "objects": [{ "id": 1, "kind": "line", "points": [[-24, -12], [-8, -12]] }] } },
    { "click": [20, -8], "note": "Nokta seçilir.", "expect": { "selected": [5] } },
    { "run": "tool.align" },
    { "move": [20, -8], "expect": { "snap": "node" } },
    { "click": [20, -8] },
    { "click": [26, -6], "note": "Birinci hedef tıklanır." },
    { "rightClick": [26, -6], "note": "İkinci çift yok: sağ tık yalnız taşır.", "expect": { "tool": "select", "log": "success", "objects": [{ "id": 5, "kind": "point", "points": [[26, -6]] }] } },
    { "key": "Ctrl+Z", "expect": { "objects": [{ "id": 5, "kind": "point", "points": [[20, -8]] }] } },
    { "run": "tool.align" },
    { "click": [20, -8] },
    { "click": [26, -6] },
    { "click": [22, -8] },
    { "click": [26, -6], "note": "İkinci hedef birincinin üstünde: doğrultu yok; uyarılır, ikinci çift yeniden istenir.", "expect": { "tool": "align", "log": "warn", "options": ["Ö"], "entities": 7 } },
    { "key": "Esc", "expect": { "tool": "select", "objects": [{ "id": 5, "kind": "point", "points": [[20, -8]] }] } }
  ]
}
