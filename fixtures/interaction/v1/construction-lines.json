{
  "format": "kentos.interaction-trace",
  "version": 1,
  "id": "construction-lines",
  "title": "Yardımcı çizgi ve Işın: bir noktadan geçen çizgiler, Enter; Yatay (Y), yazılan Açı (A), Açıortay (B); başlangıçtan ışınlar, Ctrl+Z en yenisini geri alır",
  "source": "Web'in XlineTool'u ve RayTool'u (constructionTools.ts) ve cad.entities.create, ADR 0057",
  "covers": ["UX-01", "UX-06", "CMD-04"],
  "document": "empty.kcad",
  "view": { "center": [487000, 4420000], "metresPerPixel": 0.125 },
  "draft": { "snap": false, "grid": false, "ortho": false, "polar": false, "tracking": false },
  "prefs": { "cursorInput": true },
  "clickTolerance": 0.125,
  "steps": [
    { "run": "tool.xline", "expect": { "tool": "xline", "points": 0, "options": ["Y", "D", "A", "B"], "entities": 0 } },
    { "click": [0, 0], "note": "Çizgilerin geçeceği nokta.", "expect": { "points": 1, "options": ["Enter"], "entities": 0 } },
    { "move": [10, 10], "note": "Önizleme: görünümü baştan başa kesen kesikli çizgi ve açısı (45°)." },
    { "click": [10, 10], "note": "Her tık bir çizgi; nokta kalır.", "expect": { "entities": 1, "newest": { "kind": "xline", "points": [[0, 0], [0.7071, 0.7071]] }, "points": 1, "log": "success" } },
    { "click": [0, 10], "expect": { "entities": 2, "newest": { "kind": "xline", "points": [[0, 0], [0, 1]] }, "points": 1 } },
    { "key": "Enter", "note": "Bu noktadan geçenler biter; yön seçenekleri döner.", "expect": { "points": 0, "options": ["Y", "D", "A", "B"], "tool": "xline", "entities": 2 } },
    { "key": "Y", "note": "Yatay: her tıklanan noktadan bir yatay çizgi.", "expect": { "options": ["Enter"], "points": 0 } },
    { "click": [5, -5], "expect": { "entities": 3, "newest": { "kind": "xline", "points": [[5, -5], [6, -5]] }, "points": 0 } },
    { "key": "Enter", "note": "Tutulan nokta yok: Enter araçtan çıkar.", "expect": { "tool": "select", "entities": 3 } },
    { "run": "tool.xline", "expect": { "options": ["Y", "D", "A", "B"] } },
    { "key": "A", "note": "Açı yazılır.", "expect": { "options": [], "points": 0 } },
    { "text": "30" },
    { "key": "Enter", "expect": { "options": ["Enter"], "points": 0, "entities": 3 } },
    { "click": [0, -10], "note": "30° doğrultusunda, tıklanan noktadan.", "expect": { "entities": 4, "newest": { "kind": "xline", "points": [[0, -10], [0.866, -9.5]] } } },
    { "key": "Esc", "expect": { "tool": "select" } },
    { "run": "tool.xline" },
    { "key": "B", "note": "Açıortay: köşe, sonra iki kolda birer nokta.", "expect": { "options": [], "points": 0 } },
    { "click": [-20, 0], "expect": { "points": 1, "options": [] } },
    { "click": [-10, 0], "expect": { "points": 2, "options": ["Enter"] } },
    { "move": [-20, 10], "note": "Önizleme: kola kesikli çizgi ve açıortay." },
    { "click": [-20, 10], "expect": { "entities": 5, "newest": { "kind": "xline", "points": [[-20, 0], [-19.2929, 0.7071]] }, "points": 2 } },
    { "key": "Esc", "expect": { "tool": "select", "entities": 5 } },
    { "run": "tool.ray", "expect": { "tool": "ray", "points": 0, "options": [] } },
    { "click": [0, 0], "expect": { "points": 1, "options": ["Enter"] } },
    { "move": [10, 0], "note": "Önizleme: başlangıçtan imlece doğru kesikli ışın." },
    { "click": [10, 0], "expect": { "entities": 6, "newest": { "kind": "ray", "points": [[0, 0], [1, 0]] }, "points": 1, "log": "success" } },
    { "click": [0, -10], "expect": { "entities": 7, "newest": { "kind": "ray", "points": [[0, 0], [0, -1]] }, "points": 1 } },
    { "key": "Ctrl+Z", "note": "Araç sürerken Ctrl+Z en yeni ışını geri alır.", "expect": { "entities": 6, "newest": { "kind": "ray", "points": [[0, 0], [1, 0]] }, "points": 1, "canRedo": true, "tool": "ray" } },
    { "key": "Enter", "expect": { "points": 0, "tool": "ray" } },
    { "key": "Enter", "expect": { "tool": "select", "entities": 6 } },
    { "run": "tool.xline" },
    { "key": "A", "note": "Açı oturum boyunca kalır: iz onu başladığı gibi (0°) bırakır." },
    { "text": "0" },
    { "key": "Enter", "expect": { "options": ["Enter"] } },
    { "key": "Esc", "expect": { "tool": "select", "entities": 6 } }
  ]
}
