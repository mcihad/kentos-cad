def services_presets() -> str: ...
def services_preset_layer(id: str) -> tuple[str, str | None] | None: ...
def services_auth_missing(connection: str, secret: str | None = None) -> str | None: ...
def services_auth_apply(connection: str, secret: str, request: str, token: str | None = None) -> str: ...
def services_token_request(connection: str, secret: str, referer: str) -> str | None: ...
def services_read_token(connection: str, body: str, now_ms: float) -> str: ...
def services_taken_words(taken: int, matched: int | None, skipped: str, dropped: int, capped: bool, srid: int) -> str: ...
def services_layer_colors(layers: int) -> tuple[str, str]: ...
def services_same_system(settings: str, srid: int) -> bool: ...
def services_to_project(result: str, settings: str, srid: int) -> str: ...
def services_box_in(
    bbox: tuple[float, float, float, float], settings: str, srid: int
