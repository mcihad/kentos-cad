def services_new_objects(entities: str) -> str: ...
def services_infer_fields(rows: str) -> str: ...

class ServiceReading:
    def __init__(self, kind: str, url: str) -> None: ...
    def first(self) -> str | None: ...
    def answer(self, body: str) -> str | None: ...
    def offer(self) -> str | None: ...
    def layer(self, choice: str, project: int) -> str: ...

class FeedReading:
    def __init__(self, kind: str, url: str) -> None: ...
    def first(self) -> str | None: ...
    def answer(self, body: str) -> str | None: ...
    def offer(self) -> str | None: ...
    def geojson(self) -> bool: ...
    def systems(self, id: str, project: int) -> list[int]: ...
    def asked_srid(self, id: str, project: int, choice: int | None = None) -> int | None: ...
    def feed(self, choice: str, project: int) -> str: ...

class FeedTaking:
    def __init__(
        self, feed: str, most: int, geojson: bool, area: tuple[float, float, float, float] | None = None
    ) -> None: ...
    def first(self) -> str: ...
    def answer(self, body: str) -> str: ...
    @property
    def srid(self) -> int: ...
    @property
    def taken(self) -> int: ...
    @property
    def matched(self) -> int | None: ...
    def skipped(self) -> str: ...

# kentos.network (docs/adr/0209 §11).
class Network:
    @staticmethod
    def build(session: Session, id: str) -> Network: ...
    def summary(self) -> str: ...
    def locate(self, x: float, y: float, reach: float) -> str: ...
    def route(self, stops: str, barriers: str, reach: float, cost: int, reorder: str) -> str: ...
    def service_area(
        self,
        facilities: str,
        breaks: list[float],
        reach: float,
        cost: int,
        toward: bool,
        separate: bool,
        barriers: str,
        trim: float,
        rings: bool,
        areas: bool,
    ) -> str: ...
    def nearest(
        self,
        origins: str,
        targets: str,
        reach: float,
        cost: int,
        reverse: bool,
        barriers: str,
        paths: bool,
        k: int | None = None,
        cutoff: float | None = None,
    ) -> str: ...
    def trace(self, starts: str, barriers: str, reach: float, kind: str) -> str: ...
    def check(self) -> str: ...

# kentos.temporal (docs/adr/0210 §11). Moments are milliseconds since 1970, open ends ±inf.
_Crossed = tuple[float, float, str] | None
_Summary = tuple[tuple[int, int, int], tuple[float, float] | None]

def time_read(text: str) -> tuple[int, float]: ...
def time_write(t: float, date_only: bool) -> str: ...
def time_show(t: float, unit_name: str) -> str: ...
def time_floor(t: float, unit_name: str) -> float: ...
def time_auto_step(start: float, end: float) -> tuple[int, str]: ...
def time_positions(start: float, end: float, n: int, unit_name: str) -> tuple[float, int] | None: ...
def time_position(anchor: float, n: int, unit_name: str, k: int) -> float: ...
def time_of(ranged: bool, cumulative: bool, start: str | None = None, end: str | None = None) -> _Crossed: ...
def time_shows(s: float, e: float, mode: str, a: float, b: float | None = None) -> bool: ...
def time_values(
    ranged: bool, cumulative: bool, values: list[tuple[str | None, str | None]]
) -> tuple[list[_Crossed], _Summary]: ...
def temporal_layer(session: Session, layer: str) -> tuple[list[str], list[_Crossed], _Summary]: ...
def temporal_layers(session: Session) -> list[str]: ...
def temporal_shown(session: Session, a: float, b: float | None = None, layers: list[str] | None = None) -> list[str]: ...
