{
  "format": "kentos.ui.panel",
  "schemaVersion": 1,
  "title": "Parsel kartı",
  "body": [
    {
      "type": "text",
      "text": "Seçilen her parselin kartı: adası ve parseli başlığında, TAKS durumu yanında; altında Bilgiler'de seçilenler (alan, yapı sayısı, taban alanı, TAKS, kartın tarihi; tarih boşsa bugün). Parselleri çizimde seçip Seçimi al'a basın; karta tıklamak parseli gösterir."
    },
    {
      "type": "featurePicker",
      "id": "parseller",
      "label": "Parseller",
      "geometry": "area",
      "onChange": "parsel-karti"
    },
    {
      "type": "dateField",
      "id": "tarih",
      "label": "Kart tarihi",
      "onChange": "parsel-karti"
    },
    {
      "type": "multiSelect",
      "id": "bilgiler",
      "label": "Bilgiler",
      "options": [
        {
          "value": "alan",
          "label": "Alan"
        },
        {
          "value": "yapi",
          "label": "Yapı sayısı"
        },
        {
          "value": "taban",
          "label": "Taban alanı"
        },
        {
          "value": "taks",
          "label": "TAKS"
        },
        {
          "value": "tarih",
          "label": "Tarih"
        }
      ],
      "value": [
        "alan",
        "yapi",
        "taban",
        "taks",
        "tarih"
      ],
      "onChange": "parsel-karti"
    },
    {
      "type": "card",
      "id": "kartlar",
      "label": "Kartlar",
      "title": "parsel",
      "tag": "durum"
    }
  ]
}
