{
  "format": "kentos.ui.panel",
  "schemaVersion": 1,
  "title": "Değer say",
  "body": [
    {
      "type": "text",
      "text": "Bir alanın değerlerini sayar: seçilen nesnelerde, seçilmediyse katmanın bütün nesnelerinde. Alanlar katman seçilince gelir; alan seçilince ya da nesneler alınınca sayım kendiliğinden yenilenir. Her değer bir grup: yanında sayısı, altında nesneleri (tıklayınca gösterir). Sayım, bulunan değerleri Seç'e koyar: bir değer seçmek o değerdeki nesneleri çizimde seçer."
    },
    {
      "type": "layerPicker",
      "id": "katman",
      "label": "Katman"
    },
    {
      "type": "fieldPicker",
      "id": "alan",
      "label": "Alan",
      "layer": "katman",
      "onChange": "deger-say"
    },
    {
      "type": "featurePicker",
      "id": "nesneler",
      "label": "Nesneler",
      "layer": "katman",
      "onChange": "deger-say"
    },
    {
      "type": "button",
      "id": "say",
      "label": "Say",
      "command": "deger-say",
      "table": "dagilim",
      "primary": true
    },
    {
      "type": "text",
      "id": "en-sik",
      "text": "Sayınca en sık değer burada yazılır."
    },
    {
      "type": "select",
      "id": "vurgula",
      "label": "Seç",
      "options": [
        {
          "value": "-",
          "label": "Önce sayın"
        }
      ],
      "onChange": "deger-sec"
    },
    {
      "type": "tree",
      "id": "dagilim",
      "label": "Değerler",
      "group": [
        "Değer"
      ]
    },
    {
      "type": "chart",
      "id": "grafik",
      "label": "Dağılım",
      "of": "dagilim",
      "category": "Değer"
    }
  ]
}
