      "label": "Alan",
      "layer": "katman",
      "onChange": "deger-say"
    },
    {
      "type": "featurePicker",
      "id": "nesneler",
      "label": "Nesneler",
      "layer": "katman",
      "onChange": "deger-say"
    },
    {
      "type": "button",
      "id": "say",
      "label": "Say",
      "command": "deger-say",
      "table": "dagilim",
      "primary": true
    },
    {
      "type": "table",
      "id": "dagilim",
      "label": "Değerler"
    }
  ]
}
