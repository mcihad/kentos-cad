        "m",
        "km"
      ],
      "value": 25,
      "min": 1,
      "max": 1000,
      "required": true,
      "row": "arama",
      "step": 5
    },
    {
      "type": "button",
      "id": "bul",
      "label": "Bul",
      "command": "yakin-yapilar",
      "primary": true
    },
    {
      "type": "table",
      "id": "sonuc",
      "label": "Yakındaki yapılar"
    }
  ]
}
