{
  "format": "kentos.ui.panel",
  "schemaVersion": 1,
  "title": "Yapı ara",
  "body": [
    {
      "type": "text",
      "text": "Numarasında yazılan geçen yapıları alanlarıyla listeler. Ara, eklentinin komutunu panelin değerleriyle çalıştırır; satıra tıklamak yapıyı gösterir. Yapıları numarala sırayla numara yazar: sürerken panel ilerlemesini ve Durdur'u gösterir."
    },
    {
      "type": "textField",
      "id": "sorgu",
      "label": "Yapı no",
      "placeholder": "Y-0"
    },
    {
      "type": "layerPicker",
      "id": "katman",
      "label": "Katman",
      "geometry": "area"
    },
    {
      "type": "checkbox",
      "id": "numarasiz",
      "label": "Yalnız numarasız yapılar"
    },
    {
      "type": "button",
      "id": "ara",
      "label": "Ara",
      "command": "yapi-ara",
      "table": "sonuc",
      "primary": true
    },
    {
      "type": "button",
      "id": "numarala",
      "label": "Yapıları numarala",
      "command": "yapilari-numarala"
    },
    {
      "type": "table",
      "id": "sonuc",
      "label": "Bulunan yapılar"
    }
  ]
}
