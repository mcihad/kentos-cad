{
  "format": "kentos.catalog-operations",
  "version": 1,
  "levels": {
    "semantic": "Ürün komutu kullanıcının verdiğini alır, sonucu kendisi hesaplar: Python ve MCP aynı işi yeniden hesaplamadan yapar.",
    "geometry": "Ürün komutu var ama sonucun geometrisini çağıran hesaplar: arayüz hesaplayıp yazdırır.",
    "processing": "İşlemler aracı: yalnız uygulamanın çalıştırıcısından.",
    "none": "Belgeyi ya da projeyi değiştirir ama ürün komutu yok: arayüz doğrudan yazar.",
    "query": "Yalnız okur ya da ölçer.",
    "session": "Görünüm, seçim, çizim yardımcısı ya da aracın adımı: oturumun durumu.",
    "host": "Pencere, panel ya da yardım: uygulamanın sunumu."
  },
  "rules": [
    {
      "match": "view.*",
      "level": "session",
      "note": "Görünüm; cad.session.* yok (plan §5.1)."
    },
    {
      "match": "draft.*",
      "level": "session",
      "note": "Çizim yardımcıları oturumun durumu."
    },
    {
      "match": "edit.selectFilter*",
      "level": "session"
    },
    {
      "match": "basemap.*",
      "level": "semantic",
      "via": [
        "cad.layers.service"
      ]
    },
    {
      "match": "processing.toolbox",
      "level": "host"
    },
    {
      "match": "processing.history",
      "level": "host"
    },
    {
      "match": "processing.*",
      "level": "processing",
      "note": "İşlemler aracı; Python ve MCP'den çalıştırılamaz."
    },
    {
      "match": "sheet.zoom*",
      "level": "session",
      "note": "Paftanın görünümü."
    },
    {
      "match": "sheet.tool.*",
      "level": "session",
      "note": "Pafta tasarımcısının aracı."
    },
    {
      "match": "sheet.alignTo.*",
      "level": "session",
      "note": "Hizalamanın başvurusu; işlem cad.sheets.edit'in align'ı."
    },
    {
      "match": "sheet.escape",
      "level": "session"
    },
    {
      "match": "sheet.selectAll",
      "level": "session"
    },
    {
      "match": "sheet.model",
      "level": "session"
    },
    {
      "match": "sheet.open",
      "level": "session"
    },
    {
      "match": "sheet.undo",
      "level": "session",
      "note": "Kâğıdın kendi geçmişi (ADR 0251 §3); betikte cad.sheets.edit'in inverse'ü."
    },
    {
      "match": "sheet.redo",
      "level": "session",
      "note": "Kâğıdın kendi geçmişi (ADR 0251 §3)."
    },
    {
      "match": "sheet.preflight",
      "level": "query"
    },
    {
      "match": "sheet.export.pdf",
      "level": "host",
      "note": "Python Document.export_pdf, MCP drawing.exportPdf (ADR 0252 §3)."
    },
    {
      "match": "sheet.print",
      "level": "host"
    },
    {
      "match": "sheet.export.*",
      "level": "host",
      "note": "Dosyaya yazar; PDF'inki başsız sunucuda da var."
    },
    {
      "match": "sheet.importKpafta",
      "level": "host"
    },
    {
      "match": "sheet.saveTemplate",
      "level": "host",
      "note": "Cihazın ya da hesabın şablon kitaplığı."
    },
    {
      "match": "sheet.*",
      "level": "semantic",
      "via": [
        "cad.sheets.edit"
      ],
      "note": "Pafta çekirdeğinin işlemi cad.sheets.edit'le (ADR 0252 §2)."
    },
    {
      "match": "chart.*",
      "level": "query"
    },
    {
      "match": "help.*",
      "level": "host"
    },
    {
      "match": "workspace.*",
      "level": "semantic",
      "via": [
        "cad.settings.set"
      ],
      "note": "projectType; plan3d ve disaster henüz seçilemez."
    }
  ],
