{
  "format": "kentos.settings-schema",
  "version": 1,
  "groups": [
    {
      "id": "drafting",
      "title": "Çizim yardımcıları",
      "description": "Yeni noktanın nereye düşeceği ve yazılan değerin nerede açılacağı."
    },
    {
      "id": "snap",
      "title": "Kenetleme",
      "description": "İmlecin hangi noktalara yapışacağı."
    },
    {
      "id": "appearance",
      "title": "Görünüm",
      "description": "Tema, vurgu rengi, yazı tipi, arayüz düzeni ve yazı boyutu."
    },
    {
      "id": "newProjects",
      "title": "Yeni projeler",
      "description": "Yeni projelerde önerilen başlangıç değerleri; açık projeyi değiştirmez."
    },
    {
      "id": "graphics",
      "title": "Çizim motoru",
      "description": "Çizim alanını ekran kartında çizen arka uç, kenar yumuşatma ve çözünürlük."
    },
    {
      "id": "project",
      "title": "Proje",
      "description": "Projeyle kaydedilen ayarlar (.kcad, bulut revizyonu); tercihler onları değiştirmez."
    }
  ],
  "settings": [
    {
      "key": "drafting.ortho",
      "type": "boolean",
      "default": false,
      "scope": "session",
      "hosts": [
        "web",
        "desktop"
      ],
      "version": 1,
      "group": "drafting",
      "title": "Orto",
      "description": "Yeni nokta son noktanın tam yatayına ya da dikeyine düşer. Shift basılıyken tersine döner (F8).",
      "sensitive": false,
      "apply": "live"
    },
    {
      "key": "drafting.polar",
      "type": "boolean",
      "default": false,
      "scope": "session",
      "hosts": [
        "web",
        "desktop"
      ],
      "version": 1,
      "group": "drafting",
      "title": "Kutupsal izleme",
      "description": "Son noktadan açı adımlarında kılavuz çıkar; imleç yaklaşınca yapışır (F10). Orto açıksa önceliklidir.",
      "sensitive": false,
      "apply": "live"
    },
    {
      "key": "drafting.polarIncrement",
      "type": "number",
      "default": 45,
      "choices": [
        {
          "value": 15,
          "label": "15°"
        },
        {
          "value": 30,
          "label": "30°"
        },
        {
          "value": 45,
          "label": "45°"
        },
        {
          "value": 90,
          "label": "90°"
        }
