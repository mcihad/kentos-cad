    {
      "key": "drafting.snapAperture",
      "type": "integer",
      "default": 11,
      "min": 4.0,
      "max": 30.0,
      "unit": "px",
      "scope": "user",
      "hosts": [
        "web",
        "desktop"
      ],
      "version": 1,
      "group": "drafting",
      "title": "Kenet yarıçapı",
      "description": "İmlecin bir noktaya yapışması için gereken yakınlık; kapalı alanın ilk köşesine tıklayıp kapatmak da bu yakınlıktadır.",
      "sensitive": false,
      "apply": "live"
    },
    {
      "key": "drafting.pickAperture",
      "type": "integer",
      "default": 5,
      "min": 2.0,
      "max": 15.0,
      "unit": "px",
      "scope": "user",
      "hosts": [
        "web",
        "desktop"
      ],
      "version": 1,
      "group": "drafting",
      "title": "Seçim yarıçapı",
      "description": "Tıklamanın bir çizgiyi yakalaması için gereken yakınlık.",
      "sensitive": false,
      "apply": "live"
