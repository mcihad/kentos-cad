      "sensitive": false,
      "apply": "live"
    },
    {
      "key": "drafting.commandBar",
      "type": "boolean",
      "default": false,
      "scope": "user",
      "hosts": [
        "web",
        "desktop"
      ],
      "version": 1,
      "group": "drafting",
      "title": "Komut şeridi",
      "description": "Komut çalışırken çizim alanının üstünde de aracın adı, beklediği adım ve seçenekleri (kenar sayısı, yöntem, kopya…) düğme olarak gösterilir. Kapalıyken (varsayılan) bunların hepsi, nokta hesabı ve tek seferlik kenet alttaki komut satırındadır.",
      "sensitive": false,
      "apply": "live"
    },
    {
      "key": "drafting.hoverInfo",
      "type": "boolean",
      "default": true,
      "scope": "user",
      "hosts": [
        "web",
        "desktop"
      ],
      "version": 1,
