      "sensitive": false,
      "apply": "live"
    },
    {
      "key": "drafting.snap",
      "type": "boolean",
      "default": true,
      "scope": "session",
      "hosts": [
        "web",
        "desktop"
      ],
      "version": 1,
      "group": "drafting",
